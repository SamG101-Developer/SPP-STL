use std::annotations::versioned

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls Never {
  # The `Never` type represents a value that can never exist. It has no fields
  # or methods, and cannot be instantiated. It is used as a return type for
  # functions that never return, such as those that always panic or enter an
  # infinite loop. It serves as a marker for functions that do not return
  # normally, and can be used in type signatures to indicate that a function
  # will never return a value. It is different from `Void`, which represents the
  # absence of a value.
}
