use std::annotations::versioned
use std::format::Format
use std::format::Formatter
use std::io::StreamErr

!public
!versioned(base="1.0.0", new="1.0.0")
cls TupLike {
  # The `TupLike` is a non-generic marker trait, that allows any tyuple type to be used, without having to provide
  # generics that cause monomorphization. This is especially useful for generic constraints, as seen in the function
  # types.
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls Tup[..Items] { }

sup [..Items] Tup[Items] ext TupLike { }

sup [..Items: Copy] Tup[Items] ext Copy {
  # A tuple is copyable exactly when everything in it is: it owns nothing beyond its elements, so if each of those is
  # duplicated rather than moved then so is the tuple. This is what lets a variadic parameter pack of numbers be used
  # without the function having to discard it, the same way `Var` is copyable over copyable alternatives.
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls Pair[K, V] {
  !public key: K
  !public val: V
}

sup [..Items: Format] Tup[Items] ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format a tuple as `(a, b, c)`, or `(a,)` for one element like its literal, the placeholder's spec applying to each
    # element. `&..self` passes each element as a borrow, so none is moved out of `&self`.

    formatter.write_str("(")
    let count = format::format_tuple_elements(&mut formatter, 0_uz, &..self)?
    case count == 1_uz { formatter.write_str(",") }
    formatter.write_str(")")
    ret Pass[Void]()
  }
}

sup [K: Format, V: Format] Pair[K, V] ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format a pair as `Pair(key, val)`, the placeholder's spec applying to the key and the value.

    formatter.write_str("Pair(")
    self.key.fmt(&mut formatter)?
    formatter.write_str(", ")
    let val = self.val.fmt(&mut formatter)
    formatter.write_str(")")
    ret val
  }
}
