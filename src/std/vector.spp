use std::annotations::intrinsic
use std::annotations::versioned
use std::llvm::cold
use std::llvm::no_inline
use std::allocator::Alloc
use std::allocator::AllocErr
use std::allocator::AllocOverflowErr
use std::allocator::GlobalAlloc
use std::clone::Clone
use std::format::Format
use std::format::Formatter
use std::io::StreamErr
use std::iterator::FromIterator
use std::iterator::Iterator
use std::range::Range
use std::mem::raw_buf::RawBuf
use std::ops::add::Add
use std::ops::add::AddAssign
use std::ops::drop::Drop
use std::ops::eq::Eq
use std::ops::fwd::FwdMut
use std::ops::fwd::FwdRef
use std::ops::iter::IterMov
use std::ops::iter::IterMut
use std::ops::iter::IterRef
use std::ops::iter::RevIterMov
use std::ops::iter::RevIterMut
use std::ops::iter::RevIterRef

!public
!versioned(base="1.0.0", new="1.0.0")
cls Vec[T, A: Alloc=GlobalAlloc] {
  # The `Vec` type is a growable array that provides efficient storage and
  # access to a sequence of elements. It is the length-aware version of
  # `RawBuf`, which is the lowest level contiguous buffer type. The `Vec` type
  # manages the length of the buffer and provides methods for adding, removing,
  # and accessing elements. It also handles memory management through the use of
  # an allocator, allowing for flexible memory allocation strategies. It
  # forwards to the `View[T]` type, specifically `&View[T]` and `&mut View[T]`.
  # @type T: The type of elements stored in the vector.
  # @type A: The allocator type used for memory management. Defaults to
  #   `GlobalAlloc` if not specified.
  # @let buffer: The underlying raw buffer that holds the elements of the
  #   vector. It is of type `RawBuf[T, A]`, which is a low-level contiguous
  #   buffer that manages memory allocation and deallocation.
  # @let length: The current number of elements in the vector. It is of type
  #   `USize` and is used to track how many elements are currently stored in the
  #   vector. The length is always less than or equal to the capacity of the
  #   buffer.

  !package buffer: RawBuf[T, A]
  !package length: USize
}

sup [T] Vec[T] {
  # These are a collection of methods that are only usable with `A=GlobalAlloc`,
  # which is the most common case. They provide simple ways to create a vector,
  # either empty, with a specified capacity, filled with a specific element, or
  # generated from a function or generator. They all forward to the more general
  # methods that take an allocator as a parameter, using `GlobalAlloc` as the
  # default allocator. This design allows for flexibility while also providing
  # convenient defaults for common use cases.

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new() -> Self {
    # The `new` function creates a new, empty `Vec` with the default allocator
    # (`GlobalAlloc`). It initializes the underlying buffer to a dangling
    # pointer and sets the length to zero. This function is infallible and does
    # not perform any memory allocation until elements are added to the vector.
    # It is a convenient way to create an empty vector that can be populated
    # later.
    # @ret: A new, empty `Vec` instance with the default allocator.

    # Forward to the more general `new_in` function, specifying
    # `GlobalAlloc` as the allocator.
    ret Self::new_in(GlobalAlloc)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_with_capacity(cap: USize) -> Self {
    #
    # @let cap:
    # @ret:

    ret Self::new_with_capacity_in(cap, GlobalAlloc)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_from_fun[F: FunMut[(USize,), T]](len: USize, mut f: F) -> Self {
    #
    # @type F:
    # @let len:
    # @let f:
    # @ret:

    let mut vec = Self::new_with_capacity_in(len, GlobalAlloc)
    loop i in Range::between(0_uz, len) { vec.append_unchecked(f(i)) }

    vec.length = len
    ret vec
  }
}

sup [T, A: Alloc] Vec[T, A] {
  # These are the core methods of the `Vec` type that provide the main
  # functionality for managing the vector's capacity, length, and elements. They
  # include methods for creating a vector with a specific allocator, reserving
  # and shrinking capacity, accessing the length and emptiness of the vector,
  # modifying the length through truncation and resizing, and adding, inserting,
  # and removing elements.
  # @type Element: An alias for the element type `T` stored in the vector.
  # @type Allocator: An alias for the allocator type `A` used for memory
  #   management.

  type Element = T
  type Allocator = A

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_in(alloc: A) -> Self {
    #
    # @let alloc:
    # @ret:

    ret Vec(buffer=RawBuf[T, A]::new_with_capacity_in(0_uz, alloc), length=0_uz)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_with_capacity_in(cap: USize, alloc: A) -> Self {
    #
    # @let cap:
    # @let alloc:
    # @ret:

    ret Vec(buffer=RawBuf[T, A]::new_with_capacity_in(cap, alloc), length=0_uz)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun cap(&self) -> USize {
    #
    # @ret:

    ret self.buffer.cap()
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun capacity_reserve(&mut self, additional: USize) -> Void {
    #
    # @let additional:
    # @ret:

    self
      .try_capacity_reserve(additional)
      .expect("Failed to reserve capacity for Vec")
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_capacity_reserve(&mut self, additional: USize) -> Res[Void, AllocErr] {
    #
    # @let additional:
    # @ret:

    ret self.buffer
      .try_capacity_reserve(self.len(), additional)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun capacity_reserve_exact(&mut self, required_cap: USize) -> Void {
    #
    # @let required_cap:
    # @ret:

    self
      .try_capacity_reserve_exact(required_cap)
      .expect("Failed to reserve exact capacity for Vec")
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_capacity_reserve_exact(&mut self, required_cap: USize) -> Res[Void, AllocErr] {
    # @let required_cap:
    # @ret:

    ret self.buffer
      .try_capacity_reserve_exact(self.len(), required_cap)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun capacity_shrink_to(&mut self, min_capacity: USize) -> Void {
    #
    # @let min_capacity:
    # @ret:

    self
      .try_capacity_shrink_to(min_capacity)
      .expect("Failed to shrink capacity for Vec")
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_capacity_shrink_to(&mut self, min_capacity: USize) -> Res[Void, AllocErr] {
    # Shrinks the capacity towards `min_capacity`, but never below the length:
    # the buffer must keep holding every live element.
    # @let min_capacity: The capacity to shrink to, raised to the length if
    #   lower.
    # @ret: The allocator's error if the shrink fails.

    ret self.buffer
      .try_capacity_shrink_to(self.len().max(min_capacity))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun capacity_shrink(&mut self) -> Void {
    #
    # @ret:

    self
      .try_capacity_shrink()
      .expect("Failed to shrink capacity for Vec")
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_capacity_shrink(&mut self) -> Res[Void, AllocErr] {
    #
    # @ret:

    ret self.buffer
      .try_capacity_shrink_to(self.len())
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun truncate(&mut self, new_len: USize) -> Void {
    #
    # @let new_len:
    # @ret:

    case new_len >= self.len() { ret }
    self.buffer.clear_range(new_len, self.len() - new_len)
    self.length = new_len
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun append(&mut self, element: T) -> Void {
    #
    # @let element:
    # @ret:

    case self.len() < self.cap() {
      self.append_unchecked(element)
      ret
    }
    self.grow_one()
    self.append_unchecked(element)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun append_within_capacity(&mut self, element: T) -> Res[Void, AllocErr] {
    # Append `element` only if the vector has room for it without growing.
    # @let element: The element to append; dropped if there is no room.
    # @ret: `Pass` once appended, or `AllocOverflowErr` if the vector was full.

    case self.len() < self.cap() {
      self.append_unchecked(element)
      ret Pass[Void]()
    }
    ret Fail(err=AllocOverflowErr)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun append_many(&mut self, that: Vec[T, A]) -> Void {
    #
    # @let that:
    # @ret:

    let required_cap = self.len() + that.len()
    case required_cap <= self.cap() {
      self.append_many_unchecked(that)
      ret
    }

    # Reserve enough capacity to hold the new elements, then append them.
    self.capacity_reserve(that.len())
    self.append_many_unchecked(that)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun insert_at(&mut self, index: USize, element: T) -> Void {
    # Insert `element` at `index`, shifting the elements from `index` on one
    # place back. `index` may be the length (appending), but not past it.
    # @let index: Where the element goes; aborts if past the length.
    # @let element: The element to insert.
    # @ret:

    std::abort::abort_if(
      index > self.len(), "Vec::insert_at: index past the end of the vector")
    case self.len() < self.cap() {
      self.insert_at_unchecked(index, element)
      ret
    }

    # Reserve enough capacity to hold the new element, then insert it.
    self.grow_one()
    self.insert_at_unchecked(index, element)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun insert_many_at(&mut self, index: USize, that: Vec[T, A]) -> Void {
    # Insert every element of `that` at `index`, in order, shifting the elements
    # from `index` on back. `index` may be the length (appending), but not past
    # it.
    # @let index: Where the elements go; aborts if past the length.
    # @let that: The elements to insert, moved in.
    # @ret:

    std::abort::abort_if(
      index > self.len(), "Vec::insert_many_at: index past the end of the vector")
    let required_cap = self.len() + that.len()
    case required_cap <= self.cap() {
      self.insert_vec_at_unchecked(index, that)
      ret
    }

    # Reserve enough capacity to hold the new elements, then insert them.
    self.capacity_reserve(that.len())
    self.insert_vec_at_unchecked(index, that)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun take_last(&mut self) -> Opt[T] {
    #
    # @ret:

    case self.is_empty() { ret None }
    self.length -= 1_uz
    ret self.buffer.take_at(self.len())
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun take_last_if[F: FunMov[(&mut T,), Bool]](&mut self, mut f: F) -> Opt[T] {
    #
    # @type F:
    # @let f:
    # @ret:

    # Discharged on the early path rather than deferred: past the emptiness
    # check "f" is consumed by being called, so a deferred discard would consume
    # it a second time on every path that got that far.
    case self.is_empty() { ret None }
    let last_index = self.len() - 1_uz

    case f(self[mut last_index]).not { ret None }
    self.length -= 1_uz
    ret self.buffer.take_at(last_index)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun take_at(&mut self, index: USize) -> Opt[T] {
    #
    # @let index:
    # @ret:

    case index >= self.len() { ret None }
    let element = self.buffer.take_at(index)
    self.buffer.shift(index + 1_uz, index, self.len() - index - 1_uz)
    self.length -= 1_uz
    ret element
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun clear(&mut self) -> Void {
    # Removes every element from the vector, running each one's destructor, and
    # resets the length to zero. The capacity is left unchanged. Delegates to
    # `truncate(0)`, which drops the whole live range in place.
    # @ret: Nothing; the vector is left empty.

    self.truncate(0_uz)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun make_reverse(&mut self) -> Void {
    # Reverses the elements in place, swapping from both ends inwards. Fewer
    # than two elements is already reversed, and returns before `len() - 1`
    # could underflow on an empty vector.
    # @ret:

    case self.len() < 2_uz { ret }
    let (mut l, mut r) = (0_uz, self.len() - 1_uz)
    loop l < r {
      self.swap(l, r)
      l += 1_uz
      r -= 1_uz
    }
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun append_unchecked(&mut self, element: T) -> Void {
    #
    # @let element:
    # @ret:

    self.buffer.place_at(self.len(), element)
    self.length += 1_uz
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun append_many_unchecked(&mut self, that: Vec[T, A]) -> Void {
    #
    # @let that:
    # @ret:

    let elem_size = std::mem::ops::size_of[T]()
    std::mem::ops::mem_copy(
      &mut self.buffer.ptr(), &that.buffer.ptr(),
      that.len() * elem_size, self.len() * elem_size)
    self.length += that.len()
    that.free_moved_from()
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun insert_at_unchecked(&mut self, index: USize, element: T) -> Void {
    #
    # @let index:
    # @let element:
    # @ret:

    self.buffer.shift(index, index + 1_uz, self.len() - index)
    self.buffer.place_at(index, element)
    self.length += 1_uz
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun insert_vec_at_unchecked(
    &mut self, index: USize, that: Vec[T, A]) -> Void {
    #
    # @let index:
    # @let that:
    # @ret:

    self.buffer.shift(index, index + that.len(), self.len() - index)
    let elem_size = std::mem::ops::size_of[T]()
    std::mem::ops::mem_copy(
      &mut self.buffer.ptr(), &that.buffer.ptr(),
      that.len() * elem_size, index * elem_size)
    self.length += that.len()
    that.free_moved_from()
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun free_moved_from(self) -> Void {
    # Frees the buffer of a vector whose elements were moved out bytewise, as
    # `append_many_unchecked` and `insert_vec_at_unchecked` do, without running
    # their destructors: `drop(self)` would destroy the elements that now live
    # in the other vector.
    # @ret:

    let Vec(buffer, length) = self
  }

  !cold
  !private !no_inline
  !versioned(base="1.0.0", new="1.0.0")
  fun grow_one(&mut self) -> Void {
    # Make room for one more element (doubling the capacity, or one if there is
    # none). Out of line and cold, so `append` is only its capacity test and a
    # store, and inlines into the loop that calls it.
    # @ret:

    self.buffer
      .try_capacity_grow_amortised(self.len(), 1_uz)
      .expect("Failed to grow capacity for Vec")
  }
}

sup [T: Clone, A: Alloc] Vec[T, A] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_filled_in(len: USize, element: T, alloc: A) -> Self {
    # Create a vector of `len` copies of `element`, using the given allocator.
    # It needs `T: Clone`, as every slot but one holds a copy; it used to only
    # set the length, leaving the elements as whatever the allocation held.
    # @let len: The number of elements the vector holds.
    # @let element: The value every element is a copy of.
    # @let alloc: The allocator for the vector's buffer.
    # @ret: The filled vector.

    let mut vec = Self::new_with_capacity_in(len, alloc)
    vec.resize(len, element)
    ret vec
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun resize(&mut self, new_len: USize, element: T) -> Void {
    # Grows or shrinks the vector to `new_len`. Shrinking truncates and drops
    # the trailing elements. Growing reserves the additional capacity once and
    # clones `element` directly into the newly reserved slots, moving the
    # original into the last slot instead of cloning it, so no intermediate
    # `Vec` is built.
    # @let new_len: The length the vector should have after this call.
    # @let element: The value used to fill any newly added slots.
    # @ret:

    case new_len <= self.len() {
      self.truncate(new_len)
      ret
    }

    let additional = new_len - self.len()
    self.capacity_reserve(additional)
    loop i in Range::between(1_uz, additional) {
      self.append_unchecked(element.clone())
    }
    self.append_unchecked(element)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun append_from_view(&mut self, that: &View[T]) -> Void {
    # Append all the elements from a view, by cloning each element. A bytewise
    # copy would leave both the view and the vector owning any heap memory an
    # element holds, and free it twice.
    # @let that: The view to append from.

    self.capacity_reserve(that.len())
    loop element in that.iter_ref() {
      self.append_unchecked(element.clone())
    }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun from_in(that: &View[T], alloc: A) -> Self {
    # Create the vector from a view, by copying the elements from the view,
    # using the given allocator.
    # @let that: The view to create the vector from.
    # @let alloc: The allocator used for the new vector's storage.
    # @ret: A new vector containing the elements from the view.

    let mut vec = Self::new_with_capacity_in(that.len(), alloc)
    vec.append_from_view(that)
    ret vec
  }
}

sup [T: Clone] Vec[T] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_filled(len: USize, element: T) -> Self {
    # Create a vector of `len` copies of `element`, using the global allocator.
    # @let len: The number of elements the vector holds.
    # @let element: The value every element is a copy of.
    # @ret: The filled vector.

    ret Self::new_filled_in(len, element, GlobalAlloc)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: &View[T]) -> Self {
    # Create the vector from a view, by copying the elements from the view,
    # using the global allocator.
    # @let that: The view to create the vector from.
    # @ret: A new vector containing the elements from the view.

    # Forward to the more general `from_in` function, specifying `GlobalAlloc`
    # as the allocator.
    ret Self::from_in(that, GlobalAlloc)
  }
}

sup [T, A: Alloc] Vec[T, A] ext IterMov[T] {
  !versioned(base="1.0.0", new="1.0.0")
  cor iter_mov(mut self) -> Iterator[T] {
    # Yields the elements from front to back, moving each one out of the buffer.
    # Consuming from the front leaves the remaining live elements as the suffix
    # `[i, length)`, which a `Vec` cannot describe - its live region is always a
    # prefix - so the vector is destructured here and this coroutine answers for
    # the remainder itself.
    # @ret: An iterator that moves the vector's elements out in order.

    let Vec(buffer, length) = self
    let mut rest = IterMovRest(buffer=buffer, from=0_uz, end=length)
    loop rest.from < rest.end {
      let element = rest.buffer.take_at(rest.from).unwrap()
      rest.from += 1_uz
      gen element
    }
  }
}

cls IterMovRest[T, A: Alloc] {
  # The elements an `iter_mov` has not yielded yet: `[from, end)` of `buffer`.
  # Dropped with the generator, whether it finishes or is abandoned, it destroys
  # those, then frees the buffer.
  # @type T: The type of the elements.
  # @type A: The buffer's allocator.
  # @let buffer: The vector's buffer, its yielded elements already moved out.
  # @let from: The first element not yielded yet.
  # @let end: One past the last element.

  !package buffer: RawBuf[T, A]
  !package from: USize
  !package end: USize
}

sup [T, A: Alloc] IterMovRest[T, A] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Destroys the elements not yielded; the buffer then frees its memory.
    let IterMovRest(mut buffer, from, end) = self
    buffer.clear_range(from, end - from)
  }
}

sup [T, A: Alloc] Vec[T, A] ext RevIterMov[T] {
  !versioned(base="1.0.0", new="1.0.0")
  cor reverse_iter_mov(mut self) -> Iterator[T] {
    # Yields the elements from back to front, moving each one out of the buffer.
    # The length is decremented before each yield, so the still-live elements
    # are always exactly the prefix `[0, length)`. That keeps `Vec::del` correct
    # even if iteration is abandoned early: it drops precisely the elements that
    # were never yielded, with no double drop and no leak.
    # @ret: An iterator that moves the vector's elements out in reverse order.

    loop self.length > 0_uz {
      self.length -= 1_uz
      gen self.buffer.take_at(self.length).unwrap()
    }
  }
}

sup [T: Clone, A: Alloc and Clone] Vec[T, A] ext Clone {
  !versioned(base="1.0.0", new="1.0.0")
  fun clone(&self) -> Self {
    # Clones each element into a new vector with the same allocator. A bytewise
    # copy would share any heap memory the elements own (the inner buffers of a
    # `Vec[Vec[T]]`), which both vectors then free.
    # @ret: The independent copy.

    let mut vec = Self::new_with_capacity_in(self.len(), self.buffer.alloc.clone())
    loop element in self.iter_ref() {
      vec.append_unchecked(element.clone())
    }
    ret vec
  }
}

sup [T, A: Alloc] Vec[T, A] ext Add {
  !versioned(base="1.0.0", new="1.0.0")
  fun add(self, that: Self) -> Self {
    #
    # @let that:
    # @ret:

    let mut result = self
    result.append_many(that)
    ret result
  }
}

sup [T, A: Alloc] Vec[T, A] ext AddAssign {
  !versioned(base="1.0.0", new="1.0.0")
  fun add_assign(&mut self, that: Self) -> Void {
    #
    # @let that:
    # @ret:

    self.append_many(that)
  }
}

sup [T: Eq, A: Alloc] Vec[T, A] ext Eq {
  !versioned(base="1.0.0", new="1.0.0")
  fun eq(&self, that: &Self) -> Bool {
    # Short-circuit element equality test, breaking on the first mismatch.
    # @let that: Other vector to compare against.
    # @ret: If the vectors are equal, per element.

    case self.len() != that.len() { ret false }
    loop i in Range::between(0_uz, self.len()) {
      case self[i] != that[i] { ret false }
    }
    ret true
  }

  !versioned(base="1.0.0", new="1.0.0")
  fun ne(&self, that: &Self) -> Bool {
    # Short-circuit element unequality test, breaking on the first mismatch.
    # @let that: Other vector to compare against.
    # @ret: If the vectors are unequal, per element.

    case self.len() != that.len() { ret true }
    loop i in Range::between(0_uz, self.len()) {
      case self[i] != that[i] { ret true }
    }
    ret false
  }
}

sup [T] Vec[T] ext FromIterator[T] {
  # Like `from(&View[T])` above, this needs a `Self` with no allocator supplied
  # by the caller, so it can only build a `GlobalAlloc` vector.

  !versioned(base="1.0.0", new="1.0.0")
  fun from_iter[G: Gen[T]](iter: G) -> Self {
    # Build a new `Vec` from a generator. The generator is expected to yield
    # elements of type `T`, and the function will collect these elements into a
    # new `Vec`. The function will continue to call the generator until it
    # returns `None`, indicating that there are no more elements to yield. The
    # resulting `Vec` will contain all the elements produced by the generator,
    # in the order they were generated.
    # @type G: The type of the generator that produces elements of type `T`.
    #   This must be a generator type that yields elements of type `T`.
    # @let iter: The generator instance that will be used to produce elements
    #   for the new `Vec`.
    # @ret: A new `Vec` instance containing all the elements produced by the
    #   generator.

    # Create the vector and yield all the elements
    # from the generator into it.
    let mut vec = Self::new()
    loop element in iter { vec.append(element) }
    ret vec
  }
}

sup [T, A: Alloc] Vec[T, A] ext FwdMut[View[T]] {
  !intrinsic(name="std.vector.Vec.fwd_mut")
  !versioned(base="1.0.0", new="1.0.0")
  cor fwd_mut(&mut self) -> GenOnce[&mut View[T]] { }
}

sup [T, A: Alloc] Vec[T, A] ext FwdRef[View[T]] {
  !intrinsic(name="std.vector.Vec.fwd_ref")
  !versioned(base="1.0.0", new="1.0.0")
  cor fwd_ref(&self) -> GenOnce[&View[T]] { }
}

sup [T, A: Alloc] Vec[T, A] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Runs the destructors of the vector's live elements, then lets the
    # underlying buffer drop, which frees the backing memory. The live elements
    # are always the prefix `[0, length)`, which `clear_range` destroys in
    # place. The buffer's own destructor only frees memory and never touches the
    # elements, so there is no double drop.
    # @ret: Nothing; this is invoked for its cleanup side effect when a `Vec` is
    #   destroyed.

    let Vec(mut buffer, length) = self
    buffer.clear_range(0_uz, length)
  }
}

sup [T: Format, A: Alloc] Vec[T, A] ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format a vector as `[a, b, c]`, the placeholder's spec applying to each
    # element.

    ret format::format_elements(formatter, self)
  }
}
