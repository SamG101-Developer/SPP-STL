use std::annotations::intrinsic
use std::annotations::package
use std::annotations::public
use std::annotations::thread_hazard
use std::annotations::versioned
use std::copy::Copy
use std::generator::GenOnce
use std::void::Void

!public !thread_hazard
!versioned(base="1.0.0", new="1.0.0")
cls Slot[T] {
    !package val: T
}

sup [T] Slot[T] {
    !public
    !versioned(base="1.0.0", new="1.0.0")
    fun new(val: T) -> Slot[T] {
        ret Slot(val)
    }

    !public
    !versioned(base="1.0.0", new="1.0.0")
    fun set(&self, val: T) -> Void {
        let old = self.replace(val)
    }

    !public
    !intrinsic(name="std.slot.Slot.replace")
    !versioned(base="1.0.0", new="1.0.0")
    fun replace(&self, val: T) -> T {
        # Intrinsic for mutability reasons.
        # @let val: The new value to replace the current value in the slot.
        # @ret: The old value that was replaced in the slot.
    }

    !public
    !intrinsic(name="std.slot.Slot.get_mut")
    !versioned(base="1.0.0", new="1.0.0")
    cor get_mut(&self) -> GenOnce[&mut T] {
        # Intrinsic for mutability reasons.
        # @ret: A mutable borrow to the value in the slot, allowing for modification of the value.
    }

    !public
    !intrinsic(name="std.slot.Slot.get_ref")
    !versioned(base="1.0.0", new="1.0.0")
    cor get_ref(&self) -> GenOnce[&T] {
        # Intrinsic for symmetric reasons with `get_mut`.
        # @ret: A shared borrow to the value in the slot, allowing for read-only access to the value.
    }

    !public
    !versioned(base="1.0.0", new="1.0.0")
    fun take(self) -> T {
        #
        # @ret:

        ret self.val
    }
}

sup [T: Copy] Slot[T] {
    !public
    !versioned(base="1.0.0", new="1.0.0")
    fun get(&self) -> T {
        ret self.val
    }
}
