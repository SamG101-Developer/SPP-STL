use std::annotations::intrinsic
use std::annotations::versioned
use std::llvm::always_inline
use std::llvm::inline
use std::allocator::GlobalAlloc
use std::mem::pointer::NonNull

!public !always_inline
!intrinsic(name="std.mem.ops.size_of")
!versioned(base="1.0.0", new="1.0.0")
cmp fun size_of[T]() -> USize {
  # Returns the size of a type at compile time. This is a sum of the fields of
  # the type, including alignment padding, with special type handling internal
  # to the compiler (ie smart pointer type sizes, number sizes, etc). This is a
  # compiletime function, as type information is all known at compile time.
  # @type T: The type to get the size of.
  # @ret: The size of the type in bytes.
}

!public !inline
!intrinsic(name="std.mem.ops.size_of_val")
!versioned(base="1.0.0", new="1.0.0")
fun size_of_val[T](value: &T) -> USize {
  # Handles heap size checking for types that are not known at compiletime. This
  # is typically used for vectors or strings as they can be dynamically sized,
  # and their size is not known at compile time. This is a runtime function, as
  # the size of the value is not known until runtime.
  # @type T: The type of the value to get the size of.
  # @let value: A reference to the value to get the size of.
  # @ret: The size of the value in bytes.
}

!public !always_inline
!intrinsic(name="std.mem.ops.align_of")
!versioned(base="1.0.0", new="1.0.0")
cmp fun align_of[T]() -> USize {
  # Returns the alignment of a type at compile time. This is a compiletime
  # function, as type information is all known at compile time. The alignment of
  # a type is the maximum alignment of its fields. For example, a struct with a
  # U8 and a `U32` field will have an alignment of `4`, as the `U32` field has
  # an alignment of `4`.
  # @type T: The type to get the alignment of.
  # @ret: The alignment of the type in bytes.
}

!public !inline
!intrinsic(name="std.mem.ops.align_of_val")
!versioned(base="1.0.0", new="1.0.0")
fun align_of_val[T](value: &T) -> USize {
  # Returns the alignment of a value at runtime. This is just the runtime
  # equivalent of align_of, and is typically used for dynamically sized types.
  # @type T: The type of the value to get the alignment of.
  # @let value: A reference to the value to get the alignment of.
  # @ret: The alignment of the value in bytes.
}

!package !always_inline
!intrinsic(name="std.mem.ops.mem_set")
!versioned(base="1.0.0", new="1.0.0")
fun mem_set[T](dest: &mut NonNull[T], value: U8, n: USize, dest_index: USize = 0_uz) -> Void {
  # Writes a byte value into a block of memory. This is typically used for
  # zeroing out memory, or setting it to a specific value. Whilst this might be
  # considered "unsafe", it is never exposed to the user, as it is hidden under
  # allocators and the memory api. It is generic over the pointee type because
  # it operates purely on bytes, so it can zero or fill an allocation viewed
  # through either a byte pointer or a typed pointer.
  # @type T: The pointee type of the destination pointer. The operation is
  #   byte-level and does not depend on it.
  # @let dest: A mutable reference to the value to write to.
  # @let value: The byte value to write to the memory.
  # @let n: The number of bytes to write to the memory.
  # @let ?dest_index: An optional index to start writing at, in bytes. This is
  #   typically used for writing to an offset within a value, such as an array.
  # LLVM's own `memset`, so the optimiser sees the write (a small one becomes a store).
}

!package !always_inline
!versioned(base="1.0.0", new="1.0.0")
fun mem_cmp[T](a: &NonNull[T], b: &NonNull[T], n: USize) -> S32 {
  # Compares two blocks of memory. This is typically used for comparing values,
  # or for comparing the contents of two references. Whilst this might be
  # considered "unsafe", it is never exposed to the user, as it is hidden under
  # allocators and the memory api.
  # @type T: The pointee type of the two pointers. The operation is byte-level
  #   and does not depend on it.
  # @let a: A reference to the first value to compare.
  # @let b: A reference to the second value to compare.
  # @let n: The number of bytes to compare.
  # @ret: An integer indicating the result of the comparison. A negative value
  #   indicates that `a` is less than `b`, a positive value indicates that `a`
  #   is greater than `b`, and zero indicates that they are equal.

  let mut out = 0_s32
  let a_bytes = a@.erase_type()
  let b_bytes = b@.erase_type()
  let err = sppc::memcmp(a_bytes.as_c_ref(), b_bytes.as_c_ref(), n, &mut out) # Todo: Error handling.
  ret out
}

!package !always_inline
!intrinsic(name="std.mem.ops.mem_copy")
!versioned(base="1.0.0", new="1.0.0")
fun mem_copy[T](dest: &mut NonNull[T], src: &NonNull[T], n: USize, dest_index: USize = 0_uz, src_index: USize = 0_uz) -> Void {
  # Copies a block of memory from one location to another. This is typically
  # used for copying values, or for moving values out of a reference. Whilst
  # this might be considered "unsafe", it is never exposed to the user, as it is
  # hidden under allocators and the memory api.
  # @type T: The pointee type of the two pointers. The operation is byte-level
  #   and does not depend on it.
  # @let dest: A mutable reference to the value to copy to.
  # @let src: A reference to the value to copy from.
  # @let n: The number of bytes to copy.
  # @let ?dest_index: An optional index to start writing at, in bytes.
  # @let ?src_index: An optional index to start reading from, in bytes.
  # The two regions must not overlap. LLVM's own `memcpy`, so the optimiser sees the copy (a small one becomes a load and
  # a store).
}

!public
!intrinsic(name="std.mem.ops.swap")
!versioned(base="1.0.0", new="1.0.0")
fun swap[T](a: &mut T, b: &mut T) -> Void {
  # Swaps the values of two mutable references. Both values are read before
  # either is written, so nothing stands in for either mid-way and nothing is
  # dropped: through borrows, values are exchanged, never written over.
  # @type T: The type of the values to swap.
  # @let a: A mutable reference to the first value to swap.
  # @let b: A mutable reference to the second value to swap.
}

!public
!intrinsic(name="std.mem.ops.replace")
!versioned(base="1.0.0", new="1.0.0")
fun replace[T](dest: &mut T, src: T) -> T {
  # Replaces the value of a mutable reference with a new value, returning the
  # old value. This is safe because the desintation mutable borrow will always
  # get a new underlying value, and the old value can be used afterwards as an
  # owned object.
  # @type T: The type of the value to replace.
  # @let dest: A mutable reference to the value to replace.
  # @let src: The new value to replace the old value with.
  # @ret: The old value that was replaced.
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun take[T](src: &mut T) -> T {
  # The same as replace, but automatically uses the default value for a type
  # instead of a different pre-existing value. Safety is inherited from the
  # "replace" function.
  # @type T: The type of the value to take.
  # @let src: A mutable reference to the value to take.
  # @ret: The old value that was taken.

  ret replace(src, T())
}

!public
!intrinsic(name="std.mem.ops.drop")
!versioned(base="1.0.0", new="1.0.0")
fun drop[T](val: T) -> Void {
  # Safely disposes of a value, running its destructor. This is safe as it takes
  # ownership, so an uninitialized value cannot be left behind in the caller's
  # context (at runtime). It destroys structurally - a type's own `drop` first,
  # then its attributes. This does not bypass the type's own `drop`; it calls
  # it. Code generation looks for a `Drop` implementation first and only
  # destroys attribute-by-attribute when there is none, so
  # `std::mem::ops::drop(x)` and `std::mem::ops::drop(x)` do the same thing for
  # a type that has a destructor. There is no `T: Drop` overload vs a
  # non-constrained overload, because we want this to work for amy type coming
  # in, including an underconstrained generic `T`.
  # @type T: The type of the value to drop.
  # @let val: The value to drop.
  # @ret: An empty value, as the function is only used for its side effect of
  #   dropping the value.
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun drop[T](val: &T) -> Void {
  # Discards a borrow. A borrow owns nothing, so there is nothing to destroy -
  # this exists so that generic code over a `T` that is sometimes a borrow (an
  # adaptor over `iter_ref`, say) can discard an item it skips the same way
  # either way. A generic parameter cannot stand for a borrow, so the owned
  # overload never matches one.
  # @type T: The type behind the borrow.
  # @let val: The borrow to discard.
  # @ret: An empty value.
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun drop() -> Void {
  # Drops nothing: the end of a variadic drop, so `drop(..xs)` of an empty pack
  # is a call. A pack is not a value, so there is no `drop(xs)`; spreading it
  # here drops each of its elements, in order.
  # @ret: An empty value.
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun drop[H, ..Ts](head: H, ..tail: Ts) -> Void {
  # Drops each value given, in order: `drop(a, b)`, or `drop(..xs)` to consume a
  # pack, which is not a value and so cannot be given to `drop[T]` whole. A
  # single value goes to `drop[T]` instead, as a call of fixed arity is
  # preferred.
  # @type H: The type of the first value.
  # @type Ts: The types of the rest.
  # @let head: The first value to drop.
  # @let tail: The rest, dropped after it.
  # @ret: An empty value.
  drop(head)
  drop(..tail)
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun drop[H, ..Ts](head: &H, ..tail: &Ts) -> Void {
  # Discards each borrow given, the borrowed counterpart of the owned variadic
  # `drop`, so `drop(..xs)` works the same over a borrowed pack. A pack is all
  # owned or all borrowed, never mixed, so each overload covers its own case.
  # @type H: The type behind the first borrow.
  # @type Ts: The types behind the rest.
  # @let head: The first borrow to discard.
  # @let tail: The rest, discarded after it.
  # @ret: An empty value.
  drop(head)
  drop(..tail)
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun copy[T: Copy](src: &T) -> T {
  # Convenience function for copying a value out of a reference. This is only
  # available for types that extend the `Copy` type, which indicates that they
  # can be safely copied by value. This is defined as a function, to allow for
  # binding.
  # @type T: The type of the value to copy. This must extend the `Copy` type.
  # @let src: A reference to the value to copy.
  # @ret: The copied value.

  ret src@
}
