use std::annotations::intrinsic
use std::annotations::package
use std::annotations::public
use std::annotations::versioned
use std::allocator::Alloc
use std::allocator::GlobalAlloc
use std::allocator::Layout
use std::boolean::Bool
use std::cast::From
use std::clone::Clone
use std::copy::Copy
use std::function::FunMov
use std::generator::GenOnce
use std::iterator::Indexed
use std::iterator::Iterator
use std::number::USize
use std::range::Range
use std::single::Single
use std::view::View
use std::void::Void
use std::mem::ops::drop
use std::ops::eq::Eq
use std::ops::fwd::FwdMut
use std::ops::fwd::FwdRef
use std::ops::idx::IndexMut
use std::ops::idx::IndexRef
use std::ops::iter::IterMov
use std::ops::iter::IterMut
use std::ops::iter::IterRef
use std::ops::iter::RevIterMov
use std::ops::iter::RevIterMut
use std::ops::iter::RevIterRef

!public
!versioned(base="1.0.0", new="1.0.0")
cls Arr[T, cmp n: USize] {
  # A fixed size, inline array of element type T. The length is a compiletime constant, so storage lives on the stack
  # with no heap allocations, and therefore no allocation generic type parameter. The layout is statically known. All
  # methods for the array type are intrinsic as the Arr[T, n] type lowers to the llvm array type, where all methods are
  # defined in llvm directly.
  # @type T: The type of elements stored in the array. This is a generic type parameter that can be any type, there are
  # no constraints.
  # @cmp n: The length of the array. This is a compile-time constant that determines how many elements the array can
  # hold. The length is fixed and cannot be changed after the array is created.
}

sup [T, cmp n: USize] Arr[T, n] {
  !public
  !intrinsic(name="std.array.Arr.new")
  !versioned(base="1.0.0", new="1.0.0")
  fun new() -> Self { }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun swap(&mut self, i: USize, j: USize) -> Void {
    # Handing "mem::ops::swap" two mutable borrows into one array is not safe, and the memory checker cannot say so:
    # it compares the spelling of "self[mut i]" against "self[mut j]" and sees two different places, when "i == j"
    # makes them one. So the swap happens here with a single element borrow live at a time, and the aliasing case is
    # named rather than left to come out right by accident.
    # @let i: The index of the first element to swap.
    # @let j: The index of the second element to swap.

    case i == j { ret }
    let a = std::mem::ops::take(self[mut i])
    let b = std::mem::ops::take(self[mut j])
    self[mut i]@ = b
    self[mut j]@ = a
  }
}

sup [T: Copy, cmp n: USize] Arr[T, n] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun fill(&mut self, val: T) -> Void {
    loop i in Range[USize]::between(0_uz, n) { self[mut i]@ = val }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_filled(val: T) -> Self {
    let mut arr = Self::new()
    arr.fill(val)
    ret arr
  }
}

sup [T: Copy, cmp n: USize] Arr[T, n] ext Copy { }

sup [T, cmp n: USize] Arr[T, n] ext IterMov[T] {
  !intrinsic(name="std.array.Arr.iter_mov")
  !versioned(base="1.0.0", new="1.0.0")
  cor iter_mov(self) -> Iterator[T] { }
}

sup [T, cmp n: USize] Arr[T, n] ext RevIterMov[T] {
  !intrinsic(name="std.array.Arr.reverse_iter_mov")
  !versioned(base="1.0.0", new="1.0.0")
  cor reverse_iter_mov(self) -> Iterator[T] { }
}

sup [T, cmp n: USize] Arr[T, n] ext Eq {
  !versioned(base="1.0.0", new="1.0.0")
  fun eq(&self, that: &Self) -> Bool {
    # Use the `sppc::memcpy` function to compare the memory of the two arrays. This is a fast and efficient way to check
    # for equality, as it compares the raw bytes of the arrays directly.
    # @let that: The other array to compare against. This is a reference to another instance of the same array type.
    # @ret: A boolean value indicating whether the two arrays are equal.

    ret std::mem::ops::mem_cmp(&self.ptr, &that.ptr, n * std::mem::ops::size_of[T]()) == 0
  }

  !versioned(base="1.0.0", new="1.0.0")
  fun ne(&self, that: &Self) -> Bool {
    # @let that: The other array to compare against. This is a reference to another instance of the same array type.
    # @ret: A boolean value indicating whether the two arrays are not equal.

    ret std::mem::ops::mem_cmp(&self.ptr, &that.ptr, n * std::mem::ops::size_of[T]()) != 0
  }
}

sup [T, cmp n: USize] Arr[T, n] ext FwdMut[View[T]] {
  !intrinsic(name="std.array.Arr.fwd_mut")
  !versioned(base="1.0.0", new="1.0.0")
  cor fwd_mut(&mut self) -> GenOnce[&mut View[T]] { }
}

sup [T, cmp n: USize] Arr[T, n] ext FwdRef[View[T]] {
  !intrinsic(name="std.array.Arr.fwd_ref")
  !versioned(base="1.0.0", new="1.0.0")
  cor fwd_ref(&self) -> GenOnce[&View[T]] { }
}

type HeapArr[T, cmp n: USize, A: Alloc] = Single[Arr[T, n], A]
