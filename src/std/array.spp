use std::annotations::intrinsic
use std::annotations::versioned
use std::allocator::Alloc
use std::allocator::GlobalAlloc
use std::allocator::Layout
use std::clone::Clone
use std::format::Format
use std::format::Formatter
use std::io::StreamErr
use std::iterator::Iterator
use std::range::Range
use std::num::bases::Zero
use std::ops::add::Add
use std::ops::eq::Eq
use std::ops::fwd::FwdMut
use std::ops::fwd::FwdRef
use std::ops::iter::IterMov
use std::ops::iter::IterMut
use std::ops::iter::IterRef
use std::ops::iter::RevIterMov
use std::ops::iter::RevIterMut
use std::ops::iter::RevIterRef

!public
!versioned(base="1.0.0", new="1.0.0")
cls Arr[T, cmp n: USize] {
  # A fixed size, inline array of element type T. The length is a compiletime
  # constant, so storage lives on the stack with no heap allocations, and
  # therefore no allocation generic type parameter. The layout is statically
  # known. All methods for the array type are intrinsic as the Arr[T, n] type
  # lowers to the llvm array type, where all methods are defined in llvm
  # directly.
  # @type T: The type of elements stored in the array. This is a generic type
  #   parameter that can be any type, there are no constraints.
  # @cmp n: The length of the array. This is a compile-time constant that
  #   determines how many elements the array can hold. The length is fixed and
  #   cannot be changed after the array is created.
}

sup [T: Zero, cmp n: USize] Arr[T, n] ext Zero {
  fun zero() -> Self {
    let arr = Self()
    loop i in Range[USize]::between(0_uz, n) { arr[mut i]@ = T::zero() }
    ret arr
  }

  fun is_zero(&self) -> Bool {
    ret self.iter_ref().all(|elem: &T| elem.is_zero())
  }
}

sup [T: Copy, cmp n: USize] Arr[T, n] {
  !private
  !intrinsic(name="std.array.Arr.new")
  !versioned(base="1.0.0", new="1.0.0")
  fun new() -> Self {
    # An array whose elements are not initialised (LLVM `undef`, which an
    # optimised build may read as a different value at each use), for
    # `new_filled` to write every slot of before anything reads one. Private for
    # that reason, and bound to `Copy` so that nothing in it is dropped. Public
    # code uses `new_filled`, a literal, or `Arr[T, n]()` (zeroed).
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun fill(&mut self, val: T) -> Void {
    loop i in Range[USize]::between(0_uz, n) { self[mut i]@ = val }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new_filled(val: T) -> Self {
    let mut arr = Self::new()
    arr.fill(val)
    ret arr
  }
}

sup [T: Copy, cmp n: USize] Arr[T, n] ext Copy { }

sup [T, cmp n: USize] Arr[T, n] ext IterMov[T] {
  !intrinsic(name="std.array.Arr.iter_mov")
  !versioned(base="1.0.0", new="1.0.0")
  cor iter_mov(self) -> Iterator[T] { }
}

sup [T, cmp n: USize] Arr[T, n] ext RevIterMov[T] {
  !intrinsic(name="std.array.Arr.reverse_iter_mov")
  !versioned(base="1.0.0", new="1.0.0")
  cor reverse_iter_mov(self) -> Iterator[T] { }
}

sup [T: Eq, cmp n: USize] Arr[T, n] ext Eq {
  !versioned(base="1.0.0", new="1.0.0")
  fun eq(&self, that: &Self) -> Bool {
    # Compare the arrays element by element with each element's own `Eq`. A raw
    # memory comparison would only be right for plain data: an element that owns
    # storage elsewhere (a `Vec`, a `Str`) holds a pointer, so two equal
    # elements would compare unequal whenever their storage lives at different
    # addresses.
    # @let that: The other array to compare against. This is a reference to
    #   another instance of the same array type.
    # @ret: A boolean value indicating whether the two arrays are equal.

    loop i in Range[USize]::between(0_uz, n) {
      case self[i] != that[i] { ret false }
    }
    ret true
  }

  !versioned(base="1.0.0", new="1.0.0")
  fun ne(&self, that: &Self) -> Bool {
    # @let that: The other array to compare against. This is a reference to
    #   another instance of the same array type.
    # @ret: A boolean value indicating whether the two arrays are not equal.

    loop i in Range[USize]::between(0_uz, n) {
      case self[i] != that[i] { ret true }
    }
    ret false
  }
}

sup [T, cmp n: USize] Arr[T, n] ext FwdMut[View[T]] {
  !intrinsic(name="std.array.Arr.fwd_mut")
  !versioned(base="1.0.0", new="1.0.0")
  cor fwd_mut(&mut self) -> GenOnce[&mut View[T]] { }
}

sup [T, cmp n: USize] Arr[T, n] ext FwdRef[View[T]] {
  !intrinsic(name="std.array.Arr.fwd_ref")
  !versioned(base="1.0.0", new="1.0.0")
  cor fwd_ref(&self) -> GenOnce[&View[T]] { }
}

type HeapArr[T, cmp n: USize, A: Alloc] = Single[Arr[T, n], A]

sup [T: Format, cmp n: USize] Arr[T, n] ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format an array as `[a, b, c]`, the placeholder's spec applying to each
    # element.

    ret format::format_elements[T](formatter, self)
  }
}

