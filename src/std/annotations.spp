use std::number::S32
use std::string_view::StrView
use std::void::Void

!public
cls Annotation { }

sup Annotation {
  !public cmp function: S32 = 1
  !public cmp method: S32 = 2
  !public cmp ext_method: S32 = 4
  !public cmp class: S32 = 8
  !public cmp new_type: S32 = 16
  !public cmp constant: S32 = 32

  !public cmp all: S32 = Self::function | Self::method | Self::ext_method | Self::class | Self::new_type | Self::constant
  !public cmp mod: S32 = Self::function | Self::method | Self::class | Self::new_type | Self::constant
}

!public
!annotation(target=Annotation::function)
!versioned(base="1.0.0", new="1.0.0")
cmp fun annotation(target: S32) -> Void {
  # The master annotation that is used to define other annotations. This annotation is used to indicate that the
  # annotated item is an annotation, and it specifies the target of the annotation - a function, because all annotations
  # are defined as a function.
  # @let target: The valid AST types that the annotation can be applied to. This is a bitmask of the `Annotation` enum
  # values, which can be combined using the bitwise OR operator. For example, using the target of `Annotation::function
  # | Annotation::method` indicates that the annotation can be applied to both functions and sup-methods, but not
  # overriding methods; this would require the addiotnation `| Annotation::ext_method`.
}

!public
!annotation(target=Annotation::function | Annotation::method | Annotation::ext_method)
!versioned(base="1.0.0", new="1.0.0")
cmp fun intrinsic(name: &StrView = "") -> Void {
  # The `intrinsic` annotation is used to indicate that the annotated function is an intrinsic function, which means
  # that it is a built-in function provided by the compiler or runtime environment. Intrinsic functions are implemented
  # in LLVM IR, and are optimized for performance. They may provide access to special hardware features or perform
  # operations that are not available in the standard library.
  # @let ?name: The name of the intrinsic, that the compiler wilkl match and inject IR for.
}

!public
!annotation(target=Annotation::mod)
!versioned(base="1.0.0", new="1.0.0")
cmp fun public() -> Void { }

!public
!annotation(target=Annotation::mod)
!versioned(base="1.0.0", new="1.0.0")
cmp fun package() -> Void { }

!public
!annotation(target=Annotation::mod)
!versioned(base="1.0.0", new="1.0.0")
cmp fun protected() -> Void { }

!public
!annotation(target=Annotation::mod)
!versioned(base="1.0.0", new="1.0.0")
cmp fun private() -> Void { }

!public
!annotation(target=Annotation::method)
!versioned(base="1.0.0", new="1.0.0")
cmp fun virtual_method() -> Void { }

!public
!annotation(target=Annotation::method)
!versioned(base="1.0.0", new="1.0.0")
cmp fun abstract_method() -> Void { }

!public
!annotation(target=Annotation::function)
!versioned(base="1.0.0", new="1.0.0")
cmp fun ffi(symbol: &StrView) -> Void { }

!public
!annotation(target=Annotation::class)
!versioned(base="1.0.0", new="1.0.0")
cmp fun zero_type() -> Void { }

!public
!annotation(target=Annotation::all)
!versioned(base="1.0.0", new="1.1.0")
cmp fun cfg(mode: &StrView = "", family: &StrView = "", os: &StrView = "", arch: &StrView = "", env: &StrView = "", pointer_width: &StrView = "", endian: &StrView = "") -> Void {
  # The `cfg` annotation compiles the annotated item only for the builds it names: the item is dropped, before any
  # scope is made, from a build its condition does not match, as if it were never written. Two items of the same name
  # can then each be written for the builds the other is not, such as `USize` for 32 and 64-bit targets.
  #
  # Every key given must match. A value can name alternatives, separated by `|`, and a leading `!` matches every value
  # but those named: `!cfg(pointer_width="32", os="!windows")` is every 32-bit target but Windows. An unknown key or
  # value is a compile error, not a condition that never holds. Values are spelled as the target's folder names them.
  # @let ?mode: The build mode: "dev" or "rel".
  # @let ?family: The kind of operating system: "unix" (Linux, macOS, FreeBSD, ...), "windows" or "wasm".
  # @let ?os: The operating system: "linux", "macos", "windows", "freebsd" or "wasi".
  # @let ?arch: The architecture, as the target folder spells it: "x86_64", "i386", "aarch64", "arm", "riscv64",
  # "s390x", "powerpc64", "powerpc64le", "mips", "mipsel", "mips64el", "sparcv9", "loongarch64", "m68k", "wasm32", ...
  # @let ?env: The environment, or ABI: "gnu", "musl", "gnueabihf", "gnueabi", "gnuabi64", "gnux32", "msvc", ...
  # @let ?pointer_width: The width of a pointer in bits: "16", "32" or "64".
  # @let ?endian: The byte order: "little" or "big".
}

!public
!annotation(target=Annotation::class)
!versioned(base="1.0.0", new="1.0.0")
cmp fun thread_hazard() -> Void {
  # Marks a type that may never cross a thread boundary. Every type is thread-safe unless it is annotated with this, or
  # reaches an annotated type through one of its attributes or generic arguments. A borrow is exactly as safe as what it
  # borrows, because the exclusivity law leaves no way to mutate through a `&` - which is what lets this one marker
  # stand for both of Rust's `Send` and `Sync` rather than needing a pair of them.
}

!public
!annotation(target=Annotation::class)
!versioned(base="1.0.0", new="1.0.0")
cmp fun sealed() -> Void { }

!public
!annotation(target=Annotation::function)
!versioned(base="1.0.0", new="1.0.0")
cmp fun test(group: &StrView = "") -> Void {
  # The `test` annotation marks a function as a unit test. Such a function is discovered by "spp test", which generates
  # the entry point that runs it, and cannot be called from s++ code. It must be a plain `fun` taking no parameters and
  # returning `Void`.
  # @let ?group: The group the test is reported and filtered under. Defaults to the module the test is written in.
}

!public
!annotation(target=Annotation::all)
!versioned(base="1.0.0", new="1.0.0")
cmp fun versioned(base: &StrView, new: &StrView) -> Void {
  # The `versioned` annotation is used to indicate the version that a function/class etc was introduced into the
  # standard library, and when it was last updated. For example, `!versioned(base="1.0.0", new="1.1.0")` indicates that
  # the annotated item was introduced in version `1.0.0` of the standard library, and was last updated in version
  # `1.1.0`. This information can be used by tools and documentation generators to provide versioning information about
  # the standard library.
  # @let base: A string that represents the version of the STL when the annotated item was first introduced.
  # @let new: A string that represents the version of the STL when the annotated item was last updated. This can be the
  # same as `base` if the item has not been updated since it was introduced.
}
