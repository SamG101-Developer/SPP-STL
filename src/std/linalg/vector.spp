use std::num::bases::FloatingPoint
use std::num::bases::One
use std::num::bases::Zero
use std::ops::add::Add
use std::ops::mul::Mul
use std::ops::sub::Sub

cls Vector[T, cmp n: USize] {
  data: Arr[T, n]
}

sup [T, cmp n: USize] Vector[T, n] {
  fun swap(&mut self, that: &mut Self) -> Void {
    #
    # @let that:
    # @ret:
    # @BLAS: xSWAP

    self@, that@ = that@, self@
  }

  fun copy(&mut self, that: &mut Self) -> Void {
    #
    # @let that:
    # @ret:
    # @BLAS: xCOPY

    self@ = that@
  }
}

sup [T: Add and Sub and Mul and Zero and One, cmp n: USize] Vector[T, n] {
  fun scale(&mut self, alpha: T) -> Void { }

  fun axpy(alphda: T, y: &mut Vector[T, n]) -> Void { }

  fun dot(y: &Vector[T, n]) -> Void { }
}

sup [T: Add and Sub and Mul and Zero and One and FloatingPoint, cmp n: USize] Vector[T, n] {
  fun normal(&self) -> T { }

  fun abs_sum(&self) -> T { }

  fun iamax(&self) -> T { }
}
