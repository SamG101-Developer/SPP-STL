use std::annotations::versioned
use std::clone::Clone
use std::io::StreamErr
use std::fs::file::File
use std::fs::file::FileMode
use std::ops::div::Div
use std::ops::div::DivAssign
use std::ops::drop::Drop
use std::os::consts::path_sep
use std::os::os_string::OsStr
use std::format::Format
use std::format::Formatter

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathNotFoundErr {
  # The `PathNotFoundErr` type represents an error that occurs when a specified
  # path cannot be found in the filesystem. This error is typically returned by
  # methods that attempt to access or manipulate a path that does not exist,
  # such as `is_file`.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathPermissionErr {
  # The `PathPermissionErr` type represents an error that occurs when the
  # program does not have the necessary permissions to access or manipulate a
  # specified path in the filesystem. This error is typically returned when
  # paths are locked down by the operating system or when trying to access
  # protected directories or files.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathLoopErr {
  # The `PathLoopErr` type represents an error that occurs when a path contains
  # a symbolic link that creates a loop in the filesystem. This can lead to
  # infinite recursion when trying to resolve the path, and is typically
  # returned by methods that attempt to resolve symbolic links or canonicalize
  # paths.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathNameTooLongErr {
  # The `PathNameTooLongErr` type represents an error that occurs when a
  # specified path exceeds the maximum length allowed by the operating system.
  # This error is typically encountered when creating a path, whose combined
  # file and directory path exceeds the system-defined limit (e.g., 255
  # characters on many filesystems).
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathExistsErr {
  # The `PathExistsErr` type represents an error that occurs when a path
  # that is to be created, such as a directory or a link, already exists
  # (`EEXIST`).
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathNotADirErr {
  # The `PathNotADirErr` type represents an error that occurs when a
  # directory was needed but the path names something else: either the path
  # itself, or a component before its last one (`ENOTDIR`).
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathIsADirErr {
  # The `PathIsADirErr` type represents an error that occurs when a path
  # names a directory where something else was needed, such as unlinking it
  # as a file (`EISDIR`).
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathNotEmptyErr {
  # The `PathNotEmptyErr` type represents an error that occurs when a
  # directory that has to be empty, as one being removed does, still holds
  # entries (`ENOTEMPTY`).
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathReadOnlyErr {
  # The `PathReadOnlyErr` type represents an error that occurs when a path
  # would be changed on a filesystem that is mounted read-only (`EROFS`).
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathCrossDeviceErr {
  # The `PathCrossDeviceErr` type represents an error that occurs when a
  # rename or a hard link spans two filesystems, which neither can do
  # (`EXDEV`). Copying and then removing the original moves it instead.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathOtherErr {
  # The `PathOtherErr` type represents a generic error that can occur when
  # working with paths in the filesystem. This error is used to capture any
  # other types of errors that do not fit into the specific categories defined
  # by the other error types, such as unexpected I/O errors or platform-specific
  # issues.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls PathNulErr {
  # The `PathNulErr` type represents a path with a `0` byte inside it. The
  # operating system takes a name as nul-terminated, so it would stop at that
  # byte and act on a shorter path; the call is refused instead of made.
}

!public
!versioned(base="1.0.0", new="1.0.0")
type PathErr = PathNotFoundErr
  or PathPermissionErr
  or PathLoopErr
  or PathNameTooLongErr
  or PathExistsErr
  or PathNotADirErr
  or PathIsADirErr
  or PathNotEmptyErr
  or PathReadOnlyErr
  or PathCrossDeviceErr
  or PathNulErr
  or PathOtherErr

sup PathErr {
  !package
  fun from_errno(errno: S32) -> Self {
    # Maps an sppc error code to the `PathErr` variant for it. `PathNulErr` has
    # no code: it is raised before any call is made.
    # @let errno: The code an sppc call returned (never 0).
    # @ret: The variant for the code, or `PathOtherErr` for one with no variant
    #   of its own.

    ret case errno of {
      == sppc::enoent { PathNotFoundErr }
      == sppc::eacces { PathPermissionErr }
      == sppc::eperm { PathPermissionErr }
      == sppc::eloop { PathLoopErr }
      == sppc::enametoolong { PathNameTooLongErr }
      == sppc::eexist { PathExistsErr }
      == sppc::enotdir { PathNotADirErr }
      == sppc::eisdir { PathIsADirErr }
      == sppc::enotempty { PathNotEmptyErr }
      == sppc::erofs { PathReadOnlyErr }
      == sppc::exdev { PathCrossDeviceErr }
      else { PathOtherErr }
    }
  }
}

!public
!versioned(base="1.0.0", new="1.0.0")
!cfg(os="!windows|macos|ios|darwin|tvos|watchos|xros|driverkit|freebsd|netbsd|openbsd|dragonfly|solaris")
cmp path_max: USize = 4096_uz

!public
!versioned(base="1.0.0", new="1.0.0")
!cfg(os="macos|ios|darwin|tvos|watchos|xros|driverkit|freebsd|netbsd|openbsd|dragonfly|solaris")
cmp path_max: USize = 1024_uz

!public
!versioned(base="1.0.0", new="1.0.0")
!cfg(os="windows")
cmp path_max: USize = 260_uz

!public
!versioned(base="1.0.0", new="1.0.0")
cls Path {
  # The `Path` type is used to represent filepaths in a platform-agnostic way.
  # It provides methods for manipulating and querying paths, such as joining
  # paths, extracting file names, and iterating over path components. This type
  # uses C ffi functions that accept the `const char*` input, where-as the
  # `File` type uses the `fd`, keeping these two types isolated. A path is an
  # `OsStr`, as the system's names need not be UTF-8; its pieces are split at
  # the separators and dots, which are ASCII and so never inside a character.
  # @let inner: The inner path, as the system has it.

  !package inner: OsStr
}

sup Path {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new(inner: &StrView) -> Path {
    # A path of some text, such as a literal.
    # @let inner: The path's text.
    # @ret: The path.

    ret Self(inner=OsStr::from(inner))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new(inner: &OsStr) -> Path {
    # A path of a name the system gave, such as an argument.
    # @let inner: The path, as the system has it.
    # @ret: The path.

    ret Self(inner=inner.clone())
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun to_os_str(&self) -> OsStr {
    # The path, as the system has it.
    # @ret: A copy of the path's `OsStr`.

    ret self.inner.clone()
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun to_str(&self) -> Opt[Str] {
    # The path as text, if it is valid UTF-8 (as `OsStr::to_str`).
    # @ret: A `Str` copy, or `None` when it would not be valid UTF-8.

    ret self.inner.to_str()
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun to_str_lossy(&self) -> Str {
    # The path as text, for showing it (as `OsStr::to_str_lossy`).
    # @ret: A `Str` copy, with U+FFFD for any part that is not UTF-8.

    ret self.inner.to_str_lossy()
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun parent(&self) -> Path {
    # The `parent` method returns the parent directory of the path (left of the
    # right-most separator). If the path has no parent, it returns an empty
    # path.
    # @ret: The parent directory as a `Path` object.

    ret case self.last_sep() of {
      is Some(val as idx) { Path(inner=self.inner.slice(0_uz, idx)) }
      else { Path(inner=OsStr::new()) }
    }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun file_name(&self) -> Opt[OsStr] {
    # The `file_name` method returns the file name component of the path (right
    # of the right-most separator, or the whole path if it has none).
    # @ret: The file name, or `None` when it would be empty (an empty path, or
    #   one ending in a separator).

    let start = case self.last_sep() of {
      is Some(val as idx) { idx + 1_uz }
      else { 0_uz }
    }
    case start == self.inner.len() { ret None }
    ret Some(val=self.inner.slice(start, self.inner.len()))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun file_stem(&self) -> Opt[OsStr] {
    # The `file_stem` method returns the file name without its extension (as
    # `extension`): the whole file name when it has none.
    # @ret: The file stem, or `None` when there is no file name.

    let name = self.file_name()?
    ret case Path::extension_dot(&name) of {
      is Some(val as dot) {
        let stem = name.slice(0_uz, dot)
        Some(val=stem)
      }
      else { Some(val=name) }
    }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun extension(&self) -> Opt[OsStr] {
    # The `extension` method returns the file name's extension: what follows
    # its last dot. A dot that starts the name (".bashrc") is part of the name,
    # not an extension.
    # @ret: The extension, or `None` when there is no file name or it has no
    #   extension.

    let name = self.file_name()?
    ret case Path::extension_dot(&name) of {
      is Some(val as dot) { Some(val=name.slice(dot + 1_uz, name.len())) }
      else { None }
    }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun components(&self) -> Vec[OsStr] {
    # The `components` method returns a vector of the individual components of
    # the path, split at every separator (either one on Windows). A leading
    # separator gives an empty first component, as "split" does.
    # @ret: A vector of path components as `OsStr` objects.

    let mut parts = Vec[OsStr]::new()
    let mut start = 0_uz
    let mut idx = 0_uz
    loop idx < self.inner.len() {
      case Path::is_sep(self.inner.byte(idx)) {
        parts.append(self.inner.slice(start, idx))
        start = idx + 1_uz
      }
      idx += 1_uz
    }
    parts.append(self.inner.slice(start, self.inner.len()))
    ret parts
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun sep(&self) -> Char {
    # The `sep` method returns the path separator character for the current
    # platform (`std::os::consts::path_sep`): '\\' on Windows, '/' elsewhere.
    # @ret: The path separator as a `Char` object.

    ret path_sep
  }

  !package
  !versioned(base="1.0.0", new="1.0.0")
  !cfg(family="!windows")
  fun is_sep(byte: U8) -> Bool {
    # The `is_sep` method checks if a byte is a path separator: '/'.
    # @let byte: The byte to check.
    # @ret: `true` if the byte is a path separator, `false` otherwise.

    ret byte == 0x2f_u8
  }

  !package
  !versioned(base="1.0.0", new="1.0.0")
  !cfg(family="windows")
  fun is_sep(byte: U8) -> Bool {
    # The `is_sep` method checks if a byte is a path separator: '\\', or '/',
    # which Windows takes as well.
    # @let byte: The byte to check.
    # @ret: `true` if the byte is a path separator, `false` otherwise.

    ret byte == 0x5c_u8 or byte == 0x2f_u8
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun last_sep(&self) -> Opt[USize] {
    # The index of the right-most separator, if there is one.
    # @ret: The separator's byte index, or `None`.

    let mut idx = self.inner.len()
    loop idx > 0_uz {
      idx -= 1_uz
      case Path::is_sep(self.inner.byte(idx)) { ret Some(val=idx) }
    }
    ret None
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun extension_dot(name: &OsStr) -> Opt[USize] {
    # The index of the dot that starts a file name's extension: its last dot,
    # unless that is its first byte.
    # @let name: The file name.
    # @ret: The dot's byte index, or `None` when the name has no extension.

    let mut idx = name.len()
    loop idx > 1_uz {
      idx -= 1_uz
      case name.byte(idx) == 0x2e_u8 { ret Some(val=idx) }
    }
    ret None
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun matches_at(&self, that: &OsStr, offset: USize) -> Bool {
    # Whether `that`'s bytes appear in this path's at `offset`.
    # @let that: The bytes to look for.
    # @let offset: Where in this path to look.
    # @ret: `true` if every byte matches and none runs past the end.

    case offset + that.len() > self.inner.len() { ret false }
    let mut idx = 0_uz
    loop idx < that.len() {
      case self.inner.byte(offset + idx) != that.byte(idx) { ret false }
      idx += 1_uz
    }
    ret true
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  !cfg(family="!windows")
  fun is_absolute(&self) -> Bool {
    # The `is_absolute` method checks if the path is absolute: it starts with
    # the separator.
    # @ret: `true` if the path is absolute, `false` otherwise.

    ret self.inner.is_empty().not and Path::is_sep(self.inner.byte(0_uz))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  !cfg(family="windows")
  fun is_absolute(&self) -> Bool {
    # The `is_absolute` method checks if the path is absolute: it starts with
    # a separator (the current drive's root), or with a drive letter, a colon
    # and a separator ("C:\\").
    # @ret: `true` if the path is absolute, `false` otherwise.

    case self.inner.is_empty() { ret false }
    case Path::is_sep(self.inner.byte(0_uz)) { ret true }
    ret self.inner.len() >= 3_uz
      and self.inner.byte(1_uz) == 0x3a_u8
      and Path::is_sep(self.inner.byte(2_uz))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun is_relative(&self) -> Bool {
    # The `is_relative` method checks if the path is relative (not absolute).
    # @ret: `true` if the path is relative, `false` otherwise.

    ret self.is_absolute().not
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun starts_with(&self, prefix: &Path) -> Bool {
    # The `starts_with` method checks if the path's bytes start with the
    # prefix's.
    # @let prefix: The prefix to check for.
    # @ret: `true` if the path starts with the prefix, `false` otherwise.

    ret self.matches_at(&prefix.inner, 0_uz)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun ends_with(&self, suffix: &Path) -> Bool {
    # The `ends_with` method checks if the path's bytes end with the suffix's.
    # @let suffix: The suffix to check for.
    # @ret: `true` if the path ends with the suffix, `false` otherwise.

    case suffix.inner.len() > self.inner.len() { ret false }
    ret self.matches_at(&suffix.inner, self.inner.len() - suffix.inner.len())
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun join(self, other: &Path) -> Path {
    # The `join` method joins this path with another, with one separator
    # between them unless either side already has one there.
    # @let other: The path to join onto this one.
    # @ret: The joined path.

    let sep = self.sep()
    let Self(mut inner as new_path) = self

    case new_path.is_empty().not
      and Path::is_sep(new_path.byte(new_path.len() - 1_uz)).not
      and (other.inner.is_empty() or Path::is_sep(other.inner.byte(0_uz)).not) {
      new_path.append(sep)
    }
    new_path.append_os_str(&other.inner)
    ret Path(inner=new_path)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun with_file_name(&self, file_name: &OsStr) -> Path {
    # The `with_file_name` method returns this path with its file name
    # replaced: the parent joined with `file_name`.
    # @let file_name: The new file name.
    # @ret: The new path.

    let parent = self.parent()
    let other = Path(inner=file_name.clone())
    let joined = parent.join(&other)
    ret joined
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun with_extension(&self, extension: &OsStr) -> Path {
    # The `with_extension` method returns this path with its extension
    # replaced, or removed for an empty `extension`.
    # @let extension: The new extension, without its dot.
    # @ret: The new path.

    let mut new_file_name = self.file_stem().unwrap_or(OsStr::new())
    case extension.is_empty().not {
      new_file_name.append('.')
      new_file_name.append_os_str(extension)
    }
    ret self.with_file_name(&new_file_name)
  }

  !package
  !versioned(base="1.0.0", new="1.0.0")
  fun c_path(&self) -> Res[OsStr, PathErr] {
    # The path nul-terminated, for sppc, or `PathNulErr` when a `0` byte is
    # inside it (see `OsStr::to_c_str`).
    # @ret: The terminated copy, or the error.

    ret case self.inner.to_c_str() of {
      is Some(val as z) { Pass(val=z) }
      else { Fail(err=PathNulErr) }
    }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun exists(&self) -> Bool {
    # The `exists` method checks if the path exists in the filesystem. This is a
    # common operation to verify that a file or directory is present before
    # attempting to access it.
    # @ret: `true` if the path exists, `false` otherwise.

    let mut exists = 0
    let path_z = case self.inner.to_c_str() of {
      is Some(val as z) { z }
      else { ret false }
    }
    let err = sppc::access(path_z.ptr().as_c_ref(), sppc::f_ok, &mut exists)
    ret err == 0 and exists == 0
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_exists(&self) -> Res[Bool, PathErr] {
    # The `try_exists` method checks if the path exists in the filesystem,
    # returning a `Res` type that indicates success or failure. This allows the
    # caller to handle errors more gracefully compared to the `exists` method.
    # @ret: A `Res` type containing `true` if the path exists, `false` if it
    #   does not exist, or an error message if the check fails.

    let mut exists = 0
    let path_z = self.c_path()?
    let err = sppc::access(path_z.ptr().as_c_ref(), sppc::f_ok, &mut exists)
    ret case err != 0 { Fail(err=PathErr::from_errno(err)) } else { Pass(val=exists != 0) }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun is_file(&self) -> Bool {
    # The `is_file` method checks if the path points to a regular file in the
    # filesystem. This is useful for distinguishing between files and
    # directories.
    # @ret: `true` if the path is a regular file, `false` otherwise.

    let mut info = sppc::CStat()

    let path_z = case self.inner.to_c_str() of {
      is Some(val as z) { z }
      else { ret false }
    }
    let err = sppc::stat(path_z.ptr().as_c_ref(), &mut info)
    ret case err != 0 { false } else { (S32::from(info.mode) & sppc::s_ifmt) == sppc::s_ifreg }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun is_dir(&self) -> Bool {
    # The `is_dir` method checks if the path points to a directory in the
    # filesystem. This is useful for distinguishing between files and
    # directories.
    # @ret: `true` if the path is a directory, `false` otherwise.

    let mut info = sppc::CStat()

    let path_z = case self.inner.to_c_str() of {
      is Some(val as z) { z }
      else { ret false }
    }
    let err = sppc::stat(path_z.ptr().as_c_ref(), &mut info)
    ret case err != 0 { false } else { (S32::from(info.mode) & sppc::s_ifmt) == sppc::s_ifdir }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun is_symlink(&self) -> Bool {
    # The `is_symlink` method checks if the path points to a symbolic link in
    # the filesystem. This is useful for identifying symbolic links and handling
    # them appropriately.
    # @ret: `true` if the path is a symbolic link, `false` otherwise.

    let mut info = sppc::CStat()

    let path_z = case self.inner.to_c_str() of {
      is Some(val as z) { z }
      else { ret false }
    }
    let err = sppc::lstat(path_z.ptr().as_c_ref(), &mut info)
    ret case err != 0 { false } else { (S32::from(info.mode) & sppc::s_ifmt) == sppc::s_iflnk }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun canonicalize(&self) -> Res[Path, PathErr] {
    # The `canonicalize` method returns the canonical, absolute form of the
    # path, resolving any symbolic links and relative path components. This is
    # useful for obtaining a standardized path representation.
    # @ret: A `Res` type containing the canonicalized `Path` on success, or an
    #   error message if the operation fails.

    # realpath writes a terminated string into the room it is given; the path
    # is what comes before the terminator.
    let mut buffer = OsStr::new_with_capacity(path_max)
    let path_z = self.c_path()?
    let err = sppc::realpath(path_z.ptr().as_c_ref(), buffer.ptr().as_c_mut())
    ret case err == 0 { Pass(val=Path(inner=OsStr::from_c_str(buffer.ptr()))) } else {
      Fail(err=PathErr::from_errno(err))
    }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun create_dir(&self) -> Res[Void, PathErr] {
    # The `create_dir` method attempts to create a new directory at the
    # specified path. As it only creates the topmost directory, it assumes that
    # the parent directory exists. If it doesn't, an error will be returned.
    # @ret: A `Res` type containing `Pass()` if the directory is successfully
    #   created, or an error message if the operation fails.

    # rwxrwxrwx, with the process umask applied on top of it.
    let path_z = self.c_path()?
    let err = sppc::mkdir(path_z.ptr().as_c_ref(), 0o777_u32)
    ret case err == 0 { Pass[Void]() } else { Fail(err=PathErr::from_errno(err)) }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun create_dir_all(&self) -> Res[Void, PathErr] {
    # The `create_dir_all` method attempts to create a new directory at the
    # specified path, along with any necessary parent directories. It
    # recursivelt checks each component, creating directories as needed.
    # @ret: A `Res` type containing `Pass(())` if the directories are
    #   successfully created, or an error message if the operation fails.

    let components = self.components()
    let mut current_path = Path()
    let sep = self.sep()

    loop component in components.iter_mov() {
      # An empty component is a separator with nothing before it: the root of an
      # absolute path, or a doubled separator. Neither is a directory to make.
      case component.is_empty() {
        current_path.inner.append(sep)
        skip
      }
      current_path /= Path(inner=component)
      case current_path.exists() { skip }
      let current_path_z = current_path.c_path()?
      let err = sppc::mkdir(current_path_z.ptr().as_c_ref(), 0o777_u32)
      case err == 0 { skip } else { ret Fail(err=PathErr::from_errno(err)) }
    }
    ret Pass[Void]()
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun remove_file(&self) -> Res[Void, PathErr] {
    # The `remove_file` method attempts to remove the file at the specified
    # path. If the path points to a directory or does not exist, an error will
    # be returned.
    # @ret: A `Res` type containing `Pass()` if the file is successfully
    #   removed, or an error message if the operation fails.

    let path_z = self.c_path()?
    let err = sppc::unlink(path_z.ptr().as_c_ref())
    ret case err == 0 { Pass[Void]() } else { Fail(err=PathErr::from_errno(err)) }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun remove_dir(&self, force: Bool = false) -> Res[Void, PathErr] {
    # The `remove_dir` method attempts to remove the directory at the specified
    # path. If the path points to a file, does not exist, or is not empty, an
    # error will be returned.
    # @let force: If `true`, the method will attempt to remove the directory and
    #   all of its contents recursively. If `false`, the method will only remove
    #   the directory if it is empty.
    # @ret: A `Res` type containing `Pass()` if the directory is successfully
    #   removed, or an error message if the operation fails.
    # @todo: Implement the `force` parameter to recursively remove non-empty
    #   directories.

    let path_z = self.c_path()?
    let err = sppc::rmdir(path_z.ptr().as_c_ref())
    ret case err == 0 { Pass[Void]() } else { Fail(err=PathErr::from_errno(err)) }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun rename_to(&self, new_path: &Path) -> Res[Void, PathErr] {
    # The `rename_to` method attempts to rename the file or directory at the
    # current path to a new path. If the current path does not exist, the new
    # path already exists, or the operation fails for any reason, an error will
    # be returned.
    # @let new_path: The new path to rename to.
    # @ret: A `Res` type containing `Pass()` if the rename is successful, or an
    #   error message if the operation fails.

    let path_z = self.c_path()?
    let new_path_z = new_path.c_path()?
    let err = sppc::rename(path_z.ptr().as_c_ref(), new_path_z.ptr().as_c_ref())
    ret case err == 0 { Pass[Void]() } else { Fail(err=PathErr::from_errno(err)) }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun copy_to(&self, new_path: &Path) -> Res[USize, PathErr] {
    # The `copy_to` method attempts to copy the file at the current path to a
    # new path. If the current path does not exist, the new path already exists,
    # or the operation fails for any reason, an error will be returned.
    # @let new_path: The new path to copy to.
    # @ret: A `Res` type containing the number of bytes copied if the copy is
    #   successful, or an error message if the operation fails.

    # Create the info-carrying stat struct, and defer its deletion
    # as it won't be returned; it's strictly to go to C to get its
    # attributes set from the sppc library.
    let mut info = sppc::CStat()

    # Call the C function to fill the stat's attributes. Consider
    # the error where this function fails, and return the failure.
    # The info get dropped via the defer statement in this case.
    let path_z = self.c_path()?
    let err = sppc::stat(path_z.ptr().as_c_ref(), &mut info)
    case err != 0 { ret Fail(err=PathErr::from_errno(err)) }
    let file_length = info.size

    # Create the two file object for the "in" and "out" file. The
    # "in" file is where the contents are coming from, and the "out"
    # file is where the contents are going to, created, and refused
    # if it already exists. Defer their closing.
    let file_in = File::open(&self, FileMode().read())?
    let file_out = File::open(new_path, FileMode().write().create_new())?

    # Copy until the whole file is across: "copyfile" may copy less than asked (a large file, or a signal arriving),
    # and reports how much it did. Each call carries on from both files' positions. One that copies nothing means the
    # source ended early (it shrank since the stat), so what was copied is the result. An error is returned as it is.
    let target = USize::from(file_length)
    let mut copied = 0_uz
    loop copied < target {
      let mut out_size = 0_sz
      let err = sppc::copyfile(file_in.fd, file_out.fd, target - copied, 0, &mut out_size)
      case err != 0 { ret Fail(err=PathErr::from_errno(err)) }
      case out_size == 0_sz { exit }
      copied += USize::from(out_size)
    }
    ret Pass(val=copied)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun hardlink_to(&self, new_path: &Path) -> Res[Void, PathErr] {
    # The `hardlink_to` method attempts to create a hard link from the current
    # path to a new path. If the current path does not exist, the new path
    # already exists, or the operation fails for any reason, an error will be
    # returned.
    # @let new_path: The new path to create the hard link at.
    # @ret: A `Res` type containing `Pass()` if the hard link is successfully
    #   created, or an error message if the operation fails.

    let path_z = self.c_path()?
    let new_path_z = new_path.c_path()?
    let err = sppc::link(path_z.ptr().as_c_ref(), new_path_z.ptr().as_c_ref())
    ret case err == 0 { Pass[Void]() } else { Fail(err=PathErr::from_errno(err)) }
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun symlink_to(&self, new_path: &Path) -> Res[Void, PathErr] {
    # The `symlink_to` method attempts to create a symbolic link from the
    # current path to a new path. If the current path does not exist, the new
    # path already exists, or the operation fails for any reason, an error will
    # be returned.
    # @let new_path: The new path to create the symbolic link at.
    # @ret: A `Res` type containing `Pass()` if the symbolic link is
    #   successfully created, or an error message if the operation fails.

    let path_z = self.c_path()?
    let new_path_z = new_path.c_path()?
    let err = sppc::symlink(path_z.ptr().as_c_ref(), new_path_z.ptr().as_c_ref())
    ret case err == 0 { Pass[Void]() } else { Fail(err=PathErr::from_errno(err)) }
  }
}

sup Path ext Clone {
  !versioned(base="1.0.0", new="1.0.0")
  fun clone(&self) -> Self {
    # The `clone` method creates a new `Path` instance that is a copy of the
    # current instance. This is useful for creating independent copies of paths
    # that can be modified without affecting the original.
    # @ret: A new `Path` object that is a copy of the current instance.

    ret Path(inner=self.inner.clone())
  }
}

sup Path ext Div {
  !versioned(base="1.0.0", new="1.0.0")
  fun div(self, that: Self) -> Self {
    # The `div` method allows for using the division operator (`/`) to join two
    # paths together. This provides a convenient syntax for building paths in a
    # platform-agnostic way.
    # @let that: The right-hand side path to join with the left-hand side path.
    # @ret: A new `Path` object representing the joined path.

    ret self.join(&that)
  }
}

sup Path ext DivAssign {
  !versioned(base="1.0.0", new="1.0.0")
  fun div_assign(&mut self, that: Self) -> Void {
    # The `div_assign` method allows for using the division assignment operator
    # (`/=`) to join a path with another path and assign the result back to the
    # original path variable. This provides a convenient syntax for building
    # paths in a platform-agnostic way.
    # @let that: The right-hand side path to join with the left-hand side path.
    # @ret: The original `Path` object is modified to represent the joined path.

    let joined = self.clone().join(&that)
    self@ = joined
  }
}

sup Path ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format as its text, lossily (as `to_str_lossy`).

    ret self.inner.fmt(formatter)
  }
}
