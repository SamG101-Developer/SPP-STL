!public
cls Drop {
  # The `Drop` class gives a type a destructor: code run when a value of it is
  # dropped, before its attributes are. Ownership is affine, so a value nobody
  # moved on is dropped where its owner ends, and any value can be; `Drop` is
  # only needed for a type that releases something its attributes do not (a
  # descriptor, a heap allocation). Concrete resource types should also offer a
  # named, fallible consumer -- `close`, `destroy`, `free` -- that takes the
  # value apart (`let Self(..) = self`: a destructure never runs `drop`, and
  # what it skips is dropped attribute by attribute), and keep `drop` as the
  # "discard it, I am not checking" path. It takes no type parameters, as the
  # behaviour operates solely on the instance.
}

sup Drop {
  !protected
  !abstract_method
  fun drop(self) -> Void {
    # The `drop` method releases what a value holds as it is dropped. It takes
    # `self` by move; whatever of `self` it does not take apart is dropped
    # attribute by attribute as it ends, without running `drop` again. Any
    # failure the release runs into is swallowed; a caller that needs to know
    # should call the type's named consumer instead.
  }
}
