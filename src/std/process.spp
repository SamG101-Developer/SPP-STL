use std::annotations::versioned
use std::os::os_string::OsStr

!public
!versioned(base="1.0.0", new="1.0.0")
fun get_proc_id() -> U32 {
  # The `get_proc_id` function retrieves the current process ID (PID) of the
  # running program. It uses the `sppc::get_pid` function to obtain the PID and
  # returns it as an unsigned integer (`U32`).
  # @ret: The current process ID (PID) as a `U32`.

  let mut pid = 0_s32
  sppc::get_pid(&mut pid)
  ret U32::from(pid)
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun get_proc_parent_id() -> U32 {
  # The `get_proc_parent_id` function retrieves the parent process ID (PPID) of
  # the current process. It uses the `sppc::get_ppid` function to obtain the
  # PPID and returns it as an unsigned integer (`U32`).
  # @ret: The parent process ID (PPID) as a `U32`.

  let mut ppid = 0_s32
  sppc::get_ppid(&mut ppid)
  ret U32::from(ppid)
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun get_env(key: &StrView) -> Opt[Str] {
  # Transitional, for the compilers whose `spp test` runner reads its filter
  # through this name: use `std::os::env::get_env`, which gives the value as the
  # system has it. This one gives it as text, lossily (`OsStr::to_str_lossy`).
  # Remove once a compiler whose runner calls `std::os::env::get_env` is out.
  # @let key: The name of the environment variable to retrieve.
  # @ret: The value as text if the variable is set, or `None` if it is not.

  let value = std::os::env::get_env(key)
  ret case value of {
    is Some(val as os) {
      let text = os.to_str_lossy()
      Some(val=text)
    }
    else { None }
  }
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun exit_checked(status: S32) -> ! {
  # The `exit_checked` function cleanly terminates the current process with the
  # specified exit status. It uses the `sppc::exit_clean` function to perform
  # the exit operation. The function does not return a value, as it is intended
  # to terminate the process, but does clean up resources, such as the std
  # streams, before exiting.
  # @let status: The exit status code to be returned when the process
  #   terminates.

  sppc::exit_(status)
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun exit_unchecked(status: S32) -> ! {
  # The `exit_unchecked` function forcefully terminates the current process with
  # the specified exit status. It uses the `sppc::exit_` function to perform the
  # exit operation. This function does not perform any cleanup of resources,
  # such as flushing std streams, and is intended for use in situations where an
  # immediate exit is necessary without concern for resource management.
  # @let status: The exit status code to be returned when the process
  #   terminates.

  sppc::halt(status)
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun abort() -> ! {
  # The `abort` function immediately terminates the current process without
  # performing any cleanup. It uses the `sppc::abort` function to perform the
  # abort operation. This function is typically used in situations where the
  # program encounters a critical error and needs to terminate immediately
  # without concern for resource management or cleanup. The more common
  # `std::abort::abort` function is a wrapper around this function that also
  # prints an error message to stderr before aborting.

  sppc::abort()
}
