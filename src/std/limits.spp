sup Limits[F8] {
  !public type UInt = U8
  !public type SInt = S8

  !public cmp mantissa_digits: U32 = 4_u32
  !public cmp digits: U32 = 0_u32
  !public cmp epsilon: F8 = 0.125_f8
  !public cmp min: F8 = -448.0_f8
  !public cmp min_positive: F8 = 0.015625_f8
  !public cmp max: F8 = 448.0_f8
  !public cmp min_exp: S32 = -5_s32
  !public cmp max_exp: S32 = 9_s32
  !public cmp min_10_exp: S32 = -1_s32
  !public cmp max_10_exp: S32 = 2_s32
  # Todo: No literal is a NaN (or an infinity), and "bit_cast" is not comp-time.
  !public cmp nan: F8 = 0.0_f8
  # An E4M3 "F8" has no infinity: a value past its largest saturates to it.
}

sup Limits[F16] {
  !public type UInt = U16
  !public type SInt = S16

  !public cmp mantissa_digits: U32 = 11_u32
  !public cmp digits: U32 = 3_u32
  !public cmp epsilon: F16 = 0.000977_f16
  !public cmp min: F16 = -65504.0_f16
  !public cmp min_positive: F16 = 0.00006104_f16
  !public cmp max: F16 = 65504.0_f16
  !public cmp min_exp: S32 = -13_s32
  !public cmp max_exp: S32 = 16_s32
  !public cmp min_10_exp: S32 = -4_s32
  !public cmp max_10_exp: S32 = 4_s32
  # Todo: No literal is a NaN (or an infinity), and "bit_cast" is not comp-time.
  !public cmp nan: F16 = 0.0_f16
  !public cmp infinity: F16 = 0.0_f16
  !public cmp neg_infinity: F16 = 0.0_f16
}

