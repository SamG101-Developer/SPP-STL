sup Limits[S256] {
  !public type UInt = U256

  !public cmp max: S256 = 57896044618658097711785492504343953926634992332820282019728792003956564819967_s256
  !public cmp min: S256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968_s256
