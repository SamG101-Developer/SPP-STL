use std::number::SSize
use std::number::U128
use std::number::U16
use std::number::U256
use std::number::U32
use std::number::U64
use std::number::U8
use std::number::USize

# Todo: Change the values to cmp function powers etc (formula).
# Todo: Move these onto the number types themselves + above formula
# Todo: Will be able to remove most duplication this way too!

!public
!versioned(base="1.0.0", new="1.0.0")
cls Limits[T] {
  #
  # @type T:
}

sup Limits[U8] {
  # Specialized limits for the `U8` type.
  # @type SInt: The signed integer type corresponding to `U8`.
  # @type FP: The floating-point type corresponding to `U8`.
  # @cmp max: The maximum value of `U8`.
  # @cmp min: The minimum value of `U8`.

  !public type SInt = S8
  !public type FP = F8

  !public cmp max: U8 = 255_u8
  !public cmp min: U8 = 0_u8
}

sup Limits[U16] {
  !public type SInt = S16
  !public type FP = F16

  !public cmp max: U16 = 65535_u16
  !public cmp min: U16 = 0_u16
}

sup Limits[U32] {
  !public type SInt = S32
  !public type FP = F32

  !public cmp max: U32 = 4294967295_u32
  !public cmp min: U32 = 0_u32
}

sup Limits[U64] {
  !public type SInt = S64
  !public type FP = F64

  !public cmp max: U64 = 18446744073709551615_u64
  !public cmp min: U64 = 0_u64
}

sup Limits[U128] {
  !public type SInt = S128
  !public type FP = F128

  !public cmp max: U128 = 340282366920938463463374607431768211455_u128
  !public cmp min: U128 = 0_u128
}

sup Limits[U256] {
  !public type SInt = S256

  !public cmp max: U256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935_u256
  !public cmp min: U256 = 0_u256
}

