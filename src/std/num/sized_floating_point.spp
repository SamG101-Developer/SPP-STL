sup [cmp w: U32] SizedFloatingPoint[w] {
  # Byte-array conversions for floating point values of any width. The byte
  # representation is that of the value's IEEE-754 bit pattern. Each function
  # reconstructs the same-width unsigned integer bit pattern from the bytes
  # (reusing the integer implementations) and then reinterprets it as a floating
  # point value with `bit_cast`. Exactly `w / 8` bytes are read from the view.

  !public
  !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from_le_bytes(bytes: &View[U8]) -> Self {
    # Reconstruct a floating point value from the little-endian byte
    # representation of its IEEE-754 bit pattern, where `bytes[0]` is the
    # least-significant byte.
    # @let bytes: A view over the little-endian byte representation of the value
    #   (at least `w / 8` bytes).
    # @ret: The reconstructed floating point value.

    ret intrinsics::bit_cast[Self](SizedIntegerUnsigned[w]::from_le_bytes(bytes))
  }

  !public
  !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from_be_bytes(bytes: &View[U8]) -> Self {
    # Reconstruct a floating point value from the big-endian byte representation
    # of its IEEE-754 bit pattern, where `bytes[0]` is the most-significant
    # byte.
    # @let bytes: A view over the big-endian byte representation of the value
    #   (at least `w / 8` bytes).
    # @ret: The reconstructed floating point value.

    ret intrinsics::bit_cast[Self](SizedIntegerUnsigned[w]::from_be_bytes(bytes))
  }

  !public
  !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from_ne_bytes(bytes: &View[U8]) -> Self {
    # Reconstruct a floating point value from the native-endian byte
    # representation of its IEEE-754 bit pattern, matching the in-memory layout
    # of the target.
    # @let bytes: A view over the native-endian byte representation of the value
    #   (at least `w / 8` bytes).
    # @ret: The reconstructed floating point value.

    ret intrinsics::bit_cast[Self](SizedIntegerUnsigned[w]::from_ne_bytes(bytes))
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format a float with a fixed number of digits after the point: the spec's
    # precision, or 6. The last digit is rounded half up from the first digit
    # dropped, carrying into the integer part when needed (`{:.2}` of 0.999 is
    # `1.00`). Digits are taken one at a time off the fraction rather than by
    # scaling it by a power of ten, so a narrow float with a large precision
    # does not overflow. The digits are the exact binary value's, so 0.1 to 20
    # places is `0.10000000000000000555`.
    #
    # Todo: the integer part goes through `U64`, so a magnitude of 2^64 or more
    # does not render correctly. That needs the digits of the float's own
    # integer part, or a shortest round-tripping algorithm (Ryu, Grisu), which
    # would also give `{}` of 0.1 as `0.1` rather than `0.100000`.

    let value = self@

    # The values with no digits are named, right-aligned like
    # any other number.
    case value.is_signaling_nan() or value.is_quiet_nan() {
      formatter.pad_aligned("nan", b'>')
      ret Pass[Void]()
    }
    case value.is_positive_infinity() {
      formatter.pad_aligned("inf", b'>')
      ret Pass[Void]()
    }
    case value.is_negative_infinity() {
      formatter.pad_aligned("-inf", b'>')
      ret Pass[Void]()
    }

    let precision = formatter.spec().precision.unwrap_or(6_uz)
    let magnitude = value.abs()
    let whole_part = magnitude.trunc()
    let mut whole = U64::from(whole_part)
    let mut frac = magnitude - whole_part
    let ten = SizedFloatingPoint[w]::from(10_u32)

    # The fraction's digits, one at a time.
    let mut fraction = Vec[U8]::new()
    let mut i = 0_uz
    loop i < precision {
      frac *= ten
      let digit = frac.trunc()
      fraction.append(U8::from(digit))
      frac -= digit
      i += 1_uz
    }

    # Round half up on the first digit dropped, carrying 9s
    # over into the integer part.
    frac *= ten
    case frac.trunc() >= SizedFloatingPoint[w]::from(5_u32) {
      let mut carry = true
      let mut j = precision
      loop carry and j > 0_uz {
        j -= 1_uz
        case fraction[j]@ == 9_u8 { fraction[mut j]@ = 0_u8 }
        else {
          fraction[mut j]@ = fraction[j]@ + 1_u8
          carry = false
        }
      }
      case carry { whole += 1_u64 }
    }

    # The integer part, the point, then the fraction.
    let mut digits = Str::from(whole)
    case precision > 0_uz { digits.append('.') }
    let mut k = 0_uz
    loop k < fraction.len() {
      digits.append(Char::from(48_u32 + U32::from(fraction[k]@)))
      k += 1_uz
    }

    formatter.pad_integral(value.is_negative().not, &digits)
    drop(digits)
    drop(fraction)
    ret Pass[Void]()
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] {
  # Parsing a floating point value of any width from text. This is a plain
  # method, not the `TryFrom` trait: the text is a `&StrView`, and a borrow
  # cannot be a generic argument (E2), so `TryFrom[&StrView]` cannot be written.

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_from(text: &StrView) -> Opt[Self] {
    # Parse decimal text: an optional `+` or `-`, then digits with at most one
    # `.` (`1.`, `.5` and `1.5` are all accepted), then an optional exponent,
    # `e` or `E` and an `S32` with an optional sign. `inf`, `infinity` and
    # `nan`, in any case and after an optional sign, name the values with no
    # digits. Nothing else is accepted, including surrounding whitespace.
    #
    # The first 19 significant digits are read into a `U64`, so the text is
    # `mantissa * 10^exp10`; that is scaled by a power of ten, in `F64` for a
    # type narrower than it (so an `F16` does not overflow on the mantissa) and
    # in this type otherwise. When the mantissa and the power of ten are both
    # exact (up to 2^53 and 10^22 for an `F64`), one rounding gives the
    # correctly rounded result (Clinger's fast path). Todo: outside the fast
    # path the result can be a few ulps out: digits past the 19th are dropped, a
    # large power of ten is not exact, and a narrower type rounds twice. Correct
    # rounding everywhere needs Eisel-Lemire with a big-integer fallback.
    # @let text: The text to parse.
    # @ret: The value, or `None` if the text is malformed. A value too large is
    #   an infinity and one too small is a zero, of the text's sign.

    let negative = text.starts_with('-')
    let body = case negative or text.starts_with('+') { text[1_uz to text.len()]@ } else { text@ }

    # The named values. An infinity takes the sign; a NaN's sign is not kept.
    case body.eq_fold("inf") or body.eq_fold("infinity") {
      ret Some(val=case negative { Self::neg_inf() } else { Self::inf() })
    }
    case body.eq_fold("nan") { ret Some(val=Self::nan()) }

    # Split off the exponent, which is an `S32` with its own sign.
    let mut digits = body
    let mut exponent = 0_s32
    let exponent_at = body.find_if(|c: Char| c == 'e' or c == 'E')
    case exponent_at is Some(val) {
      exponent = S32::try_from(body[val + 1_uz to body.len()])?
      digits = body[0_uz to val]@
    }
    case digits.is_empty() or digits == "." { ret None }

    # The digits, with the point's position and any dropped integer digits
    # folded into a shift of the exponent. Leading zeros are not significant.
    let mut mantissa = 0_u64
    let mut significant = 0_u32
    let mut shift = 0_s32
    let mut seen_point = false
    loop byte in digits.bytes() {
      case byte == b'.' {
        case seen_point { ret None }
        seen_point = true
      }
      else {
        let digit = U64::from(byte.to_digit(10_u32)?)
        case significant == 19_u32 {
          case seen_point.not { shift += 1_s32 }
        }
        else {
          mantissa = mantissa * 10_u64 + digit
          case mantissa != 0_u64 { significant += 1_u32 }
          case seen_point { shift -= 1_s32 }
        }
      }
    }

    let exp10 = exponent.add_saturating(shift)
    # Narrowed with no check: a value too large for this type is its infinity.
    let magnitude = case w < 64_u32 {
      Self::from_ieee(SizedFloatingPoint[64_u32]::scale_decimal(mantissa, exp10))
    }
    else {
      Self::scale_decimal(mantissa, exp10)
    }
    ret Some(val=case negative { magnitude.neg() } else { magnitude })
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] {
  fun scale_decimal(mantissa: U64, exp10: S32) -> Self {
    # The value `mantissa * 10^exp10` in this type. A positive power that
    # overflows is right to: the mantissa is at least 1, so the value is past
    # the maximum too. A negative one is applied as a division, and when its
    # reciprocal power overflows (a subnormal result), `10^22` is divided out
    # first so the rest fits.
    # @let mantissa: The significant digits.
    # @let exp10: The power of ten to scale them by.
    # @ret: The scaled value, rounded at each step.

    # In the IEEE forms throughout: the overflow is the result, an infinity.
    let value = Self::from(mantissa)
    case mantissa == 0_u64 or exp10 == 0_s32 { ret value }
    let ten = Self::from(10_u32)
    let exp = exp10.max(-100000_s32)
    case exp > 0_s32 { ret value.mul_ieee(ten.pow_ieee(exp)) }

    let power = ten.pow_ieee(0_s32 - exp)
    case power.is_positive_infinity().not { ret value.div_ieee(power) }
    ret value.div_ieee(ten.pow_ieee(22_s32)).div_ieee(ten.pow_ieee(0_s32 - exp - 22_s32))
  }
}
