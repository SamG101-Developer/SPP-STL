  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun round(self) -> Self {
    # The nearest integral value, a half rounded away from zero (2.5 to 3, -2.5
    # to -3), as C's and Rust's `round`.
    ret intrinsics::float_round(self)
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun round_even(self) -> Self {
    # The nearest integral value, a half rounded to the even neighbour (2.5 to
    # 2, 3.5 to 4): IEEE 754's roundToIntegralTiesToEven, which does not drift
    # up or down over many roundings.
    ret intrinsics::float_round_even(self)
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun trunc(self) -> Self {
    ret intrinsics::float_trunc(self)
  }
}

