  # size as the other before performing the subtraction.

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun sub(self, that: Self) -> Self {
    # The `sub` method defines how to subtract one floating point value from
    # another floating point value of the same size. It uses the `float_sub`
    # intrinsic function to perform the subtraction, which computes the
    # difference of the two values according to the rules of floating point
    # arithmetic.
    # @let that: The floating point value that is being subtracted from the
    #   current value. It is of the same size as the current value.
    # @ret: The result of the subtraction operation, which is a new floating
    #   point value of the same size as the operands.

    # Hook into subtraction intrinsic.
    ret intrinsics::float_sub(self, that)
  }
}

