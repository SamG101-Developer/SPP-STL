sup [cmp w: U32] SizedFloatingPoint[w] ext Pow {
  # Provide exponentiation support to sized floating point numbers, allowing for
  # the calculation of one floating point value raised to the power of another
  # floating point value of the same size. For differing sizes, the `From` trait
  # can be used to convert one of the values to the same size as the other
  # before performing the exponentiation.

  !versioned(base="1.0.0", new="1.0.0")
  fun pow(self, that: Self) -> Self {
    # The `pow` method defines how to calculate one floating point value raised
    # to the power of another floating point value of the same size. It uses the
    # `float_powf` intrinsic function to perform the exponentiation, which
    # computes the result according to the rules of floating point arithmetic.
    # @let that: The floating point value that is being used as the exponent in
    #   the exponentiation operation. It is of the same size as the current
    #   value (the base).
    # @ret: The result of the exponentiation operation, which is a new floating
    #   point value of the same size as the operands.

    # Hook into exponentiation intrinsic.
    ret intrinsics::float_powf(self, that)
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Pow[Rhs=S32] {
  # Provide exponentiation support to sized floating point numbers with an `S32`
  # exponent, allowing for the calculation of one floating point value raised to
  # the power of an `S32` integer exponent. For differing sizes, the `From`
  # trait can be used to convert the floating point value to the same size as
  # the other before performing the exponentiation.

  !versioned(base="1.0.0", new="1.0.0")
  fun pow(self, that: S32) -> Self {
    # The `pow` method defines how to calculate one floating point value raised
    # to the power of an `S32` integer exponent. It squares and multiplies, one
    # bit of the exponent at a time, and takes the reciprocal for a negative
    # one, as compiler-rt's `__powidf2` does. Written out here rather than as
    # `llvm.powi`, whose order of multiplications LLVM leaves undefined, so the
    # result is the same at every optimisation level and on every target. Each
    # multiplication rounds, so a large exponent is a few ulps from the exact
    # power.
    # @let that: The `S32` integer value that is being used as the exponent in
    #   the exponentiation operation. The base (the current value) is raised to
    #   the power of this integer exponent.
    # @ret: The result of the exponentiation operation, which is a new floating
    #   point value of the same size as the base (the current value).

    # Computed with no check, and only the result checked: for a large
    # negative exponent the power overflows on the way to a result that is
    # finite (its reciprocal, a subnormal or zero). The check is a checked
    # multiply by one, which stops on a NaN or infinite result and changes
    # nothing else (a NaN's payload and a zero's sign are kept).
    ret self.pow_ieee(that) * Self::one()
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] {
  # The forms of the checked operations for values made non-finite on purpose.
  # With "[binary.codegen] float_checks" on, `+`, `-`, `*`, `/`, `%` and `sqrt`
  # stop the program on a NaN or infinite result, whatever the operands, as an
  # integer `+` stops on an overflow. `*_ieee` is IEEE 754's result with no
  # check (as `*_wrapping` is for an integer), `*_raised` that result and
  # whether the checked form would have stopped (as `*_overflow`), and
  # `*_checked` the result, or `None` where it would have stopped.

  !public !inline
  cmp fun add_ieee(self, that: Self) -> Self {
    ret intrinsics::float_add_ieee(self, that)
  }

  !public !inline
  cmp fun sub_ieee(self, that: Self) -> Self {
    ret intrinsics::float_sub_ieee(self, that)
  }

  !public !inline
  cmp fun mul_ieee(self, that: Self) -> Self {
    ret intrinsics::float_mul_ieee(self, that)
  }

  !public !inline
  cmp fun div_ieee(self, that: Self) -> Self {
    ret intrinsics::float_div_ieee(self, that)
  }

  !public !inline
  cmp fun rem_ieee(self, that: Self) -> Self {
    ret intrinsics::float_rem_ieee(self, that)
  }

  !public !inline
  fun sqrt_ieee(self) -> Self {
    ret intrinsics::float_sqrt_ieee(self)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun pow_ieee(self, that: S32) -> Self {
    # `pow` with no check, as `add_ieee` is `+`'s: IEEE's infinity on an
    # overflow, and a NaN or infinity going in passing through.
    # @let that: The exponent.
    # @ret: The power.
    let mut base = self
    let mut n = that
    let mut result = Self::one()
    loop true {
      case n.bit_and(1_s32) != 0_s32 { result = result.mul_ieee(base) }
      n = n / 2_s32
      case n == 0_s32 { exit }
      base = base.mul_ieee(base)
    }
    ret case that < 0_s32 { Self::one().div_ieee(result) } else { result }
  }

  !public !inline
  fun add_raised(self, that: Self) -> (Self, Bool) {
    ret intrinsics::float_add_raised(self, that)
  }

  !public !inline
  fun sub_raised(self, that: Self) -> (Self, Bool) {
    ret intrinsics::float_sub_raised(self, that)
  }

  !public !inline
  fun mul_raised(self, that: Self) -> (Self, Bool) {
    ret intrinsics::float_mul_raised(self, that)
  }

  !public !inline
  fun div_raised(self, that: Self) -> (Self, Bool) {
    ret intrinsics::float_div_raised(self, that)
  }

  !public !inline
  fun rem_raised(self, that: Self) -> (Self, Bool) {
    ret intrinsics::float_rem_raised(self, that)
  }

  !public !inline
  fun sqrt_raised(self) -> (Self, Bool) {
    ret intrinsics::float_sqrt_raised(self)
  }

  !public !inline
  fun add_checked(self, that: Self) -> Opt[Self] {
    let (val, raised) = intrinsics::float_add_raised(self, that)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun sub_checked(self, that: Self) -> Opt[Self] {
    let (val, raised) = intrinsics::float_sub_raised(self, that)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun mul_checked(self, that: Self) -> Opt[Self] {
    let (val, raised) = intrinsics::float_mul_raised(self, that)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun div_checked(self, that: Self) -> Opt[Self] {
    let (val, raised) = intrinsics::float_div_raised(self, that)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun rem_checked(self, that: Self) -> Opt[Self] {
    let (val, raised) = intrinsics::float_rem_raised(self, that)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun sqrt_checked(self) -> Opt[Self] {
    let (val, raised) = intrinsics::float_sqrt_raised(self)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  cmp fun nan() -> Self {
    # A quiet NaN, made as IEEE's `0 / 0`.
    ret intrinsics::float_div_ieee(Self::zero(), Self::zero())
  }

  !public !inline
  cmp fun inf() -> Self {
    # Positive infinity, made as IEEE's `1 / 0`.
    ret intrinsics::float_div_ieee(Self::one(), Self::zero())
  }

  !public !inline
  cmp fun neg_inf() -> Self {
    # Negative infinity, made as IEEE's `-1 / 0`.
    ret intrinsics::float_div_ieee(Self::neg_one(), Self::zero())
  }

  !public !inline
  fun is_nan(self) -> Bool {
    # Whether this is a NaN, quiet or signalling.
    ret self.is_quiet_nan() or self.is_signaling_nan()
  }

  !public !inline
  fun is_infinite(self) -> Bool {
    # Whether this is either infinity.
    ret self.is_positive_infinity() or self.is_negative_infinity()
  }

  !public !inline
  fun is_finite(self) -> Bool {
    # Whether this is neither a NaN nor an infinity: what a checked operation
    # gives, and what it takes without stopping.
    ret (self.is_nan() or self.is_infinite()).not
  }

  !public !inline
  fun from_ieee[cmp that_w: U32](that: SizedFloatingPoint[that_w]) -> Self {
    # `from` with no check when narrowing: a value past this type's range is
    # IEEE's infinity rather than stopping the program.
    ret case w of {
      < that_w { intrinsics::fptrunc_ieee[w](that) }
      > that_w { intrinsics::fpext[w](that) }
      else { intrinsics::bit_cast[Self](that) }
    }
  }
}

