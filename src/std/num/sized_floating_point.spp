!package
!versioned(base="1.0.0", new="1.0.0")
cls SizedFloatingPoint[cmp w: U32] {
  # The `SizedFloatingPoint` class represents a floating point type with a
  # specific bit width. The `w` parameter is a compile-time constant that
  # specifies the number of bits used to represent the floating point value.
  # This allows for the creation of floating point types with different levels
  # of precision, such as single precision (32 bits) and double precision (64
  # bits). The `SizedFloatingPoint` class is a generic class that can be
  # extended to create specific sized floating point types, and it provides
  # various methods for performing mathematical operations and comparisons on
  # floating point values of the specified size.
  # @cmp w: The number of bits used to represent the floating point value. This
  #   is a compile-time constant that determines the precision of the floating
  #   point type. The provided values for `w` are: - `8`: Quarter precision
  #   floating point (binary8) - `16`: Half precision floating point (binary16)
  #   - `32`: Single precision floating point (binary32) - `64`: Double
  #   precision floating point (binary64) - `128`: Quadruple precision floating
  #   point (binary128)
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Copy {
  # The `SizedFloatingPoint` class implements the `Copy` trait, which means that
  # instances of sized floating point types can be copied by value. This allows
  # for the creation of new instances of sized floating point types without
  # having to explicitly clone or move the original instance.
}

sup [cmp w: U32] SizedFloatingPoint[w] ext FloatingPoint {
  # The `SizedFloatingPoint` class extends the `FloatingPoint` class, which
  # means that all sized floating point types are also considered floating point
  # types. This allows for the use of sized floating point types in contexts
  # where a floating point type is expected, such as in mathematical operations
  # or generic functions that operate on floating point types, where the size is
  # not important, typically code in the `instrinsics` module. This also saves
  # on monomorphization costs.
}

sup [cmp this_w: U32, cmp that_w: U32]
SizedFloatingPoint[this_w] ext
From[SizedFloatingPoint[that_w]] {
  # Converting between floating point types of potentially different sizes.

  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedFloatingPoint[that_w]) -> Self {
    # The `from` method defines how to convert a floating point value of one
    # size to another size. The conversion is performed based on the
    # relationship between the bit widths of the source and target types. The
    # following three cases are handled:
    # 1. If the target type has fewer bits than the source type (this_w <
    #   that_w), the conversion is done by truncating the source value to fit
    #   into the smaller target type. This is typically done by discarding the
    #   least significant bits of the source value, which may result in a loss
    #   of precision.
    # 2. If the target type has more bits than the source type (this_w >
    #   that_w), the conversion is done by extending the source value to fit
    #   into the larger target type. This is typically done by adding additional
    #   bits to the source value, which may involve zero-extending or
    #   sign-extending the value depending on whether it is unsigned or signed.
    # 3. If the target type has the same number of bits as the source type
    #   (this_w == that_w), the conversion is simply a copy of the value, as no
    #   change in precision is needed.
    # @let that: The floating point value of the source type that is being
    #   converted to the target type.
    # @ret: The converted floating point value of the target type, which may
    #   have a different precision than the source value depending on the
    #   relationship between their bit widths.

    # If the source has more bits, truncate it.
    # If the source has fewer bits, extend it.
    ret case this_w of {
      < that_w { intrinsics::fptrunc[this_w](that) }
      > that_w { intrinsics::fpext[this_w](that) }
      else { intrinsics::bit_cast[Self](that) }
    }
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] {
  !public !inline
  fun from_ieee[cmp that_w: U32](that: SizedFloatingPoint[that_w]) -> Self {
    # `from` with no check when narrowing: a value past this type's range is
    # IEEE's infinity rather than stopping the program.
    ret case w of {
      < that_w { intrinsics::fptrunc_ieee[w](that) }
      > that_w { intrinsics::fpext[w](that) }
      else { intrinsics::bit_cast[Self](that) }
    }
  }
}

sup [cmp w: U32, cmp that_w: U32] SizedFloatingPoint[w] ext From[SizedIntegerUnsigned[that_w]] {
  # Converting from an unsigned integer of any width to a floating point value
  # of this width. This is a value conversion (the integer's numeric value,
  # rounded to the nearest representable float), not a bit reinterpretation.

  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedIntegerUnsigned[that_w]) -> Self {
    # Convert the unsigned integer source value to this floating point type
    # using the `uitofp` intrinsic.
    # @let that: The unsigned integer value of the source type that is being
    #   converted.
    # @ret: The converted floating point value of this type.

    ret intrinsics::uitofp[w](that)
  }
}

sup [cmp w: U32, cmp that_w: U32] SizedFloatingPoint[w] ext From[SizedIntegerSigned[that_w]] {
  # Converting from a signed integer of any width to a floating point value of
  # this width. This is a value conversion (the integer's numeric value, rounded
  # to the nearest representable float), not a bit reinterpretation.

  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedIntegerSigned[that_w]) -> Self {
    # Convert the signed integer source value to this floating point type using
    # the `sitofp` intrinsic.
    # @let that: The signed integer value of the source type that is being
    #   converted.
    # @ret: The converted floating point value of this type.

    ret intrinsics::sitofp[w](that)
  }
}

