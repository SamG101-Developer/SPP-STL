  !public !inline
  fun tanh_ieee(self) -> Self {
    ret intrinsics::float_tanh_ieee(self)
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun asinh(self) -> Self {
    # ln(|x| + sqrt(x^2 + 1)), with x's sign. From |x| = 1 up, as ln(|x|) + ln(1
    # + sqrt(1 + (1/x)^2)), where x^2 would overflow long before the result
    # does. Checked: a NaN going in stops it.
    let ax = self.abs()
    let r = case ax < Self::one() { (ax + (ax * ax + Self::one()).sqrt()).ln() } else {
      let inv = Self::one() / ax
      ax.ln() + (Self::one() + (Self::one() + inv * inv).sqrt()).ln()
    }
    ret case self.is_negative() { r.neg() } else { r }
  }

  !public !inline
  fun asinh_checked(self) -> Opt[Self] {
    let (val, raised) = self.asinh_raised()
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun asinh_raised(self) -> (Self, Bool) {
    let val = self.asinh_ieee()
    ret (val, val.is_finite().not)
  }

  !public !inline
  fun asinh_ieee(self) -> Self {
    # `asinh` with no check: a NaN or infinity passes through.
    let ax = self.abs()
    let r = case ax < Self::one() { ax.add_ieee(ax.mul_ieee(ax).add_ieee(Self::one()).sqrt_ieee()).ln_ieee() } else {
      let inv = Self::one().div_ieee(ax)
      ax.ln_ieee().add_ieee(Self::one().add_ieee(Self::one().add_ieee(inv.mul_ieee(inv)).sqrt_ieee()).ln_ieee())
    }
    ret case self.is_negative() { r.neg() } else { r }
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun acosh(self) -> Self {
    # ln(x + sqrt(x^2 - 1)), as ln(x) + ln(1 + sqrt(1 - (1/x)^2)) so that x^2
    # cannot overflow. Below 1 there is no result: checked, it stops (invalid,
    # the square root of a negative).
    case self < Self::one() { ret (self * self - Self::one()).sqrt() }
    let inv = Self::one() / self
    ret self.ln() + (Self::one() + (Self::one() - inv * inv).sqrt()).ln()
  }

  !public !inline
  fun acosh_checked(self) -> Opt[Self] {
    let (val, raised) = self.acosh_raised()
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun acosh_raised(self) -> (Self, Bool) {
    let val = self.acosh_ieee()
    ret (val, val.is_finite().not)
  }

  !public !inline
  fun acosh_ieee(self) -> Self {
    # `acosh` with no check: below 1, a NaN.
    case self < Self::one() { ret self.mul_ieee(self).sub_ieee(Self::one()).sqrt_ieee() }
    let inv = Self::one().div_ieee(self)
    ret self.ln_ieee().add_ieee(Self::one().add_ieee(Self::one().sub_ieee(inv.mul_ieee(inv)).sqrt_ieee()).ln_ieee())
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun atanh(self) -> Self {
    # 0.5 * ln((1 + x) / (1 - x)). Checked: at 1 it stops on a division by zero,
    # at -1 on the logarithm's pole, and past either as invalid (the logarithm
    # of a negative).
    let one = Self::one()
    ret ((one + self) / (one - self)).ln() * Self::from(0.5_f64)
  }

  !public !inline
  fun atanh_checked(self) -> Opt[Self] {
    let (val, raised) = self.atanh_raised()
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun atanh_raised(self) -> (Self, Bool) {
    let val = self.atanh_ieee()
    ret (val, val.is_finite().not)
  }

  !public !inline
  fun atanh_ieee(self) -> Self {
    # `atanh` with no check: an infinity at -1 and 1, a NaN past them.
    let one = Self::one()
    ret one.add_ieee(self).div_ieee(one.sub_ieee(self)).ln_ieee().mul_ieee(Self::from(0.5_f64))
  }
}

