!package
!versioned(base="1.0.0", new="1.0.0")
cls SizedFloatingPoint[cmp w: U32] {
  # The `SizedFloatingPoint` class represents a floating point type with a
  # specific bit width. The `w` parameter is a compile-time constant that
  # specifies the number of bits used to represent the floating point value.
  # This allows for the creation of floating point types with different levels
  # of precision, such as single precision (32 bits) and double precision (64
  # bits). The `SizedFloatingPoint` class is a generic class that can be
  # extended to create specific sized floating point types, and it provides
  # various methods for performing mathematical operations and comparisons on
  # floating point values of the specified size.
  # @cmp w: The number of bits used to represent the floating point value. This
  #   is a compile-time constant that determines the precision of the floating
  #   point type. The provided values for `w` are: - `8`: Quarter precision
  #   floating point (binary8) - `16`: Half precision floating point (binary16)
  #   - `32`: Single precision floating point (binary32) - `64`: Double
  #   precision floating point (binary64) - `128`: Quadruple precision floating
  #   point (binary128)
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Copy {
  # The `SizedFloatingPoint` class implements the `Copy` trait, which means that
  # instances of sized floating point types can be copied by value. This allows
  # for the creation of new instances of sized floating point types without
  # having to explicitly clone or move the original instance.
}

sup [cmp w: U32] SizedFloatingPoint[w] ext FloatingPoint {
  # The `SizedFloatingPoint` class extends the `FloatingPoint` class, which
  # means that all sized floating point types are also considered floating point
  # types. This allows for the use of sized floating point types in contexts
  # where a floating point type is expected, such as in mathematical operations
  # or generic functions that operate on floating point types, where the size is
  # not important, typically code in the `instrinsics` module. This also saves
  # on monomorphization costs.
}

sup [cmp this_w: U32, cmp that_w: U32]
SizedFloatingPoint[this_w] ext
From[SizedFloatingPoint[that_w]] {
  # Converting between floating point types of potentially different sizes.

  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedFloatingPoint[that_w]) -> Self {
    # The `from` method defines how to convert a floating point value of one
    # size to another size. The conversion is performed based on the
    # relationship between the bit widths of the source and target types. The
    # following three cases are handled:
    # 1. If the target type has fewer bits than the source type (this_w <
    #   that_w), the conversion is done by truncating the source value to fit
    #   into the smaller target type. This is typically done by discarding the
    #   least significant bits of the source value, which may result in a loss
    #   of precision.
    # 2. If the target type has more bits than the source type (this_w >
    #   that_w), the conversion is done by extending the source value to fit
    #   into the larger target type. This is typically done by adding additional
    #   bits to the source value, which may involve zero-extending or
    #   sign-extending the value depending on whether it is unsigned or signed.
    # 3. If the target type has the same number of bits as the source type
    #   (this_w == that_w), the conversion is simply a copy of the value, as no
    #   change in precision is needed.
    # @let that: The floating point value of the source type that is being
    #   converted to the target type.
    # @ret: The converted floating point value of the target type, which may
    #   have a different precision than the source value depending on the
    #   relationship between their bit widths.

    # If the source has more bits, truncate it.
    # If the source has fewer bits, extend it.
    ret case this_w of {
      < that_w { intrinsics::fptrunc[this_w](that) }
      > that_w { intrinsics::fpext[this_w](that) }
      else { intrinsics::bit_cast[Self](that) }
    }
  }
}

sup [cmp w: U32, cmp that_w: U32] SizedFloatingPoint[w] ext From[SizedIntegerUnsigned[that_w]] {
  # Converting from an unsigned integer of any width to a floating point value
  # of this width. This is a value conversion (the integer's numeric value,
  # rounded to the nearest representable float), not a bit reinterpretation.

  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedIntegerUnsigned[that_w]) -> Self {
    # Convert the unsigned integer source value to this floating point type
    # using the `uitofp` intrinsic.
    # @let that: The unsigned integer value of the source type that is being
    #   converted.
    # @ret: The converted floating point value of this type.

    ret intrinsics::uitofp[w](that)
  }
}

sup [cmp w: U32, cmp that_w: U32] SizedFloatingPoint[w] ext From[SizedIntegerSigned[that_w]] {
  # Converting from a signed integer of any width to a floating point value of
  # this width. This is a value conversion (the integer's numeric value, rounded
  # to the nearest representable float), not a bit reinterpretation.

  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedIntegerSigned[that_w]) -> Self {
    # Convert the signed integer source value to this floating point type using
    # the `sitofp` intrinsic.
    # @let that: The signed integer value of the source type that is being
    #   converted.
    # @ret: The converted floating point value of this type.

    ret intrinsics::sitofp[w](that)
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Eq {
  # Provide equality support to sized floating point numbers, allowing for
  # comparison of two floating point values of the same size for equality and
  # inequality. For differing sizes, the `From` trait can be used to convert one
  # of the values to the same size as the other before performing the
  # comparison.

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun eq(&self, that: &Self) -> Bool {
    # The `eq` method defines how to compare two floating point values of the
    # same size for equality. It uses the `oeq` intrinsic function to perform
    # the comparison, which checks if the two values are equal according to the
    # rules of floating point arithmetic.
    # @let that: A borrow to the floating point value that is being compared to
    #   the current value for equality.
    # @ret: `true` if the two floating point values are equal, and `false`
    #   otherwise.

    # Hook into equality intrinsic.
    ret intrinsics::oeq(self, that)
  }

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun ne(&self, that: &Self) -> Bool {
    # The `ne` method defines how to compare two floating point values of the
    # same size for inequality. It uses the `une` intrinsic function (unordered
    # not-equal), IEEE 754's "!=": always the negation of `eq`, so a NaN is
    # unequal to everything, itself included, and `x != x` is how a NaN is
    # found.
    # @let that: A borrow to the floating point value that is being compared to
    #   the current value for inequality.
    # @ret: `true` if the two floating point values are not equal (either is a
    #   NaN), and `false` otherwise.

    # Hook into inequality intrinsic.
    ret intrinsics::une(self, that)
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Ord {
  # Provide ordering support to sized floating point numbers, allowing for
  # comparison of two floating point values of the same size to determine their
  # relative ordering. For differing sizes, the `From` trait can be used to
  # convert one of the values to the same size as the other before performing
  # the comparison.

  !versioned(base="1.0.0", new="1.0.0")
  fun ord(&self, that: &Self) -> S32 {
    # The `ord` method defines how to compare two floating point values of the
    # same size and determine their ordering. `Ord` asks for a total order,
    # which the IEEE comparisons are not (a NaN is neither less, greater nor
    # equal), so it is IEEE 754's totalOrder (`total_cmp`): -NaN < -inf < ... <
    # -0 < +0 < ... < +inf < +NaN. It agrees with `<` and `==` everywhere except
    # at NaNs and the two zeros; the operators keep their IEEE meaning, as this
    # type overrides them.
    # @let that: A borrow to the floating point value that is being compared to
    #   the current value for ordering.
    # @ret: An `S32` value indicating the ordering of the two floating point
    #   values:
    # - A negative value indicates that the current value is less than the other
    #   value.
    # - Zero indicates that the two values are the same value (bit for bit).
    # - A positive value indicates that the current value is greater than the
    #   other value.

    ret self.total_cmp(that)
  }

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun lt(&self, that: &Self) -> Bool {
    # The `lt` method defines how to compare two floating point values of the
    # same size to determine if the current value is less than the other value.
    # It uses the `olt` intrinsic function to perform the comparison, which
    # checks if the current value is less than the other value according to the
    # rules of floating point arithmetic.
    # @let that: A borrow to the floating point value that is being compared to
    #   the current value for ordering.
    # @ret: `true` if the current value is less than the other value, and
    #   `false` otherwise.

    # Hook into less-than intrinsic.
    ret intrinsics::olt(self, that)
  }

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun le(&self, that: &Self) -> Bool {
    # The `le` method defines how to compare two floating point values of the
    # same size to determine if the current value is less than or equal to the
    # other value. It uses the `ole` intrinsic function to perform the
    # comparison, which checks if the current value is less than or equal to the
    # other value according to the rules of floating point arithmetic.
    # @let that: A borrow to the floating point value that is being compared to
    #   the current value for ordering.
    # @ret: `true` if the current value is less than or equal to the other
    #   value, and `false` otherwise.

    # Hook into less-than-or-equal-to intrinsic.
    ret intrinsics::ole(self, that)
  }

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun gt(&self, that: &Self) -> Bool {
    # The `gt` method defines how to compare two floating point values of the
    # same size to determine if the current value is greater than the other
    # value. It uses the `ogt` intrinsic function to perform the comparison,
    # which checks if the current value is greater than the other value
    # according to the rules of floating point arithmetic.
    # @let that: A borrow to the floating point value that is being compared to
    #   the current value for ordering.
    # @ret: `true` if the current value is greater than the other value, and
    #   `false` otherwise.

    # Hook into greater-than intrinsic.
    ret intrinsics::ogt(self, that)
  }

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun ge(&self, that: &Self) -> Bool {
    # The `ge` method defines how to compare two floating point values of the
    # same size to determine if the current value is greater than or equal to
    # the other value. It uses the `oge` intrinsic function to perform the
    # comparison, which checks if the current value is greater than or equal to
    # the other value according to the rules of floating point arithmetic.
    # @let that: A borrow to the floating point value that is being compared to
    #   the current value for ordering.
    # @ret: `true` if the current value is greater than or equal to the other
    #   value, and `false` otherwise.

    # Hook into greater-than-or-equal-to intrinsic.
    ret intrinsics::oge(self, that)
  }

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun min(self, that: Self) -> Self {
    # The `min` method defines how to calculate the minimum of two floating
    # point values of the same size: IEEE 754-2019's `minimum`, so a NaN operand
    # gives a NaN (it is not skipped, as the 2008 `minNum` did) and -0 is below
    # +0.
    # @let that: The floating point value that is being compared with the
    #   current value to determine the minimum. It is of the same size as the
    #   current value.
    # @ret: The result of the minimum calculation, which is a new floating point
    #   value of the same size as the operands, representing the smaller of the
    #   two values.
    ret intrinsics::float_min(self, that)
  }

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun max(self, that: Self) -> Self {
    # The `max` method defines how to calculate the maximum of two floating
    # point values of the same size: IEEE 754-2019's `maximum`, so a NaN operand
    # gives a NaN (it is not skipped, as the 2008 `maxNum` did) and +0 is above
    # -0.
    # @let that: The floating point value that is being compared with the
    #   current value to determine the maximum. It is of the same size as the
    #   current value.
    # @ret: The result of the maximum calculation, which is a new floating point
    #   value of the same size as the operands, representing the larger of the
    #   two values.
    ret intrinsics::float_max(self, that)
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] {
  !public !inline
  fun total_cmp(&self, that: &Self) -> S32 {
    # A total order over every value (IEEE 754's totalOrder), which `ord` uses,
    # unlike `<` and `==`, which have no answer for a NaN and call -0 and +0
    # equal: -NaN < -inf < ... < -0 < +0 < ... < +inf < +NaN. The bits read as a
    # signed integer already order the positives and put every negative below
    # them; flipping a negative's bits below the sign puts the larger magnitudes
    # lower (Hacker's Delight 2nd ed., section 17-3).
    # @let that: A borrow to the value compared with this one.
    # @ret: -1, 0 or 1, as `ord`.
    let this_bits = intrinsics::bit_cast[SizedIntegerSigned[w]](self@)
    let that_bits = intrinsics::bit_cast[SizedIntegerSigned[w]](that@)
    let this_key = this_bits ^ intrinsics::bit_shr(intrinsics::bit_ashr(this_bits, w - 1_u32), 1_u32)
    let that_key = that_bits ^ intrinsics::bit_shr(intrinsics::bit_ashr(that_bits, w - 1_u32), 1_u32)
    ret intrinsics::scmp(&this_key, &that_key)
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Add {
  # Provide addition support to sized floating point numbers, allowing for the
  # addition of two floating point values of the same size. For differing sizes,
  # the `From` trait can be used to convert one of the values to the same size
  # as the other before performing the addition.

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun add(self, that: Self) -> Self {
    # The `add` method defines how to add two floating point values of the same
    # size together. It uses the `float_add` intrinsic function to perform the
    # addition, which computes the sum of the two values according to the rules
    # of floating point arithmetic.
    # @let that: The floating point value that is being added to the current
    #   value. It is of the same size as the current value.
    # @ret: The result of the addition operation, which is a new floating point
    #   value of the same size as the operands.

    # Hook into addition intrinsic.
    ret intrinsics::float_add(self, that)
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] ext AddAssign {
  # Provide addition assignment support to sized floating point numbers,
  # allowing for the addition of a floating point value to another floating
  # point value of the same size in place. For differing sizes, the `From` trait
  # can be used to convert the right-hand side value to the same size as the
  # left-hand side value before performing the addition assignment.

  !versioned(base="1.0.0", new="1.0.0")
  cmp fun add_assign(&mut self, that: Self) -> Void {
    # The `add_assign` method defines how to add a floating point value to
    # another floating point value of the same size in place. It uses the
    # `float_add_assign` intrinsic function to perform the addition assignment,
    # which computes the sum of the two values and updates the left-hand side
    # value with the result according to the rules of floating point arithmetic.
    # @let that: The floating point value that is being added to the current
    #   value. It is of the same size as the current value.
    # @ret: The method does not return a value, as the result of the addition
    #   assignment is stored directly in the left-hand side value.

    # Hook into addition assignment intrinsic.
    intrinsics::float_add_assign(self, that)
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] ext Sub {
  # Provide subtraction support to sized floating point numbers, allowing for
  # the subtraction of two floating point values of the same size. For differing
