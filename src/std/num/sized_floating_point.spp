  !versioned(base="1.0.0", new="1.0.0")
  fun pow(self, that: S32) -> Self {
    ret self.pow_ieee(that) * Self::one()
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] {
  !public !inline
  fun pow_checked(self, that: Self) -> Opt[Self] {
    let (val, raised) = self.pow_raised(that)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun pow_raised(self, that: Self) -> (Self, Bool) {
    let val = self.pow_ieee(that)
    ret (val, val.is_finite().not)
  }

  !public !inline
  fun pow_ieee(self, that: Self) -> Self {
    ret intrinsics::float_powf_ieee(self, that)
  }

  !public !inline
  fun pow_checked(self, that: S32) -> Opt[Self] {
    let (val, raised) = self.pow_raised(that)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun pow_raised(self, that: S32) -> (Self, Bool) {
    let val = self.pow_ieee(that)
    ret (val, val.is_finite().not)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun pow_ieee(self, that: S32) -> Self {
    let mut base = self
    let mut n = that
    let mut result = Self::one()
    loop true {
      case n.bit_and(1_s32) != 0_s32 { result = result.mul_ieee(base) }
      n = n / 2_s32
      case n == 0_s32 { exit }
      base = base.mul_ieee(base)
    }
    ret case that < 0_s32 { Self::one().div_ieee(result) } else { result }
  }
}

sup [cmp w: U32] SizedFloatingPoint[w] {
  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun ln(self) -> Self {
    # The natural logarithm (base e, `Consts[F64]::e`): the platform's `log`.
    ret intrinsics::float_log(self)
  }

  !public !inline
  fun ln_checked(self) -> Opt[Self] {
    let (val, raised) = self.ln_raised()
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun ln_raised(self) -> (Self, Bool) {
    let val = self.ln_ieee()
    ret (val, val.is_finite().not)
  }

  !public !inline
  fun ln_ieee(self) -> Self {
    # `ln` with no check.
    ret intrinsics::float_log_ieee(self)
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun log(self, base: Self) -> Self {
    # The logarithm in `base`, as `log2(x) / log2(base)`, so up to three
    # roundings: within a few ulps, not correctly rounded (nor are the other
    # transcendental functions, which come from the platform's libm, as IEEE 754
    # permits).
    ret intrinsics::float_log2(self) / intrinsics::float_log2(base)
  }

  !public !inline
  fun log_checked(self, base: Self) -> Opt[Self] {
    let (val, raised) = self.log_raised(base)
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun log_raised(self, base: Self) -> (Self, Bool) {
    let val = self.log_ieee(base)
    ret (val, val.is_finite().not)
  }

  !public !inline
  fun log_ieee(self, base: Self) -> Self {
    # `log(base)` with no check.
    ret intrinsics::float_log2_ieee(self).div_ieee(intrinsics::float_log2_ieee(base))
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun log2(self) -> Self {
    ret intrinsics::float_log2(self)
  }

  !public !inline
  fun log2_checked(self) -> Opt[Self] {
    let (val, raised) = self.log2_raised()
    ret case raised { None } else { Some(val) }
  }

  !public !inline
  fun log2_raised(self) -> (Self, Bool) {
    let val = self.log2_ieee()
    ret (val, val.is_finite().not)
  }

  !public !inline
  fun log2_ieee(self) -> Self {
    ret intrinsics::float_log2_ieee(self)
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
