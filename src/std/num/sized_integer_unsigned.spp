use std::annotations::intrinsic
use std::annotations::versioned
use std::llvm::always_inline
use std::llvm::inline
use std::format::Format
use std::format::Formatter
use std::io::StreamErr
use std::num::sized_floating_point::SizedFloatingPoint
use std::num::sized_integer::SizedInteger
use std::num::sized_integer_signed::SizedIntegerSigned
use std::ops::add::Add
use std::ops::add::AddAssign
use std::ops::bit_shr::BitShr
use std::ops::bit_shr::BitShrAssign
use std::ops::div::Div
use std::ops::div::DivAssign
use std::ops::mul::Mul
use std::ops::mul::MulAssign
use std::ops::ord::Ord
use std::ops::pow::Pow
use std::ops::rem::Rem
use std::ops::rem::RemAssign
use std::ops::sub::Sub
use std::ops::sub::SubAssign

!public
type SizedIntegerUnsigned[cmp w: U32] = SizedInteger[w, false]

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Add {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun add(self, that: Self) -> Self {
    ret intrinsics::uadd(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext AddAssign {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun add_assign(&mut self, that: Self) -> Void {
    intrinsics::uadd_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Sub {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun sub(self, that: Self) -> Self {
    ret intrinsics::usub(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext SubAssign {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun sub_assign(&mut self, that: Self) -> Void {
    intrinsics::usub_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Mul {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun mul(self, that: Self) -> Self {
    ret intrinsics::umul(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext MulAssign {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun mul_assign(&mut self, that: Self) -> Void {
    intrinsics::umul_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Div {
  cmp fun div(self, that: Self) -> Self {
    ret intrinsics::udiv(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext DivAssign[Rhs=Self] {
  cmp fun div_assign(&mut self, that: Self) -> Void {
    intrinsics::udiv_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Rem {
  cmp fun rem(self, that: Self) -> Self {
    ret intrinsics::urem(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext RemAssign[Rhs=Self] {
  cmp fun rem_assign(&mut self, that: Self) -> Void {
    intrinsics::urem_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext BitShr[Rhs=U32] {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_shr(self, that: U32) -> Self {
    # Logical: zeros are shifted in at the top.
    ret intrinsics::bit_shr(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext BitShrAssign[Rhs=U32] {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_shr_assign(&mut self, that: U32) -> Void {
    intrinsics::bit_shr_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun bit_shr_checked(self, that: U32) -> Opt[Self] {
    case that >= w { ret None }
    ret Some(val=intrinsics::bit_shr(self, that))
  }

  !public
  !inline
  fun bit_shr_overflow(self, that: U32) -> (Self, Bool) {
    ret (self.bit_shr_wrapping(that), that >= w)
  }

  !public
  !inline
  fun bit_shr_wrapping(self, that: U32) -> Self {
    ret intrinsics::bit_shr(self, that & (w - 1_u32))
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Pow[Rhs=U32, Ret=Self] {
  fun pow(self, that: U32) -> Self {
    # Square-and-multiply. The base is squared only while bits of the exponent
    # remain: the square after its last use can overflow when the power does not
    # (Hacker's Delight 2nd ed., figure 11-6).
    let mut out = Self::one()
    let mut base = self
    let mut exp = that
    loop exp > 0_u32 {
      case exp % 2_u32 == 1_u32 {
        out = out * base
      }
      exp /= 2_u32
      case exp > 0_u32 {
        base = base * base
      }
    }
    ret out
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Ord[Rhs=Self] {
  cmp fun ord(&self, that: &Self) -> S32 {
    ret intrinsics::ucmp(self, that)
  }

  cmp fun lt(&self, that: &Self) -> Bool {
    ret intrinsics::ult(self, that)
  }

  cmp fun le(&self, that: &Self) -> Bool {
    ret intrinsics::ule(self, that)
  }

  cmp fun gt(&self, that: &Self) -> Bool {
    ret intrinsics::ugt(self, that)
  }

  cmp fun ge(&self, that: &Self) -> Bool {
    ret intrinsics::uge(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  cmp fun min(self, that: Self) -> Self {
    ret intrinsics::umin(self, that)
  }

  !public
  !inline
  cmp fun max(self, that: Self) -> Self {
    ret intrinsics::umax(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun add_checked(self, that: Self) -> Opt[Self] {
    let (val, overflowed) = intrinsics::uadd_overflow(self, that)
    ret case overflowed { None } else { Some(val) }
  }

  !public
  !inline
  fun add_overflow(self, that: Self) -> (Self, Bool) {
    ret intrinsics::uadd_overflow(self, that)
  }

  !public
  !inline
  fun add_saturating(self, that: Self) -> Self {
    ret intrinsics::uadd_saturating(self, that)
  }

  !public
  !inline
  fun add_wrapping(self, that: Self) -> Self {
    ret intrinsics::uadd_wrapping(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun sub_checked(self, that: Self) -> Opt[Self] {
    ret case self of {
      < that { None }
      else { Some(val=intrinsics::usub_wrapping(self, that)) }
    }
  }

  !public
  !inline
  fun sub_overflow(self, that: Self) -> (Self, Bool) {
    ret intrinsics::usub_overflow(self, that)
  }

  !public
  !inline
  fun sub_saturating(self, that: Self) -> Self {
    ret intrinsics::usub_saturating(self, that)
  }

  !public
  !inline
  fun sub_wrapping(self, that: Self) -> Self {
    ret intrinsics::usub_wrapping(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun mul_checked(self, that: Self) -> Opt[Self] {
    let (val, overflowed) = intrinsics::umul_overflow(self, that)
    ret case overflowed { None } else { Some(val) }
  }

  !public
  !inline
  fun mul_overflow(self, that: Self) -> (Self, Bool) {
    ret intrinsics::umul_overflow(self, that)
  }

  !public
  !inline
  fun mul_saturating(self, that: Self) -> Self {
    ret case self.mul_checked(that) of {
      is Some[Self](val) { val }
      else { intrinsics::max_val[Self]() }
    }
  }

  !public
  !inline
  fun mul_wrapping(self, that: Self) -> Self {
    ret intrinsics::umul_wrapping(self, that)
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun div_checked(self, that: Self) -> Opt[Self] {
    ret case that of {
      == Self::zero() { None }
      else { Some(val=intrinsics::udiv(self, that)) }
    }
  }

  !public
  !inline
  fun div_overflow(self, that: Self) -> (Self, Bool) {
    ret (intrinsics::udiv(self, that), false)
  }

  !public
  !inline
  fun div_saturating(self, that: Self) -> Self {
    ret self.div_wrapping(that)
  }

  !public
  !inline
  fun div_wrapping(self, that: Self) -> Self {
    ret intrinsics::udiv(self, that)
  }

  !public
  !inline
  fun div_floor(self, that: Self) -> Self {
    ret intrinsics::udiv(self, that)
  }

  !public
  !inline
  fun div_ceil(self, that: Self) -> Self {
    let d = self / that
    let r = self % that
    ret case r > Self::zero() { d + Self::one() } else { d }
  }

  !public
  !inline
  fun mod(self, that: Self) -> Self {
    ret self % that
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun rem_checked(self, that: Self) -> Opt[Self] {
    case that == Self::zero() {
      ret None
    }
    ret Some(val=intrinsics::urem(self, that))
  }

  !public
  !inline
  fun rem_overflow(self, that: Self) -> (Self, Bool) {
    ret (intrinsics::urem(self, that), false)
  }

  !public
  !inline
  fun rem_wrapping(self, that: Self) -> Self {
    ret self.rem_overflow(that).0
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun pow_checked(self, that: U32) -> Opt[Self] {
    case that == 0_u32 {
      ret Some(val=Self::one())
    }
    let mut out = Self::one()
    let mut base = self
    let mut exp = that
    loop exp > 0_u32 {
      case exp % 2_u32 == 1_u32 {
        out = out.mul_checked(base)?
      }

      exp /= 2_u32
      case exp > 0_u32 {
        base = base.mul_checked(base)?
      }
    }
    ret Some(val=out)
  }

  !public
  !inline
  fun pow_overflow(self, that: U32) -> (Self, Bool) {
    # The wrapped power, as pow_wrapping, and whether any step overflowed. As in
    # pow, the base is squared only while bits of the exponent remain, so an
    # unused square cannot set the flag.
    let mut out = Self::one()
    let mut base = self
    let mut exp = that
    let mut any_overflowed = false
    loop exp > 0_u32 {
      case exp % 2_u32 == 1_u32 {
        let (product, overflowed) = out.mul_overflow(base)
        out = product
        any_overflowed = any_overflowed or overflowed
      }
      exp /= 2_u32
      case exp > 0_u32 {
        let (square, overflowed) = base.mul_overflow(base)
        base = square
        any_overflowed = any_overflowed or overflowed
      }
    }
    ret (out, any_overflowed)
  }

  !public
  !inline
  fun pow_wrapping(self, that: U32) -> Self {
    ret self.pow_overflow(that).0
  }

  !public
  !inline
  fun pow_saturating(self, that: U32) -> Self {
    ret case self.pow_checked(that) of {
      is Some[Self](val) { val }
      else { intrinsics::max_val[Self]() }
    }
  }

  !public
  !inline
  fun next_pow_of_two(self) -> Self {
    # The bit length of self - 1 is the exponent (Hacker's Delight 2nd ed.,
    # section 3-2, by leading zeros).
    case self <= Self::one() { ret Self::one() }
    let bits = w - (self - Self::one()).leading_zeros()
    case bits == w { std::abort::abort("next_pow_of_two: the next power of two does not fit") }
    ret Self::one() << bits
  }

  !public
  !inline
  fun is_pow_of_two(self) -> Bool {
    ret self.count_ones() == 1_u32
  }

  !public
  !inline
  fun prev_pow_of_two(self) -> Self {
    # The largest power of two at most self, by its bit length (Hacker's Delight
    # 2nd ed., section 3-2, "flp2"). Zero has none and is returned as it is, as
    # the book's is.
    case self.is_zero() { ret Self::zero() }
    ret Self::one() << (w - 1_u32 - self.leading_zeros())
  }

  !public
  !inline
  fun align_down(self, align: Self) -> Self {
    # The largest multiple of "align" at most self: the bits below the alignment
    # cleared (section 3-1). "align" has to be a power of two.
    case align.is_pow_of_two().not {
      std::abort::abort("align_down: the alignment must be a power of two") }
    ret self & (align - Self::one()).bit_not()
  }

  !public
  !inline
  fun align_up(self, align: Self) -> Self {
    # The smallest multiple of "align" at least self (section 3-1); it aborts
    # when that does not fit, as "+" does. The sum cannot overflow when the
    # answer fits: the answer is at most "align - 1" above self, and is a
    # multiple.
    case align.is_pow_of_two().not {
      std::abort::abort("align_up: the alignment must be a power of two") }
    let mask = align - Self::one()
    ret (self + mask) & mask.bit_not()
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun midpoint(self, that: Self) -> Self {
    # The average rounded down, without forming the sum that could overflow: the
    # bits the two share, plus half the bits they differ in (Hacker's Delight
    # 2nd ed., section 2-5).
    ret (self & that) + ((self ^ that) >> 1_u32)
  }

  !public
  !inline
  fun icbrt(self) -> Self {
    # The integer cube root, a bit of the root per three bits of the argument
    # (Hacker's Delight 2nd ed., figure 11-5). The book's "b << s" overflows
    # past 32 bits (its caution after the figure), so "x >> s" is compared with
    # "b" instead: the same test, as x >= b * 2^s exactly when x / 2^s, rounded
    # down, is at least b. Then b << s is at most x, so it fits.
    let mut x = self
    let mut y = Self::zero()
    let mut steps = (w - 1_u32) / 3_u32 + 1_u32
    loop steps > 0_u32 {
      steps -= 1_u32
      let s = steps * 3_u32
      y = y + y
      let b = Self::from(3_u8) * y * (y + Self::one()) + Self::one()
      case (x >> s) >= b {
        x -= b << s
        y += Self::one()
      }
    }
    ret y
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] {
  !public
  !inline
  fun isqrt(self) -> Self {
    # Every unsigned value has an integer square root, so there is nothing to
    # check (the signed side has isqrt_checked for negatives). The method is
    # picked by width (measured 2026-11-09, rel, arguments of every bit length):
    # bit by bit is ~13% faster at 32 bits, where Newton's divides cost more
    # than its fewer steps save; Newton's method is 2x faster at 64 bits and 6x
    # at 128, even with 128-bit division a library call.
    ret case w <= 32_u32 { self.isqrt_by_bits() } else { self.isqrt_by_newton() }
  }

  fun isqrt_by_newton(self) -> Self {
    # Newton's method from a first guess at least the root, the power of two
    # half the bit length of self - 1 up; the guesses then fall to the root and
    # stop falling there (Hacker's Delight 2nd ed., figure 11-1, seeded by
    # leading zeros). The first step's division by a power of two is a shift. No
    # sum overflows: each guess is at most 2^s.
    case self <= Self::one() { ret self }
    let s = (w - (self - Self::one()).leading_zeros() + 1_u32) / 2_u32
    let mut guess = Self::one() << s
    let mut next = (guess + (self >> s)) >> 1_u32
    loop next < guess {
      guess = next
      next = (guess + self / guess) >> 1_u32
    }
    ret guess
  }

  fun isqrt_by_bits(self) -> Self {
    # Bit by bit, as Hacker's Delight 2nd ed., figure 11-4.
    let mut n = self
    let mut result = Self::zero()
    let mut bit = Self::one() << (w - 2_u32)
    loop bit > n { bit >>= 2_u32 }

    loop bit != Self::zero() {
      case n >= result + bit {
        n -= result + bit
        result = (result >> 1_u32) + bit
      }
      else {
        result >>= 1_u32
      }
      bit >>= 2_u32
    }
    ret result
  }
}

sup [cmp w: U32] SizedIntegerUnsigned[w] ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format an unsigned integer in the spec's radix. The digits are written
    # backwards from the end of a buffer large enough for the widest integer in
    # binary.

    let spec = formatter.spec()
    let base = SizedIntegerUnsigned[w]::from(format::radix_of(spec.kind))
    let upper = spec.kind == b'X'
    let mut value = self@
    let mut buf = [0_u8; 264_uz]
    let mut pos = buf.len()

    case value.is_zero() {
      pos -= 1_uz
      buf[mut pos]@ = b'0'
    }

    loop value.is_zero().not {
      pos -= 1_uz
      buf[mut pos]@ = format::digit_byte(U8::from(value % base), upper)
      value /= base
    }

    let digits = Str::from_utf8_unchecked(&buf[pos to buf.len()])
    formatter.pad_integral(true, &digits)
    drop(digits)
    ret Pass[Void]()
  }
}
