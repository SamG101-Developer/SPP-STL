use std::annotations::intrinsic
use std::annotations::versioned
use std::llvm::always_inline
use std::llvm::inline
use std::format::Format
use std::format::Formatter
use std::io::StreamErr
use std::num::sized_floating_point::SizedFloatingPoint
use std::num::sized_integer::SizedInteger
use std::num::sized_integer_unsigned::SizedIntegerUnsigned
use std::ops::add::Add
use std::ops::add::AddAssign
use std::ops::bit_shr::BitShr
use std::ops::bit_shr::BitShrAssign
use std::ops::div::Div
use std::ops::div::DivAssign
use std::ops::mul::Mul
use std::ops::mul::MulAssign
use std::ops::ord::Ord
use std::ops::pow::Pow
use std::ops::rem::Rem
use std::ops::rem::RemAssign
use std::ops::sub::Sub
use std::ops::sub::SubAssign

!public
type SizedIntegerSigned[cmp w: U32] = SizedInteger[w, true]

sup [cmp w: U32] SizedIntegerSigned[w] ext Add {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun add(self, that: Self) -> Self {
    ret intrinsics::sadd(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext AddAssign {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun add_assign(&mut self, that: Self) -> Void {
    intrinsics::sadd_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext Sub {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun sub(self, that: Self) -> Self {
    ret intrinsics::ssub(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext SubAssign {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun sub_assign(&mut self, that: Self) -> Void {
    intrinsics::ssub_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext Mul {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun mul(self, that: Self) -> Self {
    ret intrinsics::smul(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext MulAssign {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun mul_assign(&mut self, that: Self) -> Void {
    intrinsics::smul_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext Div {
  cmp fun div(self, that: Self) -> Self {
    ret intrinsics::sdiv(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext DivAssign {
  cmp fun div_assign(&mut self, that: Self) -> Void {
    intrinsics::sdiv_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext Rem {
  cmp fun rem(self, that: Self) -> Self {
    ret intrinsics::srem(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext RemAssign {
  cmp fun rem_assign(&mut self, that: Self) -> Void {
    intrinsics::srem_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext BitShr[Rhs=U32] {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_shr(self, that: U32) -> Self {
    # Arithmetic: the sign bit is copied in, so a negative value stays negative
    # (-8 >> 1 is -4), as in C and Rust.
    ret intrinsics::bit_ashr(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext BitShrAssign[Rhs=U32] {
  !always_inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_shr_assign(&mut self, that: U32) -> Void {
    intrinsics::bit_ashr_assign(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun bit_shr_checked(self, that: U32) -> Opt[Self] {
    case that >= w { ret None }
    ret Some(val=intrinsics::bit_ashr(self, that))
  }

  !public
  !inline
  fun bit_shr_overflow(self, that: U32) -> (Self, Bool) {
    ret (self.bit_shr_wrapping(that), that >= w)
  }

  !public
  !inline
  fun bit_shr_wrapping(self, that: U32) -> Self {
    ret intrinsics::bit_ashr(self, that & (w - 1_u32))
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext Pow[Rhs=U32, Ret=Self] {
  fun pow(self, that: U32) -> Self {
    # Square-and-multiply. The base is squared only while bits of the exponent
    # remain: the square after its last use can overflow when the power does not
    # (Hacker's Delight 2nd ed., figure 11-6).
    let mut out = Self::one()
    let mut base = self
    let mut exp = that
    loop exp > 0_u32 {
      case exp % 2_u32 == 1_u32 {
        out = out * base
      }
      exp /= 2_u32
      case exp > 0_u32 {
        base = base * base
      }
    }
    ret out
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext Ord {
  cmp fun ord(&self, that: &Self) -> S32 {
    ret intrinsics::scmp(self, that)
  }

  cmp fun lt(&self, that: &Self) -> Bool {
    ret intrinsics::slt(self, that)
  }

  cmp fun le(&self, that: &Self) -> Bool {
    ret intrinsics::sle(self, that)
  }

  cmp fun gt(&self, that: &Self) -> Bool {
    ret intrinsics::sgt(self, that)
  }

  cmp fun ge(&self, that: &Self) -> Bool {
    ret intrinsics::sge(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  cmp fun min(self, that: Self) -> Self {
    ret intrinsics::smin(self, that)
  }

  !public
  !inline
  cmp fun max(self, that: Self) -> Self {
    ret intrinsics::smax(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun add_checked(self, that: Self) -> Opt[Self] {
    let (val, overflowed) = intrinsics::sadd_overflow(self, that)
    ret case overflowed { None } else { Some(val) }
  }

  !public
  !inline
  fun add_overflow(self, that: Self) -> (Self, Bool) {
    ret intrinsics::sadd_overflow(self, that)
  }

  !public
  !inline
  fun add_saturating(self, that: Self) -> Self {
    ret intrinsics::sadd_saturating(self, that)
  }

  !public
  !inline
  fun add_wrapping(self, that: Self) -> Self {
    ret intrinsics::sadd_wrapping(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun sub_checked(self, that: Self) -> Opt[Self] {
    let (val, overflowed) = intrinsics::ssub_overflow(self, that)
    ret case overflowed { None } else { Some(val) }
  }

  !public
  !inline
  fun sub_overflow(self, that: Self) -> (Self, Bool) {
    ret intrinsics::ssub_overflow(self, that)
  }

  !public
  !inline
  fun sub_saturating(self, that: Self) -> Self {
    ret intrinsics::ssub_saturating(self, that)
  }

  !public
  !inline
  fun sub_wrapping(self, that: Self) -> Self {
    ret intrinsics::ssub_wrapping(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun mul_checked(self, that: Self) -> Opt[Self] {
    let (val, overflowed) = intrinsics::smul_overflow(self, that)
    ret case overflowed { None } else { Some(val) }
  }

  !public
  !inline
  fun mul_overflow(self, that: Self) -> (Self, Bool) {
    ret intrinsics::smul_overflow(self, that)
  }

  !public
  !inline
  fun mul_saturating(self, that: Self) -> Self {
    ret case self.mul_checked(that) of {
      is Some[Self](val) { val }
      is None() and (self < Self::zero()) == (that < Self::zero()) { intrinsics::max_val[Self]() }
      else { intrinsics::min_val[Self]() }
    }
  }

  !public
  !inline
  fun mul_wrapping(self, that: Self) -> Self {
    ret intrinsics::smul_wrapping(self, that)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun div_checked(self, that: Self) -> Opt[Self] {
    case that == Self::zero() or (self == intrinsics::min_val[Self]() & that == Self::neg_one()) {
      ret None
    }
    ret Some(val=intrinsics::sdiv(self, that))
  }

  !public
  !inline
  fun div_overflow(self, that: Self) -> (Self, Bool) {
    ret case self == intrinsics::min_val[Self]() & that == Self::neg_one() {
      (self, true)
    }
    else {
      (intrinsics::sdiv(self, that), false)
    }
  }

  !public
  !inline
  fun div_saturating(self, that: Self) -> Self {
    let out = self.div_overflow(that)
    ret case out of {
      is (val, true) { intrinsics::max_val[Self]() }
      else { out.0 }
    }
  }

  !public
  !inline
  fun div_wrapping(self, that: Self) -> Self {
    ret self.div_overflow(that).0
  }

  !public
  !inline
  fun div_floor(self, that: Self) -> Self {
    # "/" truncates toward zero, so an inexact quotient is one too high when the
    # signs differ. "c" is 1 exactly then: the sign bit of self ^ that, by a
    # logical shift (Hacker's Delight 2nd ed., exercise 9.3, which leaves out
    # the "r != 0" test that an exact division needs).
    let d = self / that
    let r = self % that
    let c = intrinsics::bit_shr(self ^ that, w - 1_u32)
    ret case r != Self::zero() { d - c } else { d }
  }

  !public
  !inline
  fun div_ceil(self, that: Self) -> Self {
    # An inexact truncated quotient is one too low when the signs match, and
    # already the ceiling when they differ.
    let d = self / that
    let r = self % that
    let c = intrinsics::bit_shr(self ^ that, w - 1_u32)
    ret case r != Self::zero() { d + (Self::one() - c) } else { d }
  }

  !public
  !inline
  fun mod(self, that: Self) -> Self {
    let r = self % that
    ret case r < Self::zero() { r.add_wrapping(that.abs_wrapping()) } else { r }
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun rem_checked(self, that: Self) -> Opt[Self] {
    # Every integer divides by -1 exactly, so its remainder is 0. That includes
    # the minimum, whose quotient overflows but whose remainder fits; it is
    # answered here because "srem" is undefined for it.
    case that == Self::zero() { ret None }
    case that == Self::neg_one() { ret Some(val=Self::zero()) }
    ret Some(val=intrinsics::srem(self, that))
  }

  !public
  !inline
  fun rem_overflow(self, that: Self) -> (Self, Bool) {
    # A remainder never overflows: by -1 it is 0, the minimum included (see
    # rem_checked).
    case that == Self::neg_one() {
      ret (Self::zero(), false)
    }
    ret (intrinsics::srem(self, that), false)
  }

  !public
  !inline
  fun rem_wrapping(self, that: Self) -> Self {
    ret self.rem_overflow(that).0
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun pow_checked(self, that: U32) -> Opt[Self] {
    case that == 0_u32 {
      ret Some(val=Self::one())
    }
    let mut out = Self::one()
    let mut base = self
    let mut exp = that
    loop exp > 0_u32 {
      case exp % 2_u32 == 1_u32 {
        out = out.mul_checked(base)?
      }

      exp /= 2_u32
      case exp > 0_u32 {
        base = base.mul_checked(base)?
      }
    }
    ret Some(val=out)
  }

  !public
  !inline
  fun pow_overflow(self, that: U32) -> (Self, Bool) {
    # The wrapped power, as pow_wrapping, and whether any step overflowed. As in
    # pow, the base is squared only while bits of the exponent remain, so an
    # unused square cannot set the flag.
    let mut out = Self::one()
    let mut base = self
    let mut exp = that
    let mut any_overflowed = false
    loop exp > 0_u32 {
      case exp % 2_u32 == 1_u32 {
        let (product, overflowed) = out.mul_overflow(base)
        out = product
        any_overflowed = any_overflowed or overflowed
      }
      exp /= 2_u32
      case exp > 0_u32 {
        let (square, overflowed) = base.mul_overflow(base)
        base = square
        any_overflowed = any_overflowed or overflowed
      }
    }
    ret (out, any_overflowed)
  }

  !public
  !inline
  fun pow_wrapping(self, that: U32) -> Self {
    ret self.pow_overflow(that).0
  }

  !public
  !inline
  fun pow_saturating(self, that: U32) -> Self {
    ret case self.pow_checked(that) of {
      is Some[Self](val) { val }
      is None() and (self < Self::zero()) and (that % 2_u32 == 1_u32) { intrinsics::min_val[Self]() }
      else { intrinsics::max_val[Self]() }
    }
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  !intrinsic(name="std.num.sized_integer_signed.SizedIntegerSigned.neg_one")
  cmp fun neg_one() -> Self { }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun is_positive(self) -> Bool {
    ret self > Self::zero()
  }

  !public
  !inline
  fun is_negative(self) -> Bool {
    ret self < Self::zero()
  }

  !public
  !inline
  fun abs(self) -> Self {
    ret case self < Self::zero() { self.neg() } else { self }
  }

  !public
  !inline
  fun abs_checked(self) -> Opt[Self] {
    ret case self.is_negative() { self.neg_checked() } else { Some(val=self) }
  }

  !public
  !inline
  fun abs_wrapping(self) -> Self {
    ret case self.is_negative() { self.neg_wrapping() } else { self }
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  cmp fun neg(self) -> Self {
    ret intrinsics::sneg(self)
  }

  !public
  !inline
  fun neg_checked(self) -> Opt[Self] {
    let (val, overflowed) = self.neg_overflow()
    ret case overflowed { None } else { Some(val) }
  }

  !public
  !inline
  fun neg_overflow(self) -> (Self, Bool) {
    case self == intrinsics::min_val[Self]() {
      ret (intrinsics::min_val[Self](), true)
    }
    ret (intrinsics::sneg(self), false)
  }

  !public
  !inline
  fun neg_wrapping(self) -> Self {
    ret Self::zero().sub_wrapping(self)
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun isqrt(self) -> Self {
    case self.isqrt_checked() is Some[Self](val) {
      ret val
    }
    std::abort::abort("iroot: input must be a non-negative integer")
  }

  !public
  !inline
  fun isqrt_checked(self) -> Opt[Self] {
    # A non-negative value is its own magnitude, so the unsigned root (which
    # picks its method by width) is the answer, and it fits back.
    case self < Self::zero() { ret None }
    ret Some(val=Self::from(SizedIntegerUnsigned[w]::from(self).isqrt()))
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] {
  !public
  !inline
  fun midpoint(self, that: Self) -> Self {
    # The average rounded toward zero, as "/" rounds, without forming the sum
    # that could overflow. The shared bits plus half the differing ones (">>" is
    # arithmetic) is the average rounded down; that is one low exactly when the
    # sum is negative and odd, so the sign bit of it, and the low bit of the
    # differing ones, add the one back (Hacker's Delight 2nd ed., section 2-5).
    let floor = (self & that) + ((self ^ that) >> 1_u32)
    ret floor + (intrinsics::bit_shr(floor, w - 1_u32) & (self ^ that))
  }

  !public
  !inline
  fun icbrt(self) -> Self {
    # The integer cube root rounded toward zero: a negative's is the negation of
    # its magnitude's. The magnitude is read unsigned, so the minimum's fits.
    let negative = self < Self::zero()
    let bits = SizedIntegerUnsigned[w]::from(self)
    let magnitude = case negative { SizedIntegerUnsigned[w]::zero().sub_wrapping(bits) } else { bits }
    let root = Self::from(magnitude.icbrt())
    ret case negative { root.neg() } else { root }
  }
}

sup [cmp w: U32] SizedIntegerSigned[w] ext Format {
  !versioned(base="1.0.0", new="1.0.0")
  fun fmt(&self, formatter: &mut Formatter) -> Res[Void, StreamErr] {
    # Format a signed integer in the spec's radix, as a sign and a magnitude:
    # `{:x}` of -255 is `-ff`, not the two's complement bits. The digits are
    # taken on the negative side, as in `Str::from`: the most negative value of
    # a width has no positive counterpart, but every remainder of a negative
    # value negates in range.

    let spec = formatter.spec()
    let base = SizedIntegerSigned[w]::from(format::radix_of(spec.kind))
    let upper = spec.kind == b'X'
    let mut value = self@
    let non_negative = value.is_negative().not
    let mut buf = [0_u8; 264_uz]
    let mut pos = buf.len()

    case value.is_zero() {
      pos -= 1_uz
      buf[mut pos]@ = b'0'
    }

    # Force the value negative so one loop covers both signs.
    case non_negative { value = value.neg() }

    loop value.is_zero().not {
      pos -= 1_uz
      buf[mut pos]@ = format::digit_byte(U8::from((value % base).neg()), upper)
      value /= base
    }

    let digits = Str::from_utf8_unchecked(&buf[pos to buf.len()])
    formatter.pad_integral(non_negative, &digits)
    drop(digits)
    ret Pass[Void]()
  }
}
