use std::annotations::public
use std::annotations::versioned
use std::copy::Copy
use std::generator::Gen
use std::num::bases::One
use std::number::USize
use std::ops::add::AddAssign
use std::ops::ord::Ord

!public
!versioned(base="1.0.0", new="1.0.0")
cls Range[T: Ord] {
    # The `Range` class is the generator produced when walking between two values of an orderable type `T`. It holds no
    # fields of its own: like `Iterator`, a `Range` only ever comes out of a coroutine, and the value handed back is
    # that coroutine's suspended state rather than a record of the bounds. Building one with an object initializer
    # would produce a generator with nothing behind it to resume, which is why the constructors below are coroutines.
    # @type T: An orderable type that represents the elements in the range.
}

sup [T: Ord] Range[T] ext Gen[T] {
    # In order to iterate a range, we need to implement the `Gen` interface for the `Range` class. This allows us to
    # generate a sequence of values from the range, starting from the `start` value and ending before the `end` value,
    # incrementing by the specified `step` size.
}

sup [T: Ord & One & AddAssign & Copy] Range[T] {
    # The constructor of a range, a coroutine rather than a function: a `Range` is a generator, so what it returns is
    # the suspended coroutine that yields the values, and resuming it is what walks the range.
    #
    # This block carries the arithmetic bounds, because building a range from its endpoints is the only part that has
    # to compute the next value. The adaptors below get their own block with only `Ord`, so a type that can be ordered
    # but not incremented can still be stepped through once something else has produced the range.
    #
    # The bound is `AddAssign` rather than `Add`: `add(self, that: Rhs) -> Ret` names `Ret` only in its return type, so
    # a call on a generic receiver has nothing to infer it from, whereas `add_assign(&mut self, that: Rhs) -> Void`
    # takes its only parameter from the argument.

    !public
    !versioned(base="1.0.0", new="1.0.0")
    cor between(start: T, end: T) -> Range[T] {
        # Yields every value from `start` up to but not including `end`, advancing by one each time. This is the common
        # case of walking an interval, and is what `loop x in Range[T]::between(a, b)` iterates over.
        # @let start: The starting value of the range, which is inclusive. It represents the first value in the range.
        # @let end: The ending value of the range, which is exclusive. It represents the value at which the range stops
        # generating.
        # @ret: A generator yielding each value of the interval in turn.

        let mut current = start
        loop current < end {
            gen current
            current += T::one()
        }
    }
}

sup [T: Ord] Range[T] {
    # The adaptors of a range: coroutines that consume a range and yield a subset of it. They mirror the equivalents on
    # `Iterator`, and like those they count in `USize` rather than doing arithmetic on `T`, so they need no bound
    # beyond the `Ord` the class itself declares.

    !public
    !versioned(base="1.0.0", new="1.0.0")
    cor step_by(self, step: USize) -> Range[T] {
        # Yields every `step`-th value of this range, discarding the ones in between, so that
        # `Range[S32]::between(0, 100).step_by(5)` walks `0, 5, 10, ...`. The range is consumed: this resumes it and
        # re-yields the values that land on a multiple of the step.
        # @let step: How many of the range's values to advance by between yields. A step of 1 yields every value.
        # @ret: A generator yielding every `step`-th value of this range.

        let mut index = 0_uz
        loop value in self {
            case index % step == 0_uz { gen value }
            index += 1_uz
        }
    }
}