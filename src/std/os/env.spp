use std::annotations::versioned
use std::fs::path::Path
use std::fs::path::PathErr
use std::fs::path::path_max
use std::os::os_string::OsStr
use std::range::Range

# The process's environment as the operating system has it: its variables, its
# arguments and its working directory. Values come back as `OsStr`, since the
# system does not promise they are UTF-8 (see `OsStr`).

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls EnvInvalidKeyErr {
  # The `EnvInvalidKeyErr` class represents an error that occurs when an invalid
  # key is provided for environment variable operations. This error is typically
  # raised when the key does not conform to the expected format for environment
  # variable names, such as containing invalid characters or being empty.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls EnvOomErr {
  # The `EnvOomError` class represents an error that occurs when the system runs
  # out of memory while trying to set an environment variable. This error is
  # typically raised when there is insufficient memory available to allocate for
  # the new environment variable or its value.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls EnvOtherErr {
  # The `EnvOtherErr` class represents a generic error that can occur during
  # environment variable operations that do not fall into the specific
  # categories of `EnvInvalidKeyErr` or `EnvOomErr`.
}

!public
!versioned(base="1.0.0", new="1.0.0")
type EnvErr = EnvInvalidKeyErr or EnvOomErr or EnvOtherErr

sup EnvErr {
  fun from_errno(errno: S32) -> Self {
    # The `from_errno` function is a static method that takes an error number
    # (`errno`) as input and returns an instance of the appropriate error class
    # based on the value of `errno`. It uses a `case` statement to match the
    # `errno` value against known error codes for invalid keys and out-of-memory
    # conditions.
    # @let errno: The error number (errno) that indicates the type of error that
    #   occurred during an environment variable operation.
    # @ret: An instance of `EnvErr` that corresponds to the provided `errno`.

    ret case errno of {
      == sppc::einval { EnvInvalidKeyErr }
      == sppc::enomem { EnvOomErr }
      else { EnvOtherErr }
    }
  }
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun get_env(key: &StrView) -> Opt[OsStr] {
  # The `get_env` function retrieves the value of an environment variable
  # specified by the `key` parameter, as the operating system has it.
  # @let key: The name of the environment variable to retrieve.
  # @ret: An `Opt` type containing the value of the environment variable if it
  #   is set, or `None` if it is not set.

  # Null terminate the string for C safety.
  let key_z = key.to_c_str()
  defer drop(key_z)

  # The value's length first, so the buffer fits it and its terminator exactly,
  # however long it is. A variable that is not set has no length.
  let mut length = 0_uz
  let found = sppc::getenv_len(key_z.ptr().as_c_ref(), &mut length)
  case found != 0 { ret None }

  let size = length + 1_uz
  let mut buffer = OsStr::new_with_capacity(size)
  defer drop(buffer)

  # The value could change between the two calls, from another thread; it is
  # then reported as not set, rather than cut short.
  let err = sppc::getenv(key_z.ptr().as_c_ref(), buffer.ptr().as_c_mut(), size)
  case err != 0 { ret None }
  ret Some(val=OsStr::from_c_str(buffer.ptr()))
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun set_env(var_key: &StrView, var_val: &OsStr, overwrite: Bool = true) -> Bool {
  # The `set_env` function sets the value of an environment variable specified
  # by the `var_key` parameter to the value provided in the `var_val` parameter.
  # The `overwrite` parameter determines whether to overwrite the existing value
  # of the environment variable if it is already set.
  # @let var_key: The name of the environment variable to set.
  # @let var_val: The value to assign to the environment variable.
  # @let ?overwrite: Whether to replace a value that is already set. Defaults
  #   to `true`.
  # @ret: Whether the environment variable was set.

  # Null terminate both for C, as a view is not: passed as it is, C would read
  # past its end, and set a variable under a name that runs on into whatever
  # follows.
  let key_z = var_key.to_c_str()
  defer drop(key_z)
  let val_z = var_val.to_c_str()
  defer drop(val_z)

  let err = sppc::setenv(
    key_z.ptr().as_c_ref(), val_z.ptr().as_c_ref(), overwrite)
  ret err == 0
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun set_env(var_key: &StrView, var_val: &StrView, overwrite: Bool = true) -> Bool {
  # The `set_env` function, for a value that is text: as the `OsStr` one.
  # @let var_key: The name of the environment variable to set.
  # @let var_val: The value to assign to the environment variable.
  # @let ?overwrite: Whether to replace a value that is already set. Defaults
  #   to `true`.
  # @ret: Whether the environment variable was set.

  let value = OsStr::from(var_val)
  defer drop(value)
  ret set_env(var_key, &value, overwrite)
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun unset_env(var_key: &StrView) -> Bool {
  # The `unset_env` function removes an environment variable specified by the
  # `var_key` parameter. A variable that is not set is no error.
  # @let var_key: The name of the environment variable to remove.
  # @ret: Whether the variable is now not set.

  # Null terminate the name for C, as "set_env" does.
  let key_z = var_key.to_c_str()
  defer drop(key_z)

  let result = sppc::unsetenv(key_z.ptr().as_c_ref())
  ret result == 0
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun args() -> Vec[OsStr] {
  # The `args` function returns the arguments the program was started with, the
  # program itself first, as Rust's `std::env::args_os` does: `main` takes none.
  # Each is copied whole, as the operating system gave it.
  # @ret: A `Vec` of the arguments, in order, the program's own name first.

  let count = sppc::arg_count()
  let mut out = Vec[OsStr]::new_with_capacity(count)
  loop i in Range[USize]::between(0_uz, count) {
    # Each argument's length first, so its buffer fits it exactly. They are
    # fixed for the life of the process, so neither call can fail for an index
    # below the count.
    let mut length = 0_uz
    let sized = sppc::arg_len(i, &mut length)
    let size = length + 1_uz
    let mut buffer = OsStr::new_with_capacity(size)
    let err = sppc::arg(i, buffer.ptr().as_c_mut(), size)
    out.append(OsStr::from_c_str(buffer.ptr()))
    drop(buffer)
  }
  ret out
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun get_cwd() -> Res[Path, PathErr] {
  # The `get_cwd` function retrieves the current working directory.
  # @ret: The current directory's `Path`, or the error that stopped it.

  # getcwd writes a terminated name into the room it is given; the path is what
  # comes before the terminator.
  let mut buffer = OsStr::new_with_capacity(path_max)
  defer drop(buffer)
  let err = sppc::getcwd(buffer.ptr().as_c_mut(), path_max)
  ret case err == 0 { Pass(val=Path(inner=OsStr::from_c_str(buffer.ptr()))) } else {
    Fail(err=PathErr::from_errno(err))
  }
}

!public
!versioned(base="1.0.0", new="1.0.0")
fun set_cwd(path: &Path) -> Res[Void, PathErr] {
  # The `set_cwd` function changes the current working directory to the
  # specified path.
  # @let path: The new current working directory.
  # @ret: Nothing on success, or the error that stopped it.

  let path_z = path.inner.to_c_str()
  let err = sppc::chdir(path_z.ptr().as_c_ref())
  drop(path_z)
  ret case err == 0 { Pass[Void]() } else { Fail(err=PathErr::from_errno(err)) }
}
