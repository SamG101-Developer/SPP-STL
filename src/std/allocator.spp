use std::annotations::intrinsic
use std::annotations::versioned
use std::llvm::inline
use std::clone::Clone
use std::mem::pointer::NonNull
use std::mem::pointer::NullptrErr

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls AllocOomErr {
  # The `AllocOomErr` type represents an out-of-memory error that can occur
  # during memory allocation. This type is used to indicate that the system has
  # run out of memory and cannot fulfill the allocation request. Mapped from the
  # ENOMEM error code in C.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls AllocOverflowErr {
  # The `AllocOverflowErr` type represents an error that can occur when there is
  # valid resources available to allocate, but the requested memory layout
  # exceeds the maximum supported capacity for the target platform. This type is
  # used to indicate that the requested allocation size is too large to be
  # handled by the allocator, even if there is technically enough memory
  # available. Mapped from the EOVERFLOW error code in C.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls AllocAlignmentErr {
  # The `AllocAlignmentErr` type represents an error that can occur when the
  # requested memory layout has invalid alignment requirements. This type is
  # used to indicate that the specified alignment is not a power of two, or is
  # greater than the maximum supported alignment for the target platform. Mapped
  # from the EINVAL error code in C.
}

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls AllocOtherErr {
  # The `AllocOtherErr` type represents any other kind of error that can occur
  # during memory allocation that does not fit into the specific categories of
  # out-of-memory, capacity overflow, or invalid alignment. This type is used as
  # a catch-all for any unexpected errors that may arise during allocation.
}

!public
!versioned(base="1.0.0", new="1.0.0")
type AllocErr = AllocOomErr
  or AllocAlignmentErr
  or AllocOverflowErr
  or AllocOtherErr

sup AllocErr {
  fun from_errno(errno: S32) -> Self {
    #
    # @let errno:
    # @ret:

    ret case errno of {
      == sppc::enomem { AllocOomErr }
      == sppc::eoverflow { AllocOverflowErr }
      == sppc::einval { AllocAlignmentErr }
      else { AllocOtherErr }
    }
  }
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls Layout {
  # The `Layout` type is a simple data structure that encapsulates the size and
  # alignment requirements for a block of memory. It is used as an argument in
  # the allocation methods of the `Alloc` type, to specify how much memory is
  # needed and how it should be aligned.
  # @let size: The number of bytes needed for the allocation.
  # @let align: The alignment requirement for the allocation, which must be a
  #   power of two and less than or equal to the maximum supported alignment for
  #   the target platform.

  !public size: USize
  !public align: USize
}

sup Layout ext Copy {
  # The `Layout` type implements the `Copy` trait, which means that it can be
  # duplicated by simply copying its bits. This allows for efficient passing of
  # `Layout` values by value, without needing to worry about ownership or
  # borrowing.
}

sup Layout {
  !public !inline
  fun array[T](n: USize) -> Self {
    # The `Layout` for `n` contiguous values of type `T`: `n` times the size of
    # `T`, aligned for `T`. Aborts if the size overflows the address space, so
    # no allocator is ever asked for a wrapped-around size.
    # @type T: The element type.
    # @let n: The number of elements.
    # @ret: A `Layout` for an array of `n` values of type `T`.

    let elem = std::mem::ops::size_of[T]()
    let overflows = case elem == 0_uz { false } else { n > std::limits::Limits[USize]::max / elem }
    case overflows {
      std::abort::abort("allocation layout overflows the address space")
    }

    let size = elem * n
    let align = std::mem::ops::align_of[T]()
    ret Self(size, align)
  }
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls Alloc {
  # The interface every allocator implements and every container allocates
  # through. It has two sides, split by who uses them rather than mirrored:
  #
  # - An allocator author implements the `!protected` byte methods, in bytes and
  # `Layout`s, because that is what a c allocator speaks: `alloc_bytes` and
  # `free_bytes` are required; `alloc_bytes_zeroed` and `realloc_bytes` have
  # working defaults and exist to be overridden for speed (`calloc`'s pre-zeroed
  # pages, `realloc` growing in place).
  # - Everyone else calls the public typed methods, in types and element counts:
  # `allocate`, `allocate_zeroed`, `deallocate` and `reallocate`. They are the
  # only place the pointer retypings live - `cast` after every allocation,
  # `erase_type` before every free - so a container never retypes a pointer and
  # an allocator never sees a typed one.
}

sup Alloc {
  !protected !abstract_method
  !versioned(base="1.0.0", new="1.0.0")
  fun alloc_bytes(&self, layout: Layout) -> Res[NonNull[U8], AllocErr] {
    # Allocate an uninitialized block of `layout.size` bytes, aligned to
    # `layout.align`.
    # @let layout: The size and alignment of the block.
    # @ret: A byte pointer to the block, or an `AllocErr` if it could not be
    #   allocated.
  }

  !protected !abstract_method
  !versioned(base="1.0.0", new="1.0.0")
  fun free_bytes(&self, ptr: NonNull[U8], layout: Layout) -> Void {
    # Free a block this allocator returned. Passing the layout back mirrors the
    # c sized-free convention, so an allocator that buckets by size needs no
    # per-block metadata; one that does not, like `GlobalAlloc`, ignores it.
    # Never fails.
    # @let ptr: The block to free. Ownership passes to the allocator; it must
    #   not be used again.
    # @let layout: The `Layout` the block was allocated or last reallocated
    #   with.
  }

  !protected !virtual_method
  !versioned(base="1.0.0", new="1.0.0")
  fun alloc_bytes_zeroed(&self, layout: Layout) -> Res[NonNull[U8], AllocErr] {
    # Allocate a block of `layout.size` bytes, all zero. The default allocates
    # and then zeroes; override it when the allocator can hand out memory that
    # is already zero (`calloc`).
    # @let layout: The size and alignment of the block.
    # @ret: A byte pointer to the zeroed block, or an `AllocErr` if it could not
    #   be allocated.

    let mut ptr = self.alloc_bytes(layout)?
    std::mem::ops::mem_set(&mut ptr, 0_u8, layout.size)
    ret Pass(val=ptr)
  }

  !protected !virtual_method
  !versioned(base="1.0.0", new="1.0.0")
  fun realloc_bytes(
    &self, ptr: NonNull[U8], old_layout: Layout, new_layout: Layout)
  -> Res[NonNull[U8], AllocErr] {
    # Resize a block, larger or smaller, keeping its first `min(old, new)`
    # bytes; any added tail is uninitialized. The default allocates a new block,
    # copies, and frees the old one; override it when the allocator can resize
    # in place (`realloc`). On failure the old block is untouched and still
    # owned by the caller.
    # @let ptr: The block to resize.
    # @let old_layout: The `Layout` the block currently has.
    # @let new_layout: The `Layout` to resize it to.
    # @ret: A byte pointer to the resized block, which may have moved, or an
    #   `AllocErr` on failure.

    let mut new_ptr = self.alloc_bytes(new_layout)?
    let kept = case old_layout.size < new_layout.size {
      old_layout.size } else { new_layout.size }
    std::mem::ops::mem_copy(&mut new_ptr, &ptr, kept)
    self.free_bytes(ptr, old_layout)
    ret Pass(val=new_ptr)
  }
}

sup Alloc {
  # The typed side, for containers and other callers. Not overridable: each
  # method sizes the request with `Layout::array` and retypes the pointer around
  # one byte method. The reallocating method writes the result back into the
  # caller's slot; `NonNull` is `Copy`, so erasing the pointer to pass it leaves
  # the slot intact, and on failure it still holds the original, valid pointer.

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun allocate[T](&self, n: USize = 1_uz) -> Res[NonNull[T], AllocErr] {
    # Allocate uninitialized storage for `n` values of type `T`: one value by
    # default, as `Single`, `Rc` and `Arc` use, or an array, as `RawBuf` uses to
    # back `Vec` and `Str`.
    # @type T: The element type.
    # @let ?n: The number of values to allocate storage for.
    # @ret: A pointer to the first value's storage, or an `AllocErr` if it could
    #   not be allocated.

    let ptr = self.alloc_bytes(Layout::array[T](n))?
    ret Pass(val=ptr.cast[T]())
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun allocate_zeroed[T](&self, n: USize = 1_uz) -> Res[NonNull[T], AllocErr] {
    # The same as `allocate`, with every byte zero. That is only a valid `T` if
    # `T` treats all-zero bits as a value, so the elements must otherwise still
    # be written before they are read.
    # @type T: The element type.
    # @let ?n: The number of values to allocate storage for.
    # @ret: A pointer to the first value's zeroed storage, or an `AllocErr` if
    #   it could not be allocated.

    let ptr = self.alloc_bytes_zeroed(Layout::array[T](n))?
    ret Pass(val=ptr.cast[T]())
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun deallocate[T](&self, ptr: NonNull[T], n: USize = 1_uz) -> Void {
    # Free storage that `allocate[T](n)` or `reallocate` returned. The values in
    # it are not dropped; the caller must have dropped them already.
    # @type T: The element type.
    # @let ptr: The pointer to free. It must not be used again.
    # @let ?n: The number of values the storage was sized for, as passed to
    #   `allocate` or `reallocate`.

    self.free_bytes(ptr.erase_type(), Layout::array[T](n))
  }

  !public !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun reallocate[T](&self, ptr: &mut NonNull[T], old_n: USize, new_n: USize)
  -> Res[Void, AllocErr] {
    # Resize storage from `old_n` to `new_n` values, updating `ptr` in place.
    # The first `min(old_n, new_n)` values are kept; values above `new_n` are
    # discarded without being dropped, and any added ones are uninitialized. On
    # failure `ptr` is unchanged and still valid.
    # @type T: The element type.
    # @let ptr: The pointer to resize, updated on success.
    # @let old_n: The number of values the storage is sized for now.
    # @let new_n: The number of values to resize it to.
    # @ret: `Pass()` if the storage was resized, or an `AllocErr` on failure.

    let new_byte = self.realloc_bytes(
      ptr@.erase_type(), Layout::array[T](old_n), Layout::array[T](new_n))?
    ptr@ = new_byte.cast[T]()
    ret Pass[Void]()
  }
}

!public !zero_type
cls GlobalAlloc {
  # The default allocator for every std container and smart pointer: c's
  # `malloc`, `calloc`, `realloc` and `free`, through the sppc bindings.
}

sup GlobalAlloc ext Alloc {
  !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun alloc_bytes(&self, layout: Layout) -> Res[NonNull[U8], AllocErr] {
    # `malloc`. It takes no alignment, so `layout.align` is ignored: `malloc`
    # aligns for any fundamental type.
    # @let layout: The size and alignment of the block.
    # @ret: A byte pointer to the block, or `AllocOomErr` if `malloc` returned
    #   null.

    let raw_ptr = sppc::malloc(layout.size)
    let ptr = NonNull[U8]::from_ptr(raw_ptr).map_err((e: NullptrErr) AllocOomErr)?
    ret Pass(val=ptr)
  }

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun free_bytes(&self, ptr: NonNull[U8], layout: Layout) -> Void {
    # `free`, which recovers the block size itself, so `layout` is ignored.
    # @let ptr: The block to free.
    # @let layout: The `Layout` the block was allocated with. Unused.

    sppc::free(ptr.as_c_mut())
  }

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun alloc_bytes_zeroed(&self, layout: Layout) -> Res[NonNull[U8], AllocErr] {
    # `calloc`, which can hand out pages the os has already zeroed instead of
    # writing zeroes. Alignment is ignored, as for `alloc_bytes`.
    # @let layout: The size and alignment of the block.
    # @ret: A byte pointer to the zeroed block, or `AllocOomErr` if `calloc`
    #   returned null.

    let raw_ptr = sppc::calloc(1_uz, layout.size)
    let ptr = NonNull[U8]::from_ptr(raw_ptr).map_err((e: NullptrErr) AllocOomErr)?
    ret Pass(val=ptr)
  }

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  fun realloc_bytes(&self, ptr: NonNull[U8], old_layout: Layout,
    new_layout: Layout) -> Res[NonNull[U8], AllocErr] {
    # `realloc`, which grows or shrinks in place when it can, and otherwise
    # copies and frees the old block itself. On failure it leaves the old block
    # untouched.
    # @let ptr: The block to resize.
    # @let old_layout: The `Layout` the block currently has. Unused: `realloc`
    #   tracks the old size.
    # @let new_layout: The `Layout` to resize it to.
    # @ret: A byte pointer to the resized block, or `AllocOomErr` if `realloc`
    #   returned null.

    let raw_ptr = sppc::realloc(ptr.as_c_mut(), new_layout.size)
    let new_ptr = NonNull[U8]::from_ptr(raw_ptr).map_err(
      (e: NullptrErr) AllocOomErr)?
    ret Pass(val=new_ptr)
  }
}

sup GlobalAlloc ext Clone {
  fun clone(&self) -> Self {
    ret GlobalAlloc
  }
}

sup GlobalAlloc ext Copy {
  # The global allocator holds no state - every instance is the same handle onto
  # malloc and free - so it owns nothing and copying it is free. Methods on it
  # borrow the receiver ("GlobalAlloc.allocate(..)"), which needs no value kept.
}
