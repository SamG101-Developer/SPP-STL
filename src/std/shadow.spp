use std::annotations::package
use std::annotations::public
use std::annotations::versioned
use std::allocator::Alloc
use std::allocator::GlobalAlloc
use std::clone::Clone
use std::option::None
use std::option::Opt
use std::option::Some
use std::shared::ControlBlock
use std::shared::Shared
use std::void::Void
use std::mem::pointer::NonNull
use std::ops::del::Del

!public
!versioned(base="1.0.0", new="1.0.0")
cls Shadow[T, A: Alloc=GlobalAlloc] {
    !package ptr: NonNull[ControlBlock[T]]
    !package alloc: A
}

sup [T, A: Alloc] Shadow[T, A] {
    !public type Element = T
}

sup [T, A: Alloc & Clone] Shadow[T, A] {
    !public
    !versioned(base="1.0.0", new="1.0.0")
    fun upgrade(&self) -> Opt[Shared[T, A]] {
        # Attempt to revive a strong `Shared` handle from this weak `Shadow`. If the share count has already reached
        # zero then the value has been dropped and cannot be revived, so `None` is returned. Otherwise the share count
        # is incremented and a new `Shared` handle to the same control block is returned wrapped in `Some`. A fresh
        # `NonNull` to the same block is fabricated from the raw address; as a locally owned `mut` pointer it provides
        # the mutable access needed to bump the counter through the shared `&self` borrow, and is then moved into the
        # returned `Shared`. The allocator is cloned so the revived share can deallocate the block independently.
        # @ret: `Some` containing a new `Shared` handle if the value is still alive, otherwise `None`.

        case self.ptr.shared_counter == 0_uz { ret None }
        let mut cb = NonNull[ControlBlock[T]]::from_ptr_inner(self.ptr.raw())
        cb.shared_counter += 1_uz
        ret Some(val=Shared(ptr=cb, alloc=self.alloc.clone()))
    }
}

sup [T, A: Alloc & Clone] Shadow[T, A] ext Clone {
    !versioned(base="1.0.0", new="1.0.0")
    fun clone(&self) -> Self {
        # Create another shadow to the same control block. Like `Shared::downgrade`, this increments the shadow count so
        # the block stays alive while any shadow exists, and never touches the share count or the value. A fresh
        # `NonNull` to the block is fabricated from the raw address to provide the mutable access needed to bump the
        # counter through `&self`, then moved into the new shadow; the allocator is cloned so each shadow can deallocate
        # independently.
        # @ret: A new `Shadow` sharing this shadow's control block.

        let mut cb = NonNull[ControlBlock[T]]::from_ptr_inner(self.ptr.raw())
        cb.shadow_counter += 1_uz
        ret Shadow(ptr=cb, alloc=self.alloc.clone())
    }
}

sup [T, A: Alloc] Shadow[T, A] ext Del {
    !versioned(base="1.0.0", new="1.0.0")
    fun del(&mut self) -> Void {
        # Drop one shadow. A shadow never owns the value, so no value destructor runs here; only the shadow count is
        # decremented. The control block is deallocated only when this was the very last handle of any kind - no shares
        # keeping the value alive and no other shadows keeping the block alive - in which case the value has already
        # been destroyed by the last `Shared` and only the raw storage remains to be freed.
        # @ret: Nothing; this is invoked for its cleanup side effects when a `Shadow` is destroyed.

        self.ptr.shadow_counter -= 1_uz
        case self.ptr.shared_counter == 0_uz and self.ptr.shadow_counter == 0_uz {
            self.alloc.deallocate_array[ControlBlock[T]](self.ptr, 1_uz)
        }
    }
}
