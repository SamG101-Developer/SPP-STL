use std::annotations::intrinsic
use std::annotations::versioned
use std::llvm::inline

!public !inline
!versioned(base="1.0.0", new="1.0.0")
fun abort(msg: &StrView = "") -> ! {
  # The `abort` function is a built-in function that terminates the program
  # immediately. It does not return and does not unwind the stack. The behavior
  # of the `abort` is uniform across all platforms. It is typically used in
  # situations where the program has encountered an unrecoverable error.
  # @let ?msg: An optional string that can be used to provide additional
  #   information about the reason for the abort.

  std::console::eprintln(msg)
  std::process::abort()
}

!public !inline
!versioned(base="1.0.0", new="1.0.0")
fun abort_if(condition: Bool, msg: &StrView = "") -> Void {
  # The `abort_if` function is a helper function that checks a condition and
  # calls `abort` if the condition is true. Shorthand for a `case` expression
  # wrapping an `abort()` call.
  # @let condition: A boolean condition that is checked. If it is true, the
  #   program will be aborted.
  # @let ?msg: An optional string that can be used to provide additional
  #   information about the reason for the abort.

  case condition { abort(msg) }
}
