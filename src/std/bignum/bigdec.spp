use std::annotations::public
use std::number::S64
use std::void::Void
use std::bignum::bigint::BigInt

!public
cls BigDec {
    int_val: BigInt
    scale: S64
}

sup BigDec ext std::ops::drop::Drop {
    # A `BigDec` owns the integer it scales; the scale is an `S64` and so owes nothing.

    !public
    fun drop(self) -> Void {
        let BigDec(int_val, scale) = self
        int_val.drop()
    }
}
