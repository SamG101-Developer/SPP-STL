use std::annotations::intrinsic
use std::annotations::public
use std::annotations::versioned
use std::llvm::inline
use std::cast::From
use std::clone::Clone
use std::copy::Copy
use std::number::U32
use std::option::None
use std::option::Opt
use std::option::Some
use std::string::Str
use std::string_view::StrView
use std::num::bases::Zero
use std::num::sized_floating_point::SizedFloatingPoint
use std::num::sized_integer_signed::SizedIntegerSigned
use std::num::sized_integer_unsigned::SizedIntegerUnsigned
use std::ops::and_::And
use std::ops::bit_and::BitAnd
use std::ops::bit_ior::BitIor
use std::ops::bit_not::BitNot
use std::ops::bit_xor::BitXor
use std::ops::eq::Eq
use std::ops::ior_::Ior

!public
!versioned(base="1.0.0", new="1.0.0")
cls Integral { }

sup Integral ext Copy { }

!public
!versioned(base="1.0.0", new="1.0.0")
cls Bool {
  # The `Bool` type represents a boolean value, which can be either `true` or `false`. It has all the stnadard
  # operations superimposed on it, such as logical and bitwise operations, as well as conversions from numeric types.
  # The `Bool` type is a fundamental type in the language and is used for control flow, conditional expressions, and
  # logical operations. It is a simple type that can be easily optimized by the compiler, and is mapped to the llvm
  # `bool` type.
}

sup Bool ext Copy {
  # The `Bool` type is `Copy`, as it is a simple type that can be easily copied by value. This allows for efficient
  # copying and passing of `Bool` values without the need for heap allocation or reference counting.
}

sup Bool ext Zero {
  # The `Bool` type has a zero value, which is `false`. This allows for the use of the `Zero` trait to create a `Bool`
  # value that is initialized to `false`, and can be used in generic contexts where a zero value is required.

  !versioned(base="1.0.0", new="1.0.0")
  fun zero() -> Self {
    # The `zero` method returns the zero value for the `Bool` type, which is `false`. This is useful for initializing
    # variables or fields to a known state, and for generic contexts where a zero value is required.
    # @ret: The zero value for the `Bool` type, which is `false`.
    ret false
  }

  fun is_zero(&self) -> Bool {
    # The `is_zero` method checks if the `Bool` value is equal to the zero value, which is `false`. This is useful for
    # checking if a variable or field is in its default state, and for generic contexts where a zero value is required.
    # @ret: A boolean value indicating whether the `Bool` value is equal to the zero value (`false`).

    ret self.not
  }
}

sup Bool ext Integral {
  # The `Bool` type is integral, as are the number types, allowing it to be cosntrained by traits that require integral
  # types, such as the `Atom` type. There are no additional methods from the `Integral` type; it is more of a marker
  # trait to indicate that `Bool` is an integral type.
}

sup Bool ext And {
  # Use the `and` keyword operator class.

  !inline
  !intrinsic(name="std.boolean.Bool.and")
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun and_(self, that: Self) -> Bool {
    # The `and_` method allows for `true and false` to be evaluated as `try.and_(false)`, which is intrinsically mapped
    # to the llvm `and` instruction.
    # @let that: The right-hand side of the logical AND operation.
    # @ret: The result of the logical AND operation between `self` and `that`.
  }
}

sup Bool ext Ior {
  # Use the `or` keyword operator class.

  !inline
  !intrinsic(name="std.boolean.Bool.ior")
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun ior_(self, that: Self) -> Bool {
    # The `ior_` method allows for `true or false` to be evaluated as `try.ior_(false)`, which is intrinsically mapped
    # to the llvm `or` instruction.
    # @let that: The right-hand side of the logical OR operation.
    # @ret: The result of the logical OR operation between `self` and `that`.
  }
}

sup Bool ext BitAnd {
  # Use the `&` operator class.

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_and(self, that: Self) -> Self {
    # The `bit_and` method allows for `true & false` to be evaluated as `try.bit_and(false)`, which is intrinsically
    # mapped to the llvm `and` instruction. Because a `Bool` is a single bit, the bitwise AND and logical AND operations
    # are the same, but they are provided as separate methods to allow for better contextual usage.
    # @let that: The right-hand side of the bitwise AND operation.
    # @ret: The result of the bitwise AND operation between `self` and `that`.

    ret std::intrinsics::bit_and(self, that)
  }
}

sup Bool ext BitIor {
  # Use the `|` operator class.

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_ior(self, that: Self) -> Self {
    # The `bit_ior` method allows for `true | false` to be evaluated as `try.bit_ior(false)`, which is intrinsically
    # mapped to the llvm `or` instruction. Because a `Bool` is a single bit, the bitwise OR and logical OR operations
    # are the same, but they are provided as separate methods to allow for better contextual usage.
    # @let that: The right-hand side of the bitwise OR operation.
    # @ret: The result of the bitwise OR operation between `self` and `that`.

    ret std::intrinsics::bit_ior(self, that)
  }
}

sup Bool ext BitXor {
  # Use the `^` operator class.

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_xor(self, that: Self) -> Self {
    # The `bit_xor` method allows for `true ^ false` to be evaluated as `try.bit_xor(false)`, which is intrinsically
    # mapped to the llvm `xor` instruction. There is no equivalent logical XOR operator, so the bitwise XOR is the only
    # way to perform an exclusive OR operation on `Bool` values.
    # @let that: The right-hand side of the bitwise XOR operation.
    # @ret: The result of the bitwise XOR operation between `self` and `that`.

    ret std::intrinsics::bit_xor(self, that)
  }
}

sup Bool ext BitNot {
  # Use the `~` operator class.

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun bit_not(self) -> Self {
    # The `bit_not` method allows for `true~` to be evaluated as `try.bit_not()`, which is intrinsically mapped to the
    # llvm `not` instruction. Because a `Bool` is a single bit, the bitwise NOT and logical NOT operations are the same,
    # but they are provided as separate methods to allow for better contextual usage.
    # @ret: The result of the bitwise NOT operation on `self`.

    ret std::intrinsics::bit_not(self)
  }
}

sup Bool ext Eq {
  # Use the `==` and `!=` operator class.

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun eq(&self, that: &Self) -> Bool {
    # The `eq` method allows for `true == false` to be evaluated as `try.eq(false)`, which is intrinsically mapped to
    # the llvm `icmp eq` instruction.
    # @let that: The right-hand side of the equality comparison.
    # @ret: The result of the equality comparison between `self` and `that`.

    ret std::intrinsics::eq(self, that)
  }

  !inline
  !versioned(base="1.0.0", new="1.0.0")
  cmp fun ne(&self, that: &Self) -> Bool {
    # The `ne` method allows for `true != false` to be evaluated as `try.ne(false)`, which is intrinsically mapped to
    # the llvm `icmp ne` instruction.
    # @let that: The right-hand side of the inequality comparison.
    # @ret: The result of the inequality comparison between `self` and `that`.

    ret std::intrinsics::ne(self, that)
  }
}

sup [cmp n: U32] Bool ext From[SizedIntegerSigned[n]] {
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedIntegerSigned[n]) -> Self {
    ret that > SizedIntegerSigned[n]::zero()
  }
}

sup [cmp n: U32] Bool ext From[SizedIntegerUnsigned[n]] {
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedIntegerUnsigned[n]) -> Self {
    ret that > SizedIntegerUnsigned[n]::zero()
  }
}

sup [cmp n: U32] Bool ext From[SizedFloatingPoint[n]] {
  !versioned(base="1.0.0", new="1.0.0")
  fun from(that: SizedFloatingPoint[n]) -> Self {
    ret that > SizedFloatingPoint[n]::zero()
  }
}
