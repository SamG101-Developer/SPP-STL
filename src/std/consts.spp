use std::annotations::versioned

!public
!versioned(base="1.0.0", new="1.0.0")
cls Consts[T] {
  # Mathematical constants, for each float type, each its literal correctly
  # rounded to that type (written with the digits for F128): `Consts[F64]::pi`.
  # @type T: The float type the constants are of.
}

sup Consts[F16] {
  !public cmp e: F16 = 2.718281828459045235360287471352662497757_f16
  !public cmp pi: F16 = 3.141592653589793238462643383279502884197_f16
