  !public cmp log2_10: F16 = 3.321928094887362347870319429489390175864_f16
  !public cmp log10_2: F16 = 0.301029995663981195213738894724493026768_f16
  !public cmp sqrt_2: F16 = 1.414213562373095048801688724209698078569_f16
