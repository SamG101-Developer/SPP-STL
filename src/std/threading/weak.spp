use std::annotations::package
use std::annotations::public
use std::annotations::versioned
use std::allocator::Alloc
use std::allocator::GlobalAlloc
use std::clone::Clone
use std::number::USize
use std::option::None
use std::option::Opt
use std::option::Some
use std::void::Void
use std::mem::pointer::NonNull
use std::ops::del::Del
use std::threading::arc::Arc
use std::threading::arc::AtomicControlBlock
use std::threading::atomic::Atom
use std::threading::atomic::atomic_fence

!public
!versioned(base="1.0.0", new="1.0.0")
cls Weak[T, A: Alloc=GlobalAlloc] {
    # The thread-safe, non-owning (weak) handle paired with `Arc`. It keeps the control block alive but not the value,
    # and can be upgraded back to an `Arc` while at least one strong share still exists. All of its counter operations
    # are atomic, so - unlike the `Weak` in `std::rc` - it is safe to send and share across threads.
    # @type T: The type of the value the control block holds.
    # @type A: The allocator type used to deallocate the control block. Defaults to `GlobalAlloc`.
    # @let ptr: A non-null pointer to the shared atomic control block.
    # @let alloc: The allocator used to deallocate the control block once no handles of any kind remain.

    !package ptr: NonNull[AtomicControlBlock[T]]
    !package alloc: A
}

sup [T, A: Alloc] Weak[T, A] {
    !public type Element = T
}

sup [T, A: Alloc & Clone] Weak[T, A] {
    !public
    !versioned(base="1.0.0", new="1.0.0")
    fun upgrade(&self) -> Opt[Arc[T, A]] {
        # Attempt to revive a strong `Arc` handle. The share count is bumped with a compare-exchange loop that only ever
        # increments a count that is still nonzero: if a concurrent thread has already driven the strong count to zero
        # (so the value is being, or has been, destroyed) the load observes zero and `None` is returned, and the CAS can
        # never resurrect it. A successful exchange uses acquire ordering so the revived `Arc` synchronizes with the
        # writes that published the value. On spurious or contended failure the freshly observed count is reused for the
        # next attempt, so no redundant load is needed.
        # @ret: `Some` containing a new `Arc` handle if the value is still alive, otherwise `None`.

        let mut current = self.ptr.strong_counter.load(Atom[USize]::mo_relaxed)
        loop current != 0_uz {
            let (observed, ok) = self.ptr.strong_counter.compex_weak(current, current + 1_uz, Atom[USize]::mo_acquire, Atom[USize]::mo_relaxed)
            case ok { ret Some(val=Arc(ptr=self.ptr, alloc=self.alloc.clone())) }
            current = observed
        }
        ret None
    }
}

sup [T, A: Alloc & Clone] Weak[T, A] ext Clone {
    !versioned(base="1.0.0", new="1.0.0")
    fun clone(&self) -> Self {
        # Create another weak handle to the same control block. The shadow count is incremented with a relaxed atomic
        # fetch-add - as with `Arc::clone`, cloning establishes no ordering of its own. The `NonNull` is `Copy`, so the
        # pointer is simply copied into the new handle, and the allocator is cloned so each weak handle can deallocate
        # independently.
        # @ret: A new `Weak` sharing this handle's control block.

        self.ptr.weak_counter.fetch_add(1_uz, Atom[USize]::mo_relaxed)
        ret Weak(ptr=self.ptr, alloc=self.alloc.clone())
    }
}

sup [T, A: Alloc] Weak[T, A] ext Del {
    !versioned(base="1.0.0", new="1.0.0")
    fun del(&mut self) -> Void {
        # Drop one weak handle by decrementing the shadow count with a release fetch-sub. The live `Arc`s collectively
        # hold a single shadow reference (established at construction and released by the last `Arc`), so when this
        # decrement brings the shadow count to zero it is genuinely the last handle of any kind: the value has already
        # been destroyed, and only the raw control-block storage remains to be freed. An acquire fence pairs with the
        # release decrements of the other handles before the deallocation.
        # @ret: Nothing; this is invoked for its cleanup side effects when a `Weak` is destroyed.

        let old = self.ptr.weak_counter.fetch_sub(1_uz, Atom[USize]::mo_release)
        case old == 1_uz {
            atomic_fence(Atom[USize]::mo_acquire)
            self.alloc.deallocate_array(self.ptr, 1_uz)
        }
    }
}
