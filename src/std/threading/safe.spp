use std::annotations::public
use std::annotations::versioned

!public
!versioned(base="1.0.0", new="1.0.0")
cls ThreadSafe {
    # A marker that allows a type to safely be passed between threads. It is automatically applied to every type that is
    # not annotated with `!thread_hazard`. Manual superimpositon of this trait is not allowed, and just automatically
    # errors with a duplicate trait extension, as `ThreadSafe` will already be applied, and `!thread_hazard` will clash
    # in the annoation checks too (so `Rc` can't externally be marked as `ThreadSafe`).
}
