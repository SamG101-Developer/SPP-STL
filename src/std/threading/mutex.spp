use std::annotations::package
use std::annotations::public
use std::annotations::thread_hazard
use std::annotations::versioned
use std::annotations::zero_type
use std::allocator::GlobalAlloc
use std::boolean::Bool
use std::function::FunMut
use std::generator::GenOnce
use std::number::S32
use std::number::U32
use std::number::U64
use std::number::USize
use std::result::Fail
use std::result::Pass
use std::result::Res
use std::string_view::StrView
use std::void::Void
use std::mem::ops::drop
use std::mem::pointer::NonNull
use std::ops::drop::Drop
use std::threading::cond_var::CondVar
use std::threading::cond_var::TimedOut
use std::threading::thread::ThreadErr
use std::time::duration::Duration
use std::time::time_point::TimePoint

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls WouldBlock {
  # The `WouldBlock` type is a zero sized type that is used to indicate that a non-blocking operation would block if it
  # were to be performed. It is used as a return type for the `try_lock` method of the `Mutex` class, which attempts to
  # acquire a lock on the mutex without blocking. If the mutex is already locked, the `try_lock` method returns a
  # `WouldBlock` value to indicate that the operation would block if it were to be performed.
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls Mutex[T] {
  # Guards a `T` behind a pthread mutex, handing out an exclusive borrow of it for as long as the lock is held. The
  # value lives in its own cell rather than inside the mutex, and locking hands back a `MutexGuard` carrying a copy of
  # the pointer to it.
  # @type T: The type of the guarded value. A `Mutex[T]` is only as sendable as its `T`.
  # @let handle: The sppc handle for the underlying `pthread_mutex_t`, which lives behind it rather than in it.
  # @let val: The cell holding the guarded value.

  !package handle: U64
  !package val: NonNull[T]
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls MutexGuard[T] {
  # Proof that the lock is held, and the only route to the value while it is. Dropping one releases the mutex, so the
  # lock is held for exactly as long as the guard is - which is what the old design tried to express with a deferred
  # release inside a coroutine frame, and could not, because the frame's cleanup ran before the caller ever saw the
  # borrow.
  # @type T: The type of the guarded value.
  # @let handle: A copy of the owning mutex's sppc handle; unlocking through it releases the same mutex.
  # @let val: A copy of the owning mutex's pointer to the guarded value.

  !package handle: U64
  !package val: NonNull[T]
}

sup [T] MutexGuard[T] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Release the mutex. This is the whole of the guard's purpose, and the reason it must be consumed rather than
    # discarded: dropping it is what unlocks.

    let Self(handle, val) = self
    let err = sppc::pthread_mutex_unlock(&handle)
  }
}

sup [T] MutexGuard[T] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  cor get(&mut self) -> GenOnce[&mut T] {
    # The guarded value, borrowed exclusively for as long as the guard is held: `guard.get()@ = 4` writes it, and
    # `guard.get().push(4)` calls through it.
    # @ret: The guarded value, borrowed mutably.

    gen self.val.fwd_mut()
  }
}

sup [T] Mutex[T] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new(val: T) -> Mutex[T] {
    # Create a new mutex using the sppc threading API. Todo: Error Handling.
    let mut handle = 0_u64
    let err = sppc::pthread_mutex_init(&mut handle)
    let mut cell = GlobalAlloc().allocate_array[T](1_uz).expect("Allocation failed")
    cell.write(val)
    ret Mutex(handle, val=cell)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun lock(&self) -> Res[MutexGuard[T], ThreadErr] {
    # Block until the mutex is held, and hand back the guard that both proves it and reaches the value. A "Res" is
    # possible here where it was not before, because a guard is an ordinary owned value rather than a borrow.
    # @ret: The guard, or the error the lock reported.

    let err = sppc::pthread_mutex_lock(&self.handle)
    case err != 0 { ret Fail(err=ThreadErr::from_errno(err)) }
    ret Pass(val=MutexGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun timed_lock(&self, timeout: Duration, clock: U32 = 1_u32) -> Res[MutexGuard[T], TimedOut or ThreadErr] {
    # As "lock", but giving up once the deadline passes. The deadline elapsing reports "TimedOut" rather than an error,
    # because it is an ordinary outcome of asking for a lock with a limit on the wait.
    # @let timeout: How long to wait before giving up.
    # @let ?clock: The clock the deadline is measured against.
    # @ret: The guard, "TimedOut" if the deadline passed, or the error the lock reported.

    let timespec = sppc::CTimespec(sec=timeout.seconds, nsec=timeout.nanoseconds)
    let err = sppc::pthread_mutex_clocklock(&self.handle, S32::from(clock), &timespec)
    drop(timespec)

    case err == cffi::etimedout { ret Fail(err=TimedOut) }
    case err != 0 { ret Fail(err=ThreadErr::from_errno(err)) }
    ret Pass(val=MutexGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun lock_when[F: FunMut[(&mut T,), Bool]](&self, cond: &CondVar, mut pred: F) -> Res[MutexGuard[T], ThreadErr] {
    # Acquire the mutex, then block on `cond` until `pred` reports that the guarded value satisfies the caller's
    # condition, and finally yield the guard. This is the safe replacement for the classic "lock, then wait on a
    # condition variable" dance: because the wait lives inside this guard coroutine, the mutex is released and
    # re-acquired atomically across each `pthread_cond_wait` (guarding against spurious wake-ups via the predicate
    # loop), and there is only ever one `&mut T` in existence -- no separate condition-variable API can conjure an
    # aliasing reference to the protected value while a waiter holds the lock. The signalling half is on `CondVar`
    # itself (`signal_one` / `signal_all`), called by whichever thread mutates the guarded value.
    # @type F: The predicate function type, taking a mutable reference to the guarded value and reporting whether the
    # awaited condition now holds.
    # @let cond: The condition variable that threads mutating the guarded value signal after each change.
    # @let pred: The predicate; the wait continues for as long as it returns `false`, and the guard is yielded once it
    # returns `true`.
    # @ret: The guard, once the predicate is satisfied, or the error the lock reported.

    defer drop(pred)

    let err = sppc::pthread_mutex_lock(&self.handle)
    case err != 0 { ret Fail(err=ThreadErr::from_errno(err)) }

    # The predicate is asked through a local copy of the
    # mutex's pointer: the lock is held for the whole of
    # this loop, so an exclusive borrow of the value is
    # exactly what is available here.
    let mut cell = self.val
    loop pred(cell.fwd_mut()).not {
      let werr = sppc::pthread_cond_wait(&cond.handle, &self.handle)
      case werr != 0 {
        # No guard exists yet on this path, so the lock
        # is released by hand before the error goes back.
        let uerr = sppc::pthread_mutex_unlock(&self.handle)
        ret Fail(err=ThreadErr::from_errno(werr))
      }
    }
    ret Pass(val=MutexGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun lock_when_timeout[F: FunMut[(&mut T,), Bool]](
    &self, cond: &CondVar, timeout: Duration, mut pred: F, clock: U32 = 1_u32)
  -> Res[MutexGuard[T], TimedOut or ThreadErr] {
    # The timed counterpart of `lock_when`: acquire the mutex and wait on `cond` for the predicate to hold, but give up
    # once `timeout` has elapsed. On success the guard is yielded exactly as in `lock_when`. On timeout the mutex is
    # released first and `TimedOut` is yielded instead, so no guarded reference escapes past the deadline; a caller that
    # still needs the value must re-lock. The deadline is computed once up front and the remaining time is recomputed
    # each iteration, so repeated spurious wake-ups cannot extend the total wait.
    # @type F: The predicate function type, taking a mutable reference to the guarded value and reporting whether the
    # awaited condition now holds.
    # @let cond: The condition variable that threads mutating the guarded value signal after each change.
    # @let timeout: The maximum duration to wait for the predicate to hold before giving up.
    # @let pred: The predicate; the wait continues for as long as it returns `false` and the deadline has not passed.
    # @let ?clock: The clock id used to measure the timeout, matching the `clock`-parameter convention of `timed_lock`.
    # Defaults to `1`.
    # @ret: The guard if the predicate is satisfied in time, or `TimedOut` if the deadline elapses first.

    defer drop(pred)

    let deadline = TimePoint::now() + timeout
    let err = sppc::pthread_mutex_lock(&self.handle)
    case err != 0 { ret Fail(err=ThreadErr::from_errno(err)) }

    let mut cell = self.val
    loop pred(cell.fwd_mut()).not {
      let remaining = deadline.duration_since_saturating(TimePoint::now())
      case remaining.is_zero() {
        # Nothing has been handed out, so the lock is released
        # here rather than by a guard the caller never receives.
        let uerr = sppc::pthread_mutex_unlock(&self.handle)
        ret Fail(err=TimedOut)
      }
      let timespec = sppc::CTimespec(sec=remaining.seconds, nsec=remaining.nanoseconds)
      let werr = sppc::pthread_cond_clockwait(&cond.handle, &self.handle, S32::from(clock), &timespec)
      drop(timespec)

      case werr != 0 and werr != cffi::etimedout {
        let uerr = sppc::pthread_mutex_unlock(&self.handle)
        ret Fail(err=ThreadErr::from_errno(werr))
      }
    }
    ret Pass(val=MutexGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_lock(&self) -> Res[MutexGuard[T], WouldBlock or ThreadErr] {
    # Take the lock only if it is free. A busy mutex reports "WouldBlock"; any other failure reports the error rather
    # than being swallowed.
    # @ret: The guard, "WouldBlock" if the mutex was already held, or the error the lock reported.

    let code = sppc::pthread_mutex_trylock(&self.handle)
    case code == cffi::ebusy { ret Fail(err=WouldBlock) }
    case code != 0 { ret Fail(err=ThreadErr::from_errno(code)) }
    ret Pass(val=MutexGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun take(self) -> T {
    # Take the value out of the mutex, consuming the mutex. Because "self" is being moved, it requires exclusive access
    # to the mutex, so we can safely consume the mutex and take the value out without locking it.
    # @ret: The value the mutex was guarding.

    let Self(handle, val) = self
    let err = sppc::pthread_mutex_destroy(&handle)
    let inner = val.read()
    GlobalAlloc().deallocate_array(val, 1_uz)
    ret inner
  }
}

sup [T: Drop] Mutex[T] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Destroy the mutex using the sppc threading API, and discard the value it was guarding. The guarded value has to go
    # somewhere, which is why this needs "T: Drop"; a caller that wants the value back should use "take". Todo: Error
    # Handling.
    let Mutex[T](handle, val) = self
    let err = sppc::pthread_mutex_destroy(&handle)
    drop(val.read())
    GlobalAlloc().deallocate_array(val, 1_uz)
  }
}
