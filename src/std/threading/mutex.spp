use std::annotations::versioned
use std::mem::pointer::NonNull
use std::ops::drop::Drop
use std::threading::cond_var::CondVar
use std::threading::cond_var::TimedOut
use std::threading::thread::ThreadErr
use std::time::duration::Duration
use std::time::time_point::TimePoint

!public !zero_type
!versioned(base="1.0.0", new="1.0.0")
cls WouldBlock {
  # The `WouldBlock` type is a zero sized type that is used to indicate that a
  # non-blocking operation would block if it were to be performed. It is the
  # failure of the `try_` locking methods of `Mutex`, `RwLock` and `SpinLock`,
  # which attempt to take a lock without blocking.
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls Mutex[T] {
  # Guards a `T` behind a pthread mutex. The value is only reachable inside a
  # closure passed to one of the `with_lock` methods, which holds the lock for
  # exactly as long as the closure runs: the closure's `&mut T` cannot outlive
  # the call (a borrow cannot be the closure's result type) or reach another
  # thread. Owned guards could do both, and a deferred unlock in a coroutine
  # frame released the lock before the borrow was used.
  # @type T: The type of the guarded value. A `Mutex[T]` is only as sendable as
  #   its `T`.
  # @let handle: The sppc handle for the underlying `pthread_mutex_t`, which
  #   lives behind it rather than in it.
  # @let val: The heap cell holding the guarded value.

  !package handle: U64
  !package val: Single[T]
}

sup [T] Mutex[T] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new(val: T) -> Res[Mutex[T], ThreadErr] {
    # Create a mutex guarding `val`. If the pthread mutex cannot be created,
    # `val` is dropped and the error returned.
    # @let val: The value to guard.
    # @ret: The mutex, or the error the initialisation reported.

    let mut handle = 0_u64
    let err = sppc::pthread_mutex_init(&mut handle)
    case err != 0 {
      drop(val)
      ret Fail(err=ThreadErr::from_errno(err))
    }
    ret Pass(val=Mutex(handle, val=Single[T]::new(val)))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun with_lock[R, F: FunMov[(&mut T,), R]](&self, f: F) -> Res[R, ThreadErr] {
    # Block until the mutex is held, run `f` on the guarded value, then release
    # the mutex.
    # @type R: What `f` returns.
    # @type F: The function run under the lock.
    # @let f: Called once with the guarded value, borrowed exclusively.
    # @ret: What `f` returned, or the error the lock reported (`f` is then
    #   dropped unrun).

    let err = sppc::pthread_mutex_lock(&self.handle)
    case err != 0 {
      drop(f)
      ret Fail(err=ThreadErr::from_errno(err))
    }
    ret Pass(val=self.run_and_release[R, F](f))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun timed_with_lock[R, F: FunMov[(&mut T,), R]](
    &self, timeout: Duration, f: F, clock: U32 = 1_u32) -> Res[R, TimedOut or ThreadErr] {
    # As `with_lock`, but giving up once `timeout` has passed without the lock.
    # The deadline elapsing reports `TimedOut` rather than an error, as it is an
    # ordinary outcome of a limited wait.
    # @type R: What `f` returns.
    # @type F: The function run under the lock.
    # @let timeout: How long to wait for the lock.
    # @let f: Called once with the guarded value, if the lock is taken in time.
    # @let ?clock: The clock the deadline is measured against.
    # @ret: What `f` returned, `TimedOut`, or the error the lock reported.

    let timespec = sppc::CTimespec(sec=timeout.seconds, nsec=timeout.nanoseconds)
    let err = sppc::pthread_mutex_clocklock(&self.handle, S32::from(clock), &timespec)
    drop(timespec)

    case err != 0 {
      drop(f)
      case err == sppc::etimedout { ret Fail(err=TimedOut) }
      ret Fail(err=ThreadErr::from_errno(err))
    }
    ret Pass(val=self.run_and_release[R, F](f))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_with_lock[R, F: FunMov[(&mut T,), R]](&self, f: F) -> Res[R, WouldBlock or ThreadErr] {
    # As `with_lock`, but only if the mutex is free. A held mutex reports
    # `WouldBlock`.
    # @type R: What `f` returns.
    # @type F: The function run under the lock.
    # @let f: Called once with the guarded value, if the lock was free.
    # @ret: What `f` returned, `WouldBlock`, or the error the lock reported.

    let code = sppc::pthread_mutex_trylock(&self.handle)
    case code != 0 {
      drop(f)
      case code == sppc::ebusy { ret Fail(err=WouldBlock) }
      ret Fail(err=ThreadErr::from_errno(code))
    }
    ret Pass(val=self.run_and_release[R, F](f))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun with_lock_when[R, P: FunMut[(&mut T,), Bool], F: FunMov[(&mut T,), R]](
    &self, cond: &CondVar, mut pred: P, f: F) -> Res[R, ThreadErr] {
    # Take the mutex, wait on `cond` until `pred` holds for the guarded value,
    # then run `f` on it and release. Each `pthread_cond_wait` releases and
    # retakes the mutex atomically, and the predicate loop absorbs spurious
    # wake-ups. Threads changing the value signal `cond` (`signal_one` /
    # `signal_all`) afterwards.
    # @type R: What `f` returns.
    # @type P: The predicate type.
    # @type F: The function run once the predicate holds.
    # @let cond: The condition variable signalled after each change to the
    #   value.
    # @let pred: Asked under the lock; the wait continues while it returns
    #   `false`.
    # @let f: Called once with the guarded value, once `pred` holds.
    # @ret: What `f` returned, or the error the lock or wait reported.

    defer drop(pred)
    let err = sppc::pthread_mutex_lock(&self.handle)
    case err != 0 {
      drop(f)
      ret Fail(err=ThreadErr::from_errno(err))
    }

    let mut cell = self.val.pointer
    loop pred(&mut cell).not {
      let werr = sppc::pthread_cond_wait(&cond.handle, &self.handle)
      case werr != 0 {
        self.release()
        drop(f)
        ret Fail(err=ThreadErr::from_errno(werr))
      }
    }
    ret Pass(val=self.run_and_release[R, F](f))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun with_lock_when_timeout[R, P: FunMut[(&mut T,), Bool], F: FunMov[(&mut T,), R]](
    &self, cond: &CondVar, timeout: Duration, mut pred: P, f: F, clock: U32 = 1_u32)
    -> Res[R, TimedOut or ThreadErr] {
    # As `with_lock_when`, but giving up once `timeout` has passed. The deadline
    # is fixed up front and the remaining time recomputed each wait, so spurious
    # wake-ups cannot extend it. On timeout the mutex is released and `f` is
    # dropped unrun.
    # @type R: What `f` returns.
    # @type P: The predicate type.
    # @type F: The function run once the predicate holds.
    # @let cond: The condition variable signalled after each change to the
    #   value.
    # @let timeout: The longest the whole wait may take.
    # @let pred: Asked under the lock; the wait continues while it returns
    #   `false` and time remains.
    # @let f: Called once with the guarded value, if `pred` holds in time.
    # @let ?clock: The clock the timeout is measured against.
    # @ret: What `f` returned, `TimedOut`, or the error the lock or wait
    #   reported.

    defer drop(pred)
    let deadline = TimePoint::now() + timeout
    let err = sppc::pthread_mutex_lock(&self.handle)
    case err != 0 {
      drop(f)
      ret Fail(err=ThreadErr::from_errno(err))
    }

    let mut cell = self.val.pointer
    loop pred(&mut cell).not {
      let remaining = deadline.duration_since_saturating(TimePoint::now())
      case remaining.is_zero() {
        self.release()
        drop(f)
        ret Fail(err=TimedOut)
      }
      let timespec = sppc::CTimespec(sec=remaining.seconds, nsec=remaining.nanoseconds)
      let werr = sppc::pthread_cond_clockwait(
        &cond.handle, &self.handle, S32::from(clock), &timespec)
      drop(timespec)

      case werr != 0 and werr != sppc::etimedout {
        self.release()
        drop(f)
        ret Fail(err=ThreadErr::from_errno(werr))
      }
    }
    ret Pass(val=self.run_and_release[R, F](f))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun take(self) -> T {
    # Take the value out, consuming the mutex. Owning `self` means nothing else
    # can be using it, so no lock is needed.
    # @ret: The value the mutex was guarding.

    let Self(handle, val) = self
    let err = sppc::pthread_mutex_destroy(&handle)
    std::abort::abort_if(err != 0, "Failed to destroy a mutex")
    ret val.read()
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun run_and_release[R, F: FunMov[(&mut T,), R]](&self, f: F) -> R {
    # With the mutex held by the caller: run `f` on the value, then release.
    # @ret: What `f` returned.

    let mut cell = self.val.pointer
    let out = f(&mut cell)
    self.release()
    ret out
  }

  !private
  !versioned(base="1.0.0", new="1.0.0")
  fun release(&self) -> Void {
    # Unlock a mutex this thread holds. Failing to means the lock state is not
    # what the code believes, so it aborts.

    let err = sppc::pthread_mutex_unlock(&self.handle)
    std::abort::abort_if(err != 0, "Failed to unlock a mutex")
  }
}

sup [T] Mutex[T] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Destroy the mutex and drop the value it guards. Use `take` to keep the
    # value.

    let Mutex[T](handle, val) = self
    let err = sppc::pthread_mutex_destroy(&handle)
    std::abort::abort_if(err != 0, "Failed to destroy a mutex")
    drop(val)
  }
}
