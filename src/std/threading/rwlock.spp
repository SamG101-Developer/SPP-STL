use std::annotations::package
use std::annotations::private
use std::annotations::public
use std::annotations::thread_hazard
use std::annotations::versioned
use std::allocator::GlobalAlloc
use std::generator::GenOnce
use std::number::S32
use std::number::U32
use std::number::U64
use std::number::USize
use std::result::Fail
use std::result::Pass
use std::result::Res
use std::void::Void
use std::mem::ops::drop
use std::mem::pointer::NonNull
use std::ops::drop::Drop
use std::threading::cond_var::TimedOut
use std::threading::mutex::WouldBlock
use std::threading::thread::ThreadErr
use std::time::duration::Duration

!public
!versioned(base="1.0.0", new="1.0.0")
cls RwLockReadGuard[T] {
  # Proof that a read hold is taken, and the route to the value while it is. Dropping one releases the hold.
  # @type T: The type of the guarded value.
  # @let handle: A copy of the owning rwlock's sppc handle; unlocking through it releases the same rwlock.
  # @let val: A copy of the owning rwlock's pointer to the guarded value.

  !package handle: U64
  !package val: NonNull[T]
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls RwLockWriteGuard[T] {
  # As `RwLockReadGuard`, for the exclusive hold: it reaches the value mutably.
  # @type T: The type of the guarded value.
  # @let handle: A copy of the owning rwlock's sppc handle; unlocking through it releases the same rwlock.
  # @let val: A copy of the owning rwlock's pointer to the guarded value.

  !package handle: U64
  !package val: NonNull[T]
}

sup [T] RwLockReadGuard[T] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Release the read hold. One `pthread_rwlock_unlock` releases either kind of hold.
    let Self(handle, val) = self
    let err = sppc::pthread_rwlock_unlock(&handle)
  }
}

sup [T] RwLockWriteGuard[T] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Release the write hold.
    let Self(handle, val) = self
    let err = sppc::pthread_rwlock_unlock(&handle)
  }
}

sup [T] RwLockReadGuard[T] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  cor get(&self) -> GenOnce[&T] {
    # The guarded value, borrowed for as long as the hold lasts.
    # @ret: The guarded value, borrowed immutably.

    gen self.val.fwd_ref()
  }
}

sup [T] RwLockWriteGuard[T] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  cor get(&mut self) -> GenOnce[&mut T] {
    # The guarded value, borrowed exclusively for as long as the hold lasts.
    # @ret: The guarded value, borrowed mutably.

    gen self.val.fwd_mut()
  }
}

!public
!versioned(base="1.0.0", new="1.0.0")
cls RwLock[T] {
  # Guards a `T` behind a pthread rwlock, handing out a shared borrow to readers and an exclusive one to a writer. It
  # holds its value in its own cell for the same reason `Mutex` does, and hands out a guard rather than a borrow.
  # Holding nothing hazardous, an `RwLock[T]` is sendable exactly when its `T` is.
  # @type T: The type of the guarded value. An `RwLock[T]` is only as sendable as its `T`.
  # @let handle: The sppc handle for the underlying `pthread_rwlock_t`, which lives behind it rather than in it.
  # @let val: The guarded value.

  !package handle: U64
  !package val: NonNull[T]
}

sup [T] RwLock[T] {
  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun new(val: T) -> RwLock[T] {
    # Create a new rwlock using the sppc threading API. Todo: Error handling - "new" should report a failed init rather
    # than swallowing it.
    let mut handle = 0_u64
    let err = sppc::pthread_rwlock_init(&mut handle)
    let mut cell = GlobalAlloc().allocate_array[T](1_uz).expect("Allocation failed")
    cell.write(val)
    ret RwLock(handle, val=cell)
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun read(&self) -> Res[RwLockReadGuard[T], ThreadErr] {
    # Lock the rwlock for reading using the sppc threading API. A failed lock yields the error instead of the guarded
    # value; the alternatives are a bare variant rather than a "Res", because "Pass[T]" would store the borrow in its
    # "val" attribute and second-class borrows do not allow that.
    let err = sppc::pthread_rwlock_rdlock(&self.handle)
    case err != 0 {
      ret Fail(err=ThreadErr::from_errno(err))
    }
    ret Pass(val=RwLockReadGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun write(&self) -> Res[RwLockWriteGuard[T], ThreadErr] {
    # Lock the rwlock for writing using the sppc threading API. A failed lock yields the error instead of the guarded
    # value.
    let err = sppc::pthread_rwlock_wrlock(&self.handle)
    case err != 0 {
      ret Fail(err=ThreadErr::from_errno(err))
    }
    ret Pass(val=RwLockWriteGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun timed_read(&self, timeout: Duration, clock: U32 = 1_u32) -> Res[RwLockReadGuard[T], TimedOut or ThreadErr] {
    # Timed lock the rwlock for reading using the sppc threading API. The deadline elapsing yields "TimedOut", and any
    # other failure yields the error; neither hands out the guarded value.
    let timespec = sppc::CTimespec(sec=timeout.seconds, nsec=timeout.nanoseconds)
    let err = sppc::pthread_rwlock_clockrdlock(&self.handle, S32::from(clock), &timespec)
    drop(timespec)

    case err == cffi::etimedout {
      ret Fail(err=TimedOut)
    }
    case err != 0 {
      ret Fail(err=ThreadErr::from_errno(err))
    }
    ret Pass(val=RwLockReadGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun timed_write(&self, timeout: Duration, clock: U32 = 1_u32) -> Res[RwLockWriteGuard[T], TimedOut or ThreadErr] {
    # Timed lock the rwlock for writing using the sppc threading API. The deadline elapsing yields "TimedOut", and any
    # other failure yields the error.
    let timespec = sppc::CTimespec(sec=timeout.seconds, nsec=timeout.nanoseconds)
    let err = sppc::pthread_rwlock_clockwrlock(&self.handle, S32::from(clock), &timespec)
    drop(timespec)

    case err == cffi::etimedout {
      ret Fail(err=TimedOut)
    }
    case err != 0 {
      ret Fail(err=ThreadErr::from_errno(err))
    }
    ret Pass(val=RwLockWriteGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_write(&self) -> Res[RwLockWriteGuard[T], WouldBlock or ThreadErr] {
    # Try to lock the rwlock for writing using the sppc threading API. A busy lock yields "WouldBlock"; any other
    # failure yields the error rather than being swallowed.
    let code = sppc::pthread_rwlock_trywrlock(&self.handle)
    case code == cffi::ebusy {
      ret Fail(err=WouldBlock)
    }
    case code != 0 {
      ret Fail(err=ThreadErr::from_errno(code))
    }
    ret Pass(val=RwLockWriteGuard(handle=self.handle, val=self.val))
  }

  !public
  !versioned(base="1.0.0", new="1.0.0")
  fun try_read(&self) -> Res[RwLockReadGuard[T], WouldBlock or ThreadErr] {
    # Try to lock the rwlock for reading using the sppc threading API. A busy lock yields "WouldBlock"; any other
    # failure yields the error rather than being swallowed.
    let code = sppc::pthread_rwlock_tryrdlock(&self.handle)

    ret case code of {
      == cffi::ebusy { Fail(err=WouldBlock) }
      != 0 { Fail(err=ThreadErr::from_errno(code)) }
      else { Pass(val=RwLockReadGuard(handle=self.handle, val=self.val)) }
    }
  }
}

sup [T: Drop] RwLock[T] ext Drop {
  !versioned(base="1.0.0", new="1.0.0")
  fun drop(self) -> Void {
    # Destroy the rwlock using the sppc threading API, and discard the value it was guarding. The guarded value has to
    # go somewhere, which is why this needs "T: Drop"; a caller that wants the value back should use "take".
    let RwLock[T](handle, val) = self
    let err = sppc::pthread_rwlock_destroy(&handle)
    drop(val.read())
    GlobalAlloc().deallocate_array(val, 1_uz)
  }
}
