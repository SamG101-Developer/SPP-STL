# Coverage for "std::bignum::biguint". "BigUInt" is not "Copy", so every value here is discharged explicitly.

!test(group="std/bignum/biguint")
fun test_zero_and_one_report_themselves() -> Void {
  std::debug::assert(std::bignum::biguint::BigUInt::zero().is_zero(), "zero is zero")
  std::debug::assert(std::bignum::biguint::BigUInt::one().is_one(), "one is one")
  std::debug::assert(std::bignum::biguint::BigUInt::zero().is_one().not, "zero is not one")
  std::debug::assert(std::bignum::biguint::BigUInt::one().is_zero().not, "one is not zero")
}

!test(group="std/bignum/biguint")
fun test_from_a_sized_integer_keeps_the_value() -> Void {
  let a = std::bignum::biguint::BigUInt::from(7_u32)
  let b = std::bignum::biguint::BigUInt::from(7_u32)
  std::debug::assert(a == b, "the same source gives equal values")
  drop(a)
  drop(b)
}

!test(group="std/bignum/biguint")
fun test_equality_and_ordering() -> Void {
  let a = std::bignum::biguint::BigUInt::from(3_u32)
  let b = std::bignum::biguint::BigUInt::from(5_u32)
  std::debug::assert(a != b, "different values")
  std::debug::assert(a.ord(&b) < 0_s32, "three orders before five")
  std::debug::assert(b.ord(&a) > 0_s32, "and five after three")
  std::debug::assert(a.ord(&a) == 0_s32, "a value orders equal to itself")
  drop(a)
  drop(b)
}

!test(group="std/bignum/biguint")
fun test_addition_and_subtraction() -> Void {
  let sum = std::bignum::biguint::BigUInt::from(3_u32).add(std::bignum::biguint::BigUInt::from(4_u32))
  let seven = std::bignum::biguint::BigUInt::from(7_u32)
  std::debug::assert(sum == seven, "3 + 4 == 7")
  drop(sum)
  drop(seven)

  let diff = std::bignum::biguint::BigUInt::from(9_u32).sub(std::bignum::biguint::BigUInt::from(4_u32))
  let five = std::bignum::biguint::BigUInt::from(5_u32)
  std::debug::assert(diff == five, "9 - 4 == 5")
  drop(diff)
  drop(five)
}

# The two failures above are ordinary red ones and are left in place: "3 != 5" reports the two as equal, and
# "9 - 4 == 5" does not hold, so equality/ordering and subtraction are wrong independently of anything below.

!test(group="std/bignum/biguint")
fun test_multiplication_and_division() -> Void {
  let prod = std::bignum::biguint::BigUInt::from(6_u32).mul(std::bignum::biguint::BigUInt::from(7_u32))
  let forty_two = std::bignum::biguint::BigUInt::from(42_u32)
  std::debug::assert(prod == forty_two, "6 * 7 == 42")
  drop(prod)
  drop(forty_two)

  let quot = std::bignum::biguint::BigUInt::from(42_u32).div(std::bignum::biguint::BigUInt::from(7_u32))
  let six = std::bignum::biguint::BigUInt::from(6_u32)
  std::debug::assert(quot == six, "42 / 7 == 6")
  drop(quot)
  drop(six)
}

!test(group="std/bignum/biguint")
fun test_division_truncates_and_remainder_is_the_leftover() -> Void {
  let quot = std::bignum::biguint::BigUInt::from(7_u32).div(std::bignum::biguint::BigUInt::from(2_u32))
  let three = std::bignum::biguint::BigUInt::from(3_u32)
  std::debug::assert(quot == three, "7 / 2 truncates to 3")
  drop(quot)
  drop(three)

  let rem = std::bignum::biguint::BigUInt::from(7_u32).rem(std::bignum::biguint::BigUInt::from(2_u32))
  let one = std::bignum::biguint::BigUInt::one()
  std::debug::assert(rem == one, "7 % 2 == 1")
  drop(rem)
  drop(one)
}

