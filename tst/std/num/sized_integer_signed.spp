cmp shifted_at_compile_time: S32 = (-8) >> 1_u32

!test(group="std/num/sized_integer_signed")
fun test_right_shift_is_arithmetic() -> Void {
  # The sign bit is copied in, so a negative value stays negative and ">> 1" halves it, rounding down.
  std::debug::assert(((-8) >> 1_u32) == -4, "a negative halves")
  std::debug::assert(((-7) >> 1_u32) == -4, "rounding toward negative infinity")
  std::debug::assert(((-1) >> 31_u32) == -1, "all the way down is all ones")
  std::debug::assert((8 >> 1_u32) == 4, "a positive is unchanged")
  let mut x = -16
  x >>= 2_u32
  std::debug::assert(x == -4, ">>= as well")
  std::debug::assert(shifted_at_compile_time == -4, "and at compile time")
  std::debug::assert((-8).bit_shr_wrapping(33_u32) == -4, "wrapping takes the amount modulo the width")
  std::debug::assert((-8).bit_shr_checked(32_u32).is_none(), "checked refuses the width")
  std::debug::assert((-8).bit_shr_checked(1_u32).unwrap() == -4, "and is arithmetic below it")
}

!test(group="std/num/sized_integer_signed")
fun test_midpoint_rounds_toward_zero() -> Void {
  # As "/" rounds, so "a.midpoint(b)" is "(a + b) / 2" without the sum that could overflow.
  let min = std::limits::Limits[S32]::min
  let max = std::limits::Limits[S32]::max
  std::debug::assert(3.midpoint(4) == 3, "3.5 rounds down to 3")
  std::debug::assert((-3).midpoint(-4) == -3, "-3.5 rounds up to -3")
  std::debug::assert((-1).midpoint(-2) == -1, "-1.5 rounds up to -1")
  std::debug::assert((-3).midpoint(0) == -1, "-1.5 again, with one side zero")
  std::debug::assert(min.midpoint(max) == 0, "-0.5 rounds to 0")
  std::debug::assert(max.midpoint(max) == max, "the sum would overflow; the average does not")
  std::debug::assert(min.midpoint(min) == min, "nor at the bottom")
}

!test(group="std/num/sized_integer_signed")
fun test_cube_root_rounds_toward_zero() -> Void {
  std::debug::assert(27.icbrt() == 3, "an exact cube")
  std::debug::assert((-27).icbrt() == -3, "a negative's root is the negation of its magnitude's")
  std::debug::assert((-26).icbrt() == -2, "rounded toward zero")
  std::debug::assert(std::limits::Limits[S32]::min.icbrt() == -1290, "the minimum, whose magnitude does not fit S32")
  std::debug::assert(std::limits::Limits[S8]::min.icbrt() == -5_s8, "the S8 minimum")
}

!test(group="std/num/sized_integer_signed")
fun test_the_sign_predicates_partition_around_zero() -> Void {
  std::debug::assert(5.is_positive(), "a positive")
  std::debug::assert(5.is_negative().not, "a positive is not negative")
  std::debug::assert((-5).is_negative(), "a negative")
  std::debug::assert((-5).is_positive().not, "a negative is not positive")
  std::debug::assert(0.is_positive().not, "zero is not positive")
  std::debug::assert(0.is_negative().not, "and not negative either")
}

!test(group="std/num/sized_integer_signed")
fun test_negation_flips_the_sign() -> Void {
  std::debug::assert(5.neg() == -5, "a positive negates")
  std::debug::assert((-5).neg() == 5, "and a negative negates back")
  std::debug::assert(0.neg() == 0, "zero negates to itself")
}

!test(group="std/num/sized_integer_signed")
fun test_abs_takes_the_magnitude() -> Void {
  std::debug::assert((-5).abs() == 5, "a negative")
  std::debug::assert(5.abs() == 5, "a positive is its own magnitude")
  std::debug::assert(0.abs() == 0, "zero")
}

!test(group="std/num/sized_integer_signed")
fun test_abs_of_the_minimum_has_no_representable_answer() -> Void {
  # Two's complement has one more negative value than positive, so the minimum's magnitude does not fit. The checked
  # form says so; the wrapping form comes back to the minimum itself.
  let min = std::limits::Limits[S32]::min
  std::debug::assert(min.abs_checked().is_none(), "there is no positive counterpart to the minimum")
  std::debug::assert(min.abs_wrapping() == min, "wrapping lands back on the minimum")
}

!test(group="std/num/sized_integer_signed")
fun test_mod_differs_from_remainder_for_a_negative_dividend() -> Void {
  # "%" takes the sign of the dividend; "mod" takes the sign of the divisor, so it is never negative for a positive
  # one. This is the whole reason both exist.
  std::debug::assert(-7 % 2 == -1, "remainder follows the dividend")
  std::debug::assert((-7).mod(2) == 1, "mod follows the divisor")
  std::debug::assert(7 % 2 == 1, "they agree for a positive dividend")
  std::debug::assert(7.mod(2) == 1, "as does mod")
}

!test(group="std/num/sized_integer_signed")
fun test_integer_square_root_of_a_negative_is_rejected() -> Void {
  std::debug::assert(9.isqrt() == 3, "an exact square")
  std::debug::assert(10.isqrt() == 3, "rounded down between squares")
  std::debug::assert((-1).isqrt_checked().is_none(), "a negative has no integer square root")
  std::debug::assert(9.isqrt_checked().unwrap() == 3, "the checked form agrees for a positive")
}

!test(group="std/num/sized_integer_signed")
fun test_division_and_remainder_of_negatives_truncate_toward_zero() -> Void {
  std::debug::assert(-7 / 2 == -3, "-7 / 2 truncates to -3, not -4")
  std::debug::assert(7 / -2 == -3, "and the same with the sign on the divisor")
  std::debug::assert(-7 % -2 == -1, "the remainder keeps the dividend's sign")
}

!test(group="std/num/sized_integer_signed")
fun test_negating_the_minimum_overflows() -> Void {
  let min = std::limits::Limits[S32]::min
  std::debug::assert(min.neg_checked().is_none(), "the minimum has no negation")
  std::debug::assert(min.neg_wrapping() == min, "and wrapping stays put")
}

!test(group="std/num/sized_integer_signed")
fun test_saturating_arithmetic_stops_at_the_signed_bounds() -> Void {
  let min = std::limits::Limits[S32]::min
  let max = std::limits::Limits[S32]::max
  std::debug::assert(max.add_saturating(1) == max, "adding past the top stops there")
  std::debug::assert(min.sub_saturating(1) == min, "and subtracting past the bottom")
}

!test(group="std/num/sized_integer_signed")
fun test_powers_of_a_negative_alternate_in_sign() -> Void {
  std::debug::assert((-2).pow(2_u32) == 4, "an even power is positive")
  std::debug::assert((-2).pow(3_u32) == -8, "an odd power keeps the sign")
  std::debug::assert((-2).pow(0_u32) == 1, "anything to the zero is one")
}

!test(group="std/num/sized_integer_signed")
fun test_a_power_that_does_not_fit_is_reported() -> Void {
  std::debug::assert(2.pow_checked(4_u32).unwrap() == 16, "a power that fits")
  std::debug::assert(2.pow_checked(64_u32).is_none(), "one that does not")
  std::debug::assert(2.pow_saturating(64_u32) == std::limits::Limits[S32]::max, "saturating stops at the top")
}

!test(group="std/num/sized_integer_signed")
fun test_the_narrower_widths_behave_the_same() -> Void {
  std::debug::assert((-5_s8).abs() == 5_s8, "abs at S8")
  std::debug::assert((-5_s16).is_negative(), "the sign predicate at S16")
  std::debug::assert((-7_s64).mod(2_s64) == 1_s64, "mod at S64")
}

!test(group="std/num/sized_integer_signed")
fun test_floor_division_rounds_toward_negative_infinity() -> Void {
  # Floor and truncation differ only when the signs differ and the division is inexact: -3.5 truncates to -3 but
  # floors to -4. Hacker's Delight 2nd ed., exercise 9.3.
  std::debug::assert(7.div_floor(2) == 3, "same signs agree with truncation")
  std::debug::assert((-7).div_floor(-2) == 3, "as do two negatives")
  std::debug::assert((-6).div_floor(3) == -2, "an exact division is not adjusted")
  std::debug::assert((-7).div_floor(2) == -4, "-3.5 floors to -4")
  std::debug::assert(7.div_floor(-2) == -4, "and with the sign on the divisor")
}

!test(group="std/num/sized_integer_signed")
fun test_ceiling_division_rounds_toward_positive_infinity() -> Void {
  std::debug::assert(7.div_ceil(2) == 4, "3.5 ceils to 4")
  std::debug::assert((-7).div_ceil(-2) == 4, "as it does for two negatives")
  std::debug::assert((-6).div_ceil(3) == -2, "an exact division is not adjusted")
  std::debug::assert((-7).div_ceil(2) == -3, "-3.5 ceils to -3")
  std::debug::assert(7.div_ceil(-2) == -3, "and with the sign on the divisor")
}

!test(group="std/num/sized_integer_signed")
fun test_a_power_that_fits_is_not_reported_as_overflowing() -> Void {
  # Square-and-multiply must not square the base after its last use: 16 * 16 does not fit S8, but 16 to the 1 does.
  # Hacker's Delight 2nd ed., figure 11-6.
  std::debug::assert(16_s8.pow_checked(1_u32).unwrap() == 16_s8, "the checked form already stops in time")
  let (val, overflowed) = 16_s8.pow_overflow(1_u32)
  std::debug::assert(val == 16_s8, "the overflow form's value")
  std::debug::assert(overflowed.not, "and its flag")
  std::debug::assert(8_s8.pow(2_u32) == 64_s8, "64 fits S8, though the next square would not")
}

!test(group="std/num/sized_integer_signed")
fun test_the_remainder_by_minus_one_is_zero() -> Void {
  # Every integer divides by -1 exactly, so the remainder is 0 - the minimum included: its quotient overflows, but the
  # remainder is 0 and fits, so it is not an overflow (as Java and Go; Rust panics).
  let min = std::limits::Limits[S32]::min
  std::debug::assert(5.rem_checked(-1).unwrap() == 0, "the checked form")
  std::debug::assert(5.rem_wrapping(-1) == 0, "the wrapping form")
  std::debug::assert((-5).rem_wrapping(-1) == 0, "and for a negative dividend")
  let (val, overflowed) = min.rem_overflow(-1)
  std::debug::assert(val == 0, "the minimum's remainder")
  std::debug::assert(overflowed.not, "is not an overflow")
  std::debug::assert(min.rem_checked(-1).unwrap() == 0, "so the checked form gives it too")
}