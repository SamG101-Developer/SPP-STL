!test(group="std/num/sized_floating_point")
fun test_total_cmp_and_ord_order_every_value() -> Void {
  # -NaN < -inf < -1 < -0 < +0 < 1 < +inf < +NaN, which "<" and "==" cannot say: they have no order for a NaN, and call
  # the two zeros equal. "ord" is this order too, as "Ord" asks for a total one. The NaNs, infinities and -0 are written
  # as their bits, so nothing folds them.
  let values = [
    std::intrinsics::bit_cast[F64](0xfff8000000000000_u64),
    std::intrinsics::bit_cast[F64](0xfff0000000000000_u64),
    -1.0_f64,
    std::intrinsics::bit_cast[F64](0x8000000000000000_u64),
    0.0_f64,
    1.0_f64,
    std::intrinsics::bit_cast[F64](0x7ff0000000000000_u64),
    std::intrinsics::bit_cast[F64](0x7ff8000000000000_u64)]
  let mut all_in_order = true
  let mut i = 0_uz
  loop i < values.len() {
    let mut j = 0_uz
    loop j < values.len() {
      let a = values[i]@
      let b = values[j]@
      all_in_order = all_in_order and a.total_cmp(&b) == i.ord(&j) and a.ord(&b) == i.ord(&j)
      j += 1_uz
    }
    i += 1_uz
  }
  std::debug::assert(all_in_order, "every pair compares as its position in the list")
}

!test(group="std/num/sized_floating_point")
fun test_arithmetic_on_exactly_representable_values() -> Void {
  std::debug::assert(1.5_f64 + 2.25_f64 == 3.75_f64, "addition")
  std::debug::assert(3.75_f64 - 1.5_f64 == 2.25_f64, "subtraction")
  std::debug::assert(1.5_f64 * 2.0_f64 == 3.0_f64, "multiplication")
  std::debug::assert(3.0_f64 / 2.0_f64 == 1.5_f64, "division")
}

!test(group="std/num/sized_floating_point")
fun test_comparison_orders_negatives_below_positives() -> Void {
  std::debug::assert(-1.0_f64 < 0.0_f64, "a negative is below zero")
  std::debug::assert(0.0_f64 < 1.0_f64, "zero is below a positive")
  std::debug::assert(-2.5_f64 < -1.5_f64, "more negative is smaller")
  std::debug::assert(2.5_f64 > 1.5_f64, "larger positive is greater")
}

!test(group="std/num/sized_floating_point")
fun test_equality_and_inequality() -> Void {
  std::debug::assert(1.25_f64 == 1.25_f64, "equal values")
  std::debug::assert(1.25_f64 != 1.5_f64, "different values")
  std::debug::assert((1.25_f64 == 1.5_f64).not, "equality is false for different values")
}

!test(group="std/num/sized_floating_point")
fun test_a_nan_is_unequal_to_everything_itself_included() -> Void {
  # IEEE 754's "!=" is the negation of "==": true when either side is a NaN, so "x != x" finds one.
  let nan = std::intrinsics::bit_cast[F64](0x7ff8000000000000_u64)
  let one = 1.0_f64
  std::debug::assert(nan != nan, "a NaN is unequal to itself")
  std::debug::assert(nan != one and one != nan, "a NaN is unequal to a number, either side")
  std::debug::assert((nan == nan).not, "a NaN is not equal to itself")
  std::debug::assert((one != one).not, "a number is not unequal to itself")
}

!test(group="std/num/sized_floating_point")
fun test_ord_tells_the_zeros_apart_where_equality_does_not() -> Void {
  let neg_zero = std::intrinsics::bit_cast[F64](0x8000000000000000_u64)
  let pos_zero = 0.0_f64
  std::debug::assert(neg_zero == pos_zero, "the zeros are equal")
  std::debug::assert(neg_zero.ord(&pos_zero) == -1, "-0 orders below +0")
  std::debug::assert(pos_zero.ord(&neg_zero) == 1, "+0 orders above -0")
}

!test(group="std/num/sized_floating_point")
fun test_abs_and_neg_flip_the_sign() -> Void {
  std::debug::assert(-2.5_f64.abs() == 2.5_f64, "abs of a negative")
  std::debug::assert(2.5_f64.abs() == 2.5_f64, "abs of a positive is itself")
  std::debug::assert(2.5_f64.neg() == -2.5_f64, "neg of a positive")
  std::debug::assert(-2.5_f64.neg() == 2.5_f64, "neg of a negative")
}

!test(group="std/num/sized_floating_point")
fun test_rounding_towards_each_direction() -> Void {
  std::debug::assert(1.5_f64.floor() == 1.0_f64, "floor goes down")
  std::debug::assert(1.5_f64.ceil() == 2.0_f64, "ceil goes up")
  std::debug::assert(1.5_f64.trunc() == 1.0_f64, "trunc drops the fraction")
  std::debug::assert(-1.5_f64.floor() == -2.0_f64, "floor of a negative goes further down")
  std::debug::assert(-1.5_f64.ceil() == -1.0_f64, "ceil of a negative goes up towards zero")
  std::debug::assert(-1.5_f64.trunc() == -1.0_f64, "trunc of a negative goes towards zero")
}

!test(group="std/num/sized_floating_point")
fun test_round_takes_a_half_away_from_zero_and_round_even_to_even() -> Void {
  std::debug::assert(2.5_f64.round() == 3.0_f64, "round takes a half up, away from zero")
  std::debug::assert(-2.5_f64.round() == -3.0_f64, "round takes a negative half down, away from zero")
  std::debug::assert(2.5_f64.round_even() == 2.0_f64, "round_even takes 2.5 to the even 2")
  std::debug::assert(3.5_f64.round_even() == 4.0_f64, "round_even takes 3.5 to the even 4")
  std::debug::assert(-2.5_f64.round_even() == -2.0_f64, "round_even takes -2.5 to the even -2")
  std::debug::assert(2.6_f64.round_even() == 3.0_f64, "round_even takes anything but a half to the nearest")
  std::debug::assert(-0.5_f64.round_even().is_negative_zero(), "round_even keeps the sign of a zero")
}

!test(group="std/num/sized_floating_point")
fun test_min_and_max_pick_the_right_side() -> Void {
  std::debug::assert(1.5_f64.min(2.5_f64) == 1.5_f64, "min of two positives")
  std::debug::assert(1.5_f64.max(2.5_f64) == 2.5_f64, "max of two positives")
  std::debug::assert(-1.5_f64.min(1.5_f64) == -1.5_f64, "min spanning zero")
  std::debug::assert(-1.5_f64.max(1.5_f64) == 1.5_f64, "max spanning zero")
}

!test(group="std/num/sized_floating_point")
fun test_min_and_max_propagate_a_nan_and_order_the_zeros() -> Void {
  # IEEE 754-2019's minimum and maximum: a NaN is not skipped, and -0 is below +0. Written as bits, so nothing folds.
  let nan = std::intrinsics::bit_cast[F64](0x7ff8000000000000_u64)
  let neg_zero = std::intrinsics::bit_cast[F64](0x8000000000000000_u64)
  let pos_zero = 0.0_f64
  std::debug::assert(nan.min(1.0_f64).is_quiet_nan(), "min with a NaN is a NaN")
  std::debug::assert(1.0_f64.max(nan).is_quiet_nan(), "max with a NaN is a NaN, either side")
  std::debug::assert(neg_zero.max(pos_zero).is_positive_zero(), "max of the zeros is +0")
  std::debug::assert(pos_zero.min(neg_zero).is_negative_zero(), "min of the zeros is -0")
}

!test(group="std/num/sized_floating_point")
fun test_sqrt_of_exact_squares() -> Void {
  std::debug::assert(4.0_f64.sqrt() == 2.0_f64, "sqrt of four")
  std::debug::assert(9.0_f64.sqrt() == 3.0_f64, "sqrt of nine")
  std::debug::assert(0.25_f64.sqrt() == 0.5_f64, "sqrt of a quarter")
}

!test(group="std/num/sized_floating_point")
fun test_powers_of_two_are_exact() -> Void {
  # Both "pow" overloads: the integer exponent is squared and multiplied in S++, the float one goes to "llvm.pow".
  std::debug::assert(2.0_f64.pow(3) == 8.0_f64, "two cubed, integer exponent")
  std::debug::assert(2.0_f64.pow(0) == 1.0_f64, "anything to the zero")
  std::debug::assert(2.0_f64.pow(10) == 1024.0_f64, "two to the tenth, integer exponent")
  std::debug::assert(2.0_f64.pow(-2) == 0.25_f64, "a negative exponent is a reciprocal")
  std::debug::assert(-3.0_f64.pow(3) == -27.0_f64, "an odd power keeps the sign")
  std::debug::assert(0.5_f64.pow(-1) == 2.0_f64, "minus one inverts")
  std::debug::assert(2.0_f64.pow(3.0_f64) == 8.0_f64, "two cubed, float exponent")
  std::debug::assert(9.0_f64.pow(0.5_f64) == 3.0_f64, "a fractional exponent is a root")
  std::debug::assert(2.0_f64.exp2() == 4.0_f64, "exp2 is two to the power")
  std::debug::assert(8.0_f64.log2() == 3.0_f64, "log2 undoes it")
}

!test(group="std/num/sized_floating_point")
fun test_is_negative_reports_the_sign() -> Void {
  std::debug::assert(-1.0_f64.is_negative(), "a negative value")
  std::debug::assert(1.0_f64.is_negative().not, "a positive value")
  std::debug::assert(0.0_f64.is_negative().not, "positive zero is not negative")
}

!test(group="std/num/sized_floating_point")
fun test_zero_and_one_are_the_identities() -> Void {
  std::debug::assert(F64::zero() == 0.0_f64, "the zero value")
  std::debug::assert(F64::one() == 1.0_f64, "the one value")
  std::debug::assert(2.5_f64 + F64::zero() == 2.5_f64, "zero is the additive identity")
  std::debug::assert(2.5_f64 * F64::one() == 2.5_f64, "one is the multiplicative identity")
}

!test(group="std/num/sized_floating_point")
fun test_compound_assignment_matches_the_binary_operator() -> Void {
  let mut x = 1.5_f64
  x += 2.25_f64
  std::debug::assert(x == 3.75_f64, "add-assign")
  x -= 0.75_f64
  std::debug::assert(x == 3.0_f64, "sub-assign")
  x *= 2.0_f64
  std::debug::assert(x == 6.0_f64, "mul-assign")
  x /= 4.0_f64
  std::debug::assert(x == 1.5_f64, "div-assign")
}

!test(group="std/num/sized_floating_point")
fun test_a_narrower_width_holds_the_same_small_values() -> Void {
  # "F32" represents these exactly too, so the same assertions hold at the narrower width.
  std::debug::assert(1.5_f32 + 2.25_f32 == 3.75_f32, "addition at F32")
  std::debug::assert(4.0_f32.sqrt() == 2.0_f32, "sqrt at F32")
  std::debug::assert(-1.5_f32.abs() == 1.5_f32, "abs at F32")
}
!test(group="std/num/sized_floating_point")
fun test_try_from_parses_decimal_text() -> Void {
  std::debug::assert(F64::try_from("0").unwrap() == 0.0_f64, "zero")
  std::debug::assert(F64::try_from("1.5").unwrap() == 1.5_f64, "a fraction")
  std::debug::assert(F64::try_from("-2.25").unwrap() == -2.25_f64, "a negative")
  std::debug::assert(F64::try_from("+3").unwrap() == 3.0_f64, "a leading plus")
  std::debug::assert(F64::try_from("1.").unwrap() == 1.0_f64, "nothing after the point")
  std::debug::assert(F64::try_from(".5").unwrap() == 0.5_f64, "nothing before the point")
  std::debug::assert(F64::try_from("0.1").unwrap() == 0.1_f64, "an inexact fraction rounds as the literal does")
  std::debug::assert(F64::try_from("123.456").unwrap() == 123.456_f64, "digits both sides")
  std::debug::assert(F64::try_from("0.000123").unwrap() == 0.000123_f64, "leading zeros after the point")
  std::debug::assert(F32::try_from("3.14159").unwrap() == 3.14159_f32, "an f32")
  std::debug::assert(F16::try_from("0.5").unwrap() == 0.5_f16, "an f16")
  let text = Str::from("2.5")
  std::debug::assert(F64::try_from(&text).unwrap() == 2.5_f64, "an owned Str")
  drop(text)
}

!test(group="std/num/sized_floating_point")
fun test_try_from_reads_an_exponent() -> Void {
  std::debug::assert(F64::try_from("1e3").unwrap() == 1000.0_f64, "a positive exponent")
  std::debug::assert(F64::try_from("1E3").unwrap() == 1000.0_f64, "an uppercase e")
  std::debug::assert(F64::try_from("2.5e+2").unwrap() == 250.0_f64, "a signed positive exponent")
  std::debug::assert(F64::try_from("25e-1").unwrap() == 2.5_f64, "a negative exponent")
  std::debug::assert(F64::try_from("1e400").unwrap().is_positive_infinity(), "past the maximum is an infinity")
  std::debug::assert(F64::try_from("-1e400").unwrap().is_negative_infinity(), "and negative past it")
  std::debug::assert(F64::try_from("1e-400").unwrap().is_positive_zero(), "below the minimum is a zero")
  std::debug::assert(F64::try_from("1e-320").unwrap().is_positive_subnormal(), "a subnormal")
  std::debug::assert(F16::try_from("0.0001234567").unwrap() > 0.0_f16, "an f16 with more digits than its range")
}

!test(group="std/num/sized_floating_point")
fun test_try_from_names_the_values_with_no_digits() -> Void {
  std::debug::assert(F64::try_from("inf").unwrap().is_positive_infinity(), "inf")
  std::debug::assert(F64::try_from("-Infinity").unwrap().is_negative_infinity(), "-Infinity")
  std::debug::assert(F64::try_from("NaN").unwrap().is_quiet_nan(), "NaN")
  std::debug::assert(F64::try_from("-0").unwrap().is_negative_zero(), "-0 keeps its sign")
}

!test(group="std/num/sized_floating_point")
fun test_try_from_rejects_malformed_text() -> Void {
  std::debug::assert(F64::try_from("").is_none(), "empty")
  std::debug::assert(F64::try_from("-").is_none(), "a sign alone")
  std::debug::assert(F64::try_from(".").is_none(), "a point alone")
  std::debug::assert(F64::try_from("1.2.3").is_none(), "two points")
  std::debug::assert(F64::try_from("1e").is_none(), "an empty exponent")
  std::debug::assert(F64::try_from("1e+").is_none(), "a signed empty exponent")
  std::debug::assert(F64::try_from("e5").is_none(), "an exponent with no digits before it")
  std::debug::assert(F64::try_from(" 1").is_none(), "leading whitespace")
  std::debug::assert(F64::try_from("1x").is_none(), "a trailing letter")
  std::debug::assert(F64::try_from("in").is_none(), "part of inf")
  std::debug::assert(F64::try_from("n").is_none(), "part of nan")
  std::debug::assert(F64::try_from("infinit").is_none(), "part of infinity")
}

!test(group="std/num/sized_floating_point")
fun test_the_ieee_forms_pass_a_non_finite_value_through() -> Void {
  # IEEE 754's results with no check, for values made non-finite on purpose.
  std::debug::assert(F64::inf().add_ieee(1.0_f64).is_positive_infinity(), "inf + 1 is inf")
  std::debug::assert(F64::nan().mul_ieee(0.0_f64).is_nan(), "NaN * 0 is a NaN")
  std::debug::assert(1.0_f64.div_ieee(0.0_f64).is_positive_infinity(), "1 / 0 is inf")
  std::debug::assert(0.0_f64.div_ieee(0.0_f64).is_nan(), "0 / 0 is a NaN")
  std::debug::assert(F64::inf().sub_ieee(F64::inf()).is_nan(), "inf - inf is a NaN")
  std::debug::assert(5.0_f64.rem_ieee(0.0_f64).is_nan(), "x % 0 is a NaN")
  std::debug::assert(-1.0_f64.sqrt_ieee().is_nan(), "sqrt(-1) is a NaN")
  std::debug::assert(1.5_f64.add_ieee(2.25_f64) == 3.75_f64, "a finite result is the checked one's")
}

!test(group="std/num/sized_floating_point")
fun test_raised_says_whether_the_checked_form_would_stop() -> Void {
  let (quotient, by_zero) = 1.0_f64.div_raised(0.0_f64)
  std::debug::assert(by_zero and quotient.is_positive_infinity(), "1 / 0 raises, with IEEE's infinity")
  let (sum, fine) = 1.0_f64.add_raised(2.0_f64)
  std::debug::assert(fine.not and sum == 3.0_f64, "1 + 2 raises nothing")
  let (product, nan_in) = F64::nan().mul_raised(2.0_f64)
  std::debug::assert(nan_in and product.is_nan(), "a NaN going in raises")
  let (root, negative) = -4.0_f64.sqrt_raised()
  std::debug::assert(negative and root.is_nan(), "sqrt(-4) raises")
}

!test(group="std/num/sized_floating_point")
fun test_checked_gives_none_where_the_checked_form_would_stop() -> Void {
  std::debug::assert(1.0_f64.div_checked(0.0_f64).is_none(), "1 / 0 is None")
  std::debug::assert(1.0_f64.div_checked(4.0_f64).unwrap() == 0.25_f64, "1 / 4 is 0.25")
  std::debug::assert(F64::inf().sub_checked(1.0_f64).is_none(), "an infinity going in is None")
  std::debug::assert(-1.0_f64.sqrt_checked().is_none(), "sqrt(-1) is None")
  std::debug::assert(9.0_f64.sqrt_checked().unwrap() == 3.0_f64, "sqrt(9) is 3")
  std::debug::assert(3.0_f64.rem_checked(2.0_f64).unwrap() == 1.0_f64, "3 % 2 is 1")
}

!test(group="std/num/sized_floating_point")
fun test_the_non_finite_constants_and_their_classifiers() -> Void {
  std::debug::assert(F64::nan().is_nan() and F64::nan().is_finite().not, "nan() is a NaN")
  std::debug::assert(F64::inf().is_positive_infinity() and F64::inf().is_infinite(), "inf() is +inf")
  std::debug::assert(F32::neg_inf().is_negative_infinity(), "neg_inf() is -inf")
  std::debug::assert(1.0_f64.is_finite() and 0.0_f64.is_finite(), "numbers are finite")
  std::debug::assert(F64::inf().is_nan().not and 1.0_f64.is_infinite().not, "the classifiers do not overlap")
}

!test(group="std/num/sized_floating_point")
fun test_pow_finishes_a_power_whose_reciprocal_underflows() -> Void {
  # 2^-2000 is past the smallest subnormal, so 0; the power 2^2000 it is the
  # reciprocal of overflows on the way, which "pow" must not stop on.
  std::debug::assert(2.0_f64.pow(-2000) == 0.0_f64, "2^-2000 underflows to zero")
  std::debug::assert(2.0_f64.pow_ieee(2000).is_positive_infinity(), "2^2000 is inf, unchecked")
  std::debug::assert(0.5_f64.pow(3) == 0.125_f64, "a finite power is unchanged")
}

!test(group="std/num/sized_floating_point")
fun test_from_ieee_narrows_past_the_range_to_an_infinity() -> Void {
  let big = 1000000000000000000000000000000000000000000.0_f64
  std::debug::assert(F32::from_ieee(big).is_positive_infinity(), "past F32's range is inf")
  std::debug::assert(F32::from_ieee(1.5_f64) == 1.5_f32, "a value in range is narrowed as by from")
  std::debug::assert(F64::from_ieee(1.5_f32) == 1.5_f64, "widening is from's")
}

!test(group="std/num/sized_floating_point")
fun test_try_from_gives_an_infinity_for_a_value_too_large_for_a_narrow_type() -> Void {
  std::debug::assert(F16::try_from("1e10").unwrap().is_positive_infinity(), "1e10 is past F16's range")
  std::debug::assert(F64::try_from("-1e400").unwrap().is_negative_infinity(), "-1e400 is -inf")
  std::debug::assert(F64::try_from("NaN").unwrap().is_nan(), "nan parses to a NaN")
}
