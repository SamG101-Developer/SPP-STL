!test(group="std/single")
fun test_new_stores_the_value_on_the_heap() -> Void {
  let s = std::single::Single[S32]::new(7)
  std::debug::assert(s.get_ref()@ == 7, "the boxed value reads back")
  drop(s)
}

!test(group="std/single")
fun test_read_consumes_the_box_and_returns_the_value() -> Void {
  let s = std::single::Single[S32]::new(11)
  std::debug::assert(s.read() == 11, "read hands the value back")
}

!test(group="std/single")
fun test_get_mut_writes_through_to_the_stored_value() -> Void {
  let mut s = std::single::Single[S32]::new(1)
  s.get_mut()@ = 42
  std::debug::assert(s.read() == 42, "the write reached the heap value")
}

!test(group="std/single")
fun test_a_box_can_hold_a_non_copyable_value() -> Void {
  # A "Vec" inside a "Single" means two allocations, freed in the right order by the box's own drop.
  let mut v = Vec[S32]::new()
  v.append(4)
  v.append(5)

  let s = std::single::Single[Vec[S32]]::new(v)
  std::debug::assert(s.get_ref().len() == 2_uz, "the vector survived the move onto the heap")
  std::debug::assert(s.get_ref()[1_uz]@ == 5, "and its elements are intact")
  drop(s)
}

!test(group="std/single")
fun test_reading_back_a_non_copyable_value_keeps_it_usable() -> Void {
  let mut v = Vec[S32]::new()
  v.append(9)

  let s = std::single::Single[Vec[S32]]::new(v)
  let back = s.read()
  std::debug::assert(back.len() == 1_uz, "the vector came back out of the box")
  std::debug::assert(back[0_uz]@ == 9, "with its element")
  drop(back)
}

!test(group="std/single")
fun test_try_new_reports_a_successful_allocation() -> Void {
  # The failing side needs an allocator that refuses, which "GlobalAlloc" never does; only the passing side is
  # reachable here.
  let r = std::single::Single[S32]::try_new(3)
  std::debug::assert(r.is_pass(), "allocating one integer succeeds")
  drop(r.unwrap())
}

!test(group="std/single")
fun test_each_box_owns_a_separate_value() -> Void {
  let mut a = std::single::Single[S32]::new(1)
  let b = std::single::Single[S32]::new(2)
  a.get_mut()@ = 100
  std::debug::assert(b.get_ref()@ == 2, "writing one box leaves the other alone")
  drop(a)
  drop(b)
}
!test(group="std/single")
fun test_dropping_a_single_drops_its_value() -> Void {
  # Regression: `drop` called `drop_in_place(&mut pointer)`, which inferred `T` as the pointer and destroyed that
  # rather than the value, leaking the vector's buffer. Only a leak check sees this: run under valgrind with
  # --leak-check=full.
  let mut v = Vec[S32]::new()
  v.append(1)
  let s = std::single::Single[Vec[S32]]::new(v)
  drop(s)
}

!test(group="std/single")
fun test_reading_a_single_does_not_drop_the_value_it_returns() -> Void {
  # Regression: `read` deferred a full `drop(self)`, which destroyed the value it had just moved out. Once `drop` really
  # destroyed values, that freed the vector's buffer twice.
  let mut v = Vec[S32]::new()
  v.append(1)
  let s = std::single::Single[Vec[S32]]::new(v)
  let back = s.read()
  std::debug::assert(back.len() == 1_uz, "the vector came back whole")
  drop(back)
}
