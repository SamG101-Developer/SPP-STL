!test(group="std/iterator")
fun test_range_yields_the_half_open_interval() -> Void {
  let mut count = 0_uz
  let mut sum = 0
  loop i in std::range::Range[S32]::between(0, 5) {
    count += 1_uz
    sum += i
  }
  std::debug::assert(count == 5_uz, "five steps for [0, 5)")
  std::debug::assert(sum == 10, "0+1+2+3+4")
}

!test(group="std/iterator")
fun test_empty_range_yields_nothing() -> Void {
  let mut count = 0_uz
  loop i in std::range::Range[S32]::between(3, 3) { count += 1_uz }
  std::debug::assert(count == 0_uz, "an empty interval yields nothing")
}

!test(group="std/iterator")
fun test_count_consumes_and_counts() -> Void {
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4]).iter_mov().count() == 4_uz, "one per element")
  std::debug::assert(Vec[S32]::new().iter_mov().count() == 0_uz, "an empty vector counts nothing")
}

!test(group="std/iterator")
fun test_take_stops_early() -> Void {
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().take(2_uz).count() == 2_uz, "only the first two")
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().take(0_uz).count() == 0_uz, "taking none yields none")
  std::debug::assert(
    Vec[S32]::from(&[1, 2, 3]).iter_mov().take(99_uz).count() == 3_uz, "taking more than there is stops at the end")
}

!test(group="std/iterator")
fun test_drop_skips_the_front() -> Void {
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().drop(2_uz).count() == 3_uz, "the rest after two")
  std::debug::assert(
    Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().drop(0_uz).count() == 5_uz, "skipping none keeps them all")
  std::debug::assert(Vec[S32]::from(&[1, 2, 3]).iter_mov().drop(99_uz).count() == 0_uz, "skipping past the end")
}

!test(group="std/iterator")
fun test_step_by_skips_between_elements() -> Void {
  let mut count = 0_uz
  loop i in std::range::Range[S32]::between(0, 10).step_by(2_uz) { count += 1_uz }
  std::debug::assert(count == 5_uz, "every other element of ten")
}

!test(group="std/iterator")
fun test_iteration_over_an_empty_vector_yields_nothing() -> Void {
  let v = Vec[S32]::new()
  let mut count = 0_uz
  loop e in v.iter_ref() { count += 1_uz }
  std::debug::assert(count == 0_uz, "nothing to visit")
  drop(v)
}

!test(group="std/iterator")
fun test_iterator_step_by_skips_between_elements() -> Void {
  # "Iterator::step_by" advanced its index by the step, so the index was always a multiple of it and every element
  # came through.
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().step_by(2_uz).count() == 3_uz, "the 1st, 3rd, 5th")
  std::debug::assert(Vec[S32]::from(&[1, 2, 3]).iter_mov().step_by(1_uz).count() == 3_uz, "a step of one keeps all")
}

!test(group="std/iterator")
fun test_step_by_over_borrowed_elements() -> Void {
  # The skipped elements are borrows here, which are discarded rather than destroyed.
  let v = Vec[S32]::from(&[1, 2, 3, 4])
  std::debug::assert(v.iter_ref().step_by(2_uz).count() == 2_uz, "the 1st and 3rd")
  drop(v)
}

!test(group="std/iterator")
fun test_slice_yields_the_middle() -> Void {
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().slice(1_uz, 3_uz).count() == 2_uz, "[1, 3)")
  std::debug::assert(Vec[S32]::from(&[1, 2, 3]).iter_mov().slice(2_uz, 99_uz).count() == 1_uz, "stops at the end")
}
