!test(group="std/iterator")
fun test_range_yields_the_half_open_interval() -> Void {
  let mut count = 0_uz
  let mut sum = 0
  loop i in std::range::Range[S32]::between(0, 5) {
    count += 1_uz
    sum += i
  }
  std::debug::assert(count == 5_uz, "five steps for [0, 5)")
  std::debug::assert(sum == 10, "0+1+2+3+4")
}

!test(group="std/iterator")
fun test_empty_range_yields_nothing() -> Void {
  let mut count = 0_uz
  loop i in std::range::Range[S32]::between(3, 3) { count += 1_uz }
  std::debug::assert(count == 0_uz, "an empty interval yields nothing")
}

# Todo: none of the consuming adaptors work on a *borrowing* iterator. "Iterator::count" ends its loop body with
#  "defer drop(item)", and an item of type "&T" has nothing to discharge - "drop" takes its argument by value, so the
#  call has no matching signature and the whole build fails. The same applies to anything else that consumes items it
#  does not return. Written here against "Range", which yields owned values, so the adaptors themselves are still
#  covered; the borrowing case is the gap. It is commented out rather than left red for the reason given in
#  "array.spp": a build failure costs every test, where a failing assertion costs one.
#
# !test(group="std/iterator")
# fun test_count_over_a_borrowing_iterator() -> Void {
#     let v = Vec[S32]::from(&[1, 2, 3, 4])
#     std::debug::assert(v.iter_ref().count() == 4_uz, "one per element")
#     drop(v)
# }

# The adaptors below are "Iterator"'s, and "Range" is a sibling of "Iterator" rather than one of them - both
# superimpose "Gen", and "Range" declares only "step_by" of its own. So they are exercised through "iter_mov", which
# yields an owning "Iterator[T]"; "iter_ref" would give "Iterator[&T]" and hit the borrowing limitation above.

!test(group="std/iterator")
fun test_count_consumes_and_counts() -> Void {
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4]).iter_mov().count() == 4_uz, "one per element")
  std::debug::assert(Vec[S32]::new().iter_mov().count() == 0_uz, "an empty vector counts nothing")
}

!test(group="std/iterator")
fun test_take_stops_early() -> Void {
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().take(2_uz).count() == 2_uz, "only the first two")
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().take(0_uz).count() == 0_uz, "taking none yields none")
  std::debug::assert(
    Vec[S32]::from(&[1, 2, 3]).iter_mov().take(99_uz).count() == 3_uz, "taking more than there is stops at the end")
}

!test(group="std/iterator")
fun test_drop_skips_the_front() -> Void {
  std::debug::assert(Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().drop(2_uz).count() == 3_uz, "the rest after two")
  std::debug::assert(
    Vec[S32]::from(&[1, 2, 3, 4, 5]).iter_mov().drop(0_uz).count() == 5_uz, "skipping none keeps them all")
  std::debug::assert(Vec[S32]::from(&[1, 2, 3]).iter_mov().drop(99_uz).count() == 0_uz, "skipping past the end")
}

# Todo: "nth" is unusable on a borrowing iterator. "Iterator[&T]::nth" returns "Opt[T]" with T a borrow, so the
#  "Some[T=&S32]" it needs would hold a second-class borrow in a class field - which the compiler rejects, pointing at
#  "option.spp" rather than at the call. Either "Opt" needs to admit a borrow member, or the borrowing iterators need a
#  different accessor.
#
