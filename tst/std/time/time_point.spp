!test(group="std/time/time_point")
fun test_a_later_reading_is_not_before_an_earlier_one() -> Void {
  let first = std::time::time_point::TimePoint::now()
  let second = std::time::time_point::TimePoint::now()
  # Saturating, because two readings this close together may be identical, and the unsaturated form has no answer for
  # a negative span.
  let span = second.duration_since_saturating(first)
  std::debug::assert(span.as_secs() < 60_u64, "two readings in a row are less than a minute apart")
}

!test(group="std/time/time_point")
fun test_the_difference_between_an_instant_and_itself_is_zero() -> Void {
  let t = std::time::time_point::TimePoint::now()
  std::debug::assert(t.duration_since(t).is_zero(), "no time passes between an instant and itself")
}

!test(group="std/time/time_point")
fun test_adding_a_duration_moves_forward_by_exactly_it() -> Void {
  let t = std::time::time_point::TimePoint::now()
  let step = std::time::duration::Duration::from_secs(5_u64)
  let later = t + step
  std::debug::assert(later.duration_since(t).as_secs() == 5_u64, "the instant moved by the duration added")
}

!test(group="std/time/time_point")
fun test_subtracting_a_duration_undoes_adding_it() -> Void {
  let t = std::time::time_point::TimePoint::now()
  let step = std::time::duration::Duration::from_secs(7_u64)
  let back = (t + step) - step
  std::debug::assert(back.duration_since(t).is_zero(), "forward then back lands on the original instant")
}

!test(group="std/time/time_point")
fun test_an_earlier_instant_is_before_a_later_one() -> Void {
  let t = std::time::time_point::TimePoint::now()
  let step = std::time::duration::Duration::from_secs(1_u64)
  let later = t + step
  std::debug::assert(later.duration_since(t).as_millis() == 1000_u64, "one second, in milliseconds")
}

!test(group="std/time/time_point")
fun test_duration_since_saturates_rather_than_going_negative() -> Void {
  # An "earlier" instant that is actually later has no positive answer, so the saturating form gives zero instead of
  # wrapping around the unsigned representation.
  let t = std::time::time_point::TimePoint::now()
  let step = std::time::duration::Duration::from_secs(3_u64)
  let later = t + step
  std::debug::assert(t.duration_since_saturating(later).is_zero(), "a backwards span saturates to zero")
}

!test(group="std/time/time_point")
fun test_elapsed_measures_from_the_instant_to_now() -> Void {
  let t = std::time::time_point::TimePoint::now()
  std::debug::assert(t.elapsed().as_secs() < 60_u64, "very little time has passed since a moment ago")
}

!test(group="std/time/time_point")
fun test_a_time_point_is_copyable() -> Void {
  # "TimePoint" superimposes "Copy", so a reading can be kept and compared against without being consumed.
  let t = std::time::time_point::TimePoint::now()
  let a = t
  let b = t
  std::debug::assert(a.duration_since(b).is_zero(), "both copies name the same instant")
}

!test(group="std/time/time_point")
fun test_adding_zero_leaves_the_instant_alone() -> Void {
  let t = std::time::time_point::TimePoint::now()
  let nothing = std::time::duration::Duration::from_secs(0_u64)
  std::debug::assert((t + nothing).duration_since(t).is_zero(), "adding no time changes nothing")
}