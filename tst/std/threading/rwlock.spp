!test(group="std/threading/rwlock")
fun test_a_write_is_seen_by_a_later_read() -> Void {
  let l = std::threading::rwlock::RwLock[S32]::new(1)
  let mut w = l.write().expect("write failed")
  w.get()@ = 5
  drop(w)
  let r = l.read().expect("read failed")
  std::debug::assert(r.get()@ == 5, "the read sees the write")
  drop(r)
  drop(l)
}

!test(group="std/threading/rwlock")
fun test_dropping_an_rwlock_drops_its_value() -> Void {
  # The vector's buffer is freed by the rwlock's drop; valgrind reports a leak if it is not.
  let mut v = Vec[S32]::new()
  v.append(3)
  let l = std::threading::rwlock::RwLock[Vec[S32]]::new(v)
  drop(l)
}
