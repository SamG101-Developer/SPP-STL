!test(group="std/threading/barrier")
fun test_a_one_thread_barrier_passes() -> Void {
  # The one waiter is the serial thread, whose success code is -1; it was reported as a failure.
  let b = std::threading::barrier::Barrier::new(1_u64).expect("barrier")
  let r = b.wait()
  std::debug::assert(r.is_pass(), "the serial thread's wait succeeds")
  drop(r)
  drop(b)
}

!test(group="std/threading/barrier")
fun test_every_waiter_of_a_round_passes() -> Void {
  let b = std::threading::arc::Arc::new(
    std::threading::barrier::Barrier::new(2_u64).expect("barrier"))
  let other = b.clone()
  let h = std::threading::thread::spawn(|caps other| -> Bool {
    let r = other.wait()
    let ok = r.is_pass()
    drop(r)
    drop(other)
    ret ok
  }).expect("spawn failed")
  let r = b.wait()
  let here = r.is_pass()
  drop(r)
  let there = h.join().expect("join failed")
  std::debug::assert(here and there, "both waiters of the round succeed")
  drop(b)
}
