!test(group="std/vector")
fun test_mutable_iteration_writes_through() -> Void {
  let mut v = Vec[S32]::from(&[1, 2, 3])
  loop e in v.iter_mut() { e@ = e@ * 10 }
  std::debug::assert(v[0_uz]@ == 10, "first")
  std::debug::assert(v[2_uz]@ == 30, "last")
  drop(v)
}

!test(group="std/vector")
fun test_dropping_a_vector_releases_its_buffer() -> Void {
  loop i in std::range::Range[std::number::USize]::between(0_uz, 2000_uz) {
    let v = std::vector::Vec[std::number::S32]::new_with_capacity(1000000_uz)
    std::mem::ops::drop(v)
  }
}

!test(group="std/vector")
fun test_dropping_a_string_releases_its_buffer() -> Void {
  loop i in std::range::Range[std::number::USize]::between(0_uz, 2000_uz) {
    let s = std::string::Str::new_with_capacity(1000000_uz)
    std::mem::ops::drop(s)
  }
}

!test(group="std/vector")
fun test_dropping_a_struct_releases_the_buffer_it_holds() -> Void {
  loop i in std::range::Range[std::number::USize]::between(0_uz, 2000_uz) {
    let s = std::option::Some(val=std::vector::Vec[std::number::S32]::new_with_capacity(1000000_uz))
    std::mem::ops::drop(s)
  }
}

!test(group="std/vector")
fun test_dropping_a_variant_releases_the_buffer_it_holds() -> Void {
  loop i in std::range::Range[std::number::USize]::between(0_uz, 2000_uz) {
    let v: std::option::Opt[std::vector::Vec[std::number::S32]] = std::option::Some(
      val=std::vector::Vec[std::number::S32]::new_with_capacity(1000000_uz))
    std::mem::ops::drop(v)
  }
}

!test(group="std/vector")
fun test_abandoning_a_move_iteration_drops_only_the_remainder() -> Void {
  let mut v = std::vector::Vec[std::single::Single[std::number::S32]]::new()
  v.append(std::single::Single[std::number::S32]::new(1))
  v.append(std::single::Single[std::number::S32]::new(2))
  std::debug::assert(v.iter_mov().take(1_uz).count() == 1_uz, "consumed one of two")
}

!test(group="std/vector")
fun test_move_iteration_over_wide_elements() -> Void {
  let mut v = std::vector::Vec[std::array::Arr[std::number::S32, 8_uz]]::new()
  v.append([1, 2, 3, 4, 5, 6, 7, 8])
  v.append([9, 10, 11, 12, 13, 14, 15, 16])
  let mut first = 0
  loop e in v.iter_mov() {
    case first == 0 { first = e[0_uz]@ }
  }
  std::debug::assert(first == 1, "the first element arrived intact")
}

!test(group="std/vector")
fun test_move_iteration_over_elements_that_own_memory() -> Void {
  let mut v = std::vector::Vec[std::string::Str]::new()
  v.append(std::string::Str::from("a"))
  v.append(std::string::Str::from("b"))
  let mut n = 0_uz
  loop e in v.iter_mov() {
    n += 1_uz
    std::mem::ops::drop(e)
  }
  std::debug::assert(n == 2_uz, "both strings came back")
}

!test(group="std/vector")
fun test_move_iteration_over_nested_vectors() -> Void {
  let mut v = std::vector::Vec[std::vector::Vec[std::number::S32]]::new()
  v.append(std::vector::Vec[std::number::S32]::from(&[1, 2]))
  v.append(std::vector::Vec[std::number::S32]::from(&[3, 4]))
  let mut n = 0_uz
  loop e in v.iter_mov() {
    n += e.len()
    std::mem::ops::drop(e)
  }
  std::debug::assert(n == 4_uz, "four elements across two inner vectors")
}

# `reverse_iter_mov` had no coverage at all until this, which is how it went unnoticed that it was written on a
# construct that did not work: `ret` in a coroutine used to reach neither the deferred expressions nor the final
# suspend. Both ends of that are fixed now, but the conditional loop it was rewritten to is the clearer shape anyway.
!test(group="std/vector")
fun test_reverse_move_iteration_visits_back_to_front() -> Void {
  let mut v = std::vector::Vec[std::number::S32]::from(&[1, 2, 3])
  let mut first = 0
  let mut n = 0_uz
  loop e in v.reverse_iter_mov() {
    case n == 0_uz { first = e }
    n += 1_uz
  }
  std::debug::assert(n == 3_uz, "visited every element")
  std::debug::assert(first == 3, "starting from the back")
}

# Every element is the given value. "new_filled" used to set only the length, so the elements were whatever the
# allocation happened to hold ("v[1]" read 232 for a vector filled with 10).
!test(group="std/vector")
fun test_new_filled_holds_the_value_in_every_slot() -> Void {
  let v = Vec[U8]::new_filled(5_uz, 10_u8)
  std::debug::assert(v.len() == 5_uz, "five elements")
  loop i in std::range::Range[USize]::between(0_uz, 5_uz) {
    std::debug::assert(v[i]@ == 10_u8, "every element is the fill value")
  }
  drop(v)
}

!test(group="std/vector")
fun test_new_filled_with_no_elements_is_empty() -> Void {
  let v = Vec[U8]::new_filled(0_uz, 10_u8)
  std::debug::assert(v.len() == 0_uz, "empty")
  drop(v)
}

!test(group="std/vector")
fun test_vector_append_within_capacity_fills_then_refuses() -> Void {
  # It never compiled (a bare "ret" in a "Res" function) because nothing instantiated it.
  let mut v = Vec[Str]::new_with_capacity(1_uz)
  let first = v.append_within_capacity(Str::from("a"))
  std::debug::assert(first.is_pass(), "there was room for the first")
  drop(first)
  let second = v.append_within_capacity(Str::from("b"))
  std::debug::assert(second.is_fail(), "a full vector refuses without growing")
  drop(second)
  std::debug::assert(v.len() == 1_uz and v.cap() == 1_uz, "the vector is unchanged by the refusal")
  drop(v)
}

!test(group="std/vector")
fun test_vector_insert_at_the_length_appends() -> Void {
  # The bounds check allows the length itself (an append) and only refuses past it.
  let mut v = Vec[S32]::from(&[1, 2])
  v.insert_at(2_uz, 3)
  v.insert_many_at(3_uz, Vec[S32]::from(&[4]))
  std::debug::assert(v.len() == 4_uz, "both inserts landed")
  std::debug::assert(v[2_uz]@ == 3 and v[3_uz]@ == 4, "appended at the end, in order")
  drop(v)
}
