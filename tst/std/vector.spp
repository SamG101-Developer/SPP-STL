!test(group="std/vector")
fun test_vector_grows_across_reallocation() -> Void {
  let mut vec = Vec[S32]::new_with_capacity(2_uz)
  vec.append(7)
  vec.append(9)
  vec.append(11)
  std::debug::assert(vec.len() == 3_uz, "length after growth")
  std::debug::assert(vec[0_uz]@ == 7, "first survived realloc")
  std::debug::assert(vec[2_uz]@ == 11, "last after growth")
  drop(vec)
}

!test(group="std/vector")
fun test_raw_buf_is_package_visible_from_tests() -> Void {
  # Reaches a "!package" member, which only works because a library's tests sit in its own package.
  let buf = std::mem::raw_buf::RawBuf[S32]::new_with_capacity(4_uz)
  std::debug::assert(buf.cap() == 4_uz, "capacity")
  drop(buf)
}

!test(group="std/vector")
fun test_vector_from_view_copies_every_element() -> Void {
  let arr = [0, 1, 2, 3, 4, 5, 6, 7]
  let vec = Vec[S32]::from(&arr)
  std::debug::assert(vec.len() == 8_uz, "length")
  std::debug::assert(vec[0_uz]@ == 0, "first")
  std::debug::assert(vec[3_uz]@ == 3, "middle")
  std::debug::assert(vec[7_uz]@ == 7, "last")
  drop(vec)
}

!test(group="std/vector")
fun test_vector_append_many_appends_rather_than_overwrites() -> Void {
  let a = Vec[S32]::from(&[1, 2, 3])
  let b = Vec[S32]::from(&[4, 5])
  let mut m = a.clone()
  m.append_many(b.clone())
  std::debug::assert(m.len() == 5_uz, "length")
  std::debug::assert(m[0_uz]@ == 1, "kept its own first element")
  std::debug::assert(m[3_uz]@ == 4, "appended after its own, not over them")
  std::debug::assert(m[4_uz]@ == 5, "last")
  drop(a)
  drop(b)
  drop(m)
}

!test(group="std/vector")
fun test_vector_insert_many_at_shifts_the_tail() -> Void {
  let mut v = Vec[S32]::from(&[1, 2, 3])
  v.insert_many_at(1_uz, Vec[S32]::from(&[4, 5]))
  std::debug::assert(v.len() == 5_uz, "length")
  std::debug::assert(v[0_uz]@ == 1, "head")
  std::debug::assert(v[1_uz]@ == 4, "inserted")
  std::debug::assert(v[2_uz]@ == 5, "inserted")
  std::debug::assert(v[3_uz]@ == 2, "shifted tail")
  std::debug::assert(v[4_uz]@ == 3, "shifted tail")
  drop(v)
}

!test(group="std/vector")
fun test_vector_clone_is_independent() -> Void {
  let v = Vec[S32]::from(&[1, 2, 3])
  let mut c = v.clone()
  c.append(4)
  std::debug::assert(v.len() == 3_uz, "original is untouched")
  std::debug::assert(c.len() == 4_uz, "clone grew")
  std::debug::assert(c[0_uz]@ == 1, "clone kept the contents")
  drop(v)
  drop(c)
}

!test(group="std/vector")
fun test_vector_clone_of_heap_elements_is_deep() -> Void {
  # Element-owned heap memory (the inner buffers) must be cloned, not shared:
  # a bytewise clone made the two vectors free each inner buffer twice.
  let mut v = Vec[Vec[S32]]::new()
  v.append(Vec[S32]::from(&[1, 2]))
  v.append(Vec[S32]::from(&[3]))
  let c1 = v.clone()
  let mut c2 = v.clone()
  c2[mut 0_uz].append(9)
  std::debug::assert(v[0_uz].len() == 2_uz, "original inner is untouched")
  std::debug::assert(c1[0_uz].len() == 2_uz, "other clone's inner is untouched")
  std::debug::assert(c2[0_uz].len() == 3_uz, "the changed clone's inner grew")
  std::debug::assert(c1[1_uz][0_uz]@ == 3, "clone kept the contents")
  drop(c1)
  drop(c2)
  drop(v)
}

!test(group="std/vector")
fun test_vector_from_view_of_heap_elements_clones_them() -> Void {
  let arr = [Vec[S32]::from(&[5, 6]), Vec[S32]::from(&[7])]
  let mut v = Vec[Vec[S32]]::from(&arr)
  v[mut 0_uz].append(8)
  std::debug::assert(arr[0_uz].len() == 2_uz, "the view's element is untouched")
  std::debug::assert(v[0_uz].len() == 3_uz, "the vector's element is its own")
  drop(v)
  drop(arr)
}

!test(group="std/vector")
fun test_vector_append_many_of_heap_elements_keeps_them_alive() -> Void {
  # The moved-from vector's buffer is freed without destroying the elements
  # that moved out of it; dropping it whole freed their inner buffers.
  let mut a = Vec[Vec[S32]]::new()
  a.append(Vec[S32]::from(&[1]))
  let mut b = Vec[Vec[S32]]::new()
  b.append(Vec[S32]::from(&[2, 3]))
  a.append_many(b)
  std::debug::assert(a.len() == 2_uz, "length")
  std::debug::assert(a[1_uz].len() == 2_uz, "moved element kept its length")
  std::debug::assert(a[1_uz][1_uz]@ == 3, "moved element kept its contents")
  drop(a)
}

!test(group="std/vector")
fun test_vector_insert_many_at_of_heap_elements_keeps_them_alive() -> Void {
  let mut a = Vec[Vec[S32]]::new()
  a.append(Vec[S32]::from(&[1]))
  a.append(Vec[S32]::from(&[4]))
  let mut b = Vec[Vec[S32]]::new()
  b.append(Vec[S32]::from(&[2, 3]))
  a.insert_many_at(1_uz, b)
  std::debug::assert(a.len() == 3_uz, "length")
  std::debug::assert(a[1_uz][1_uz]@ == 3, "inserted element kept its contents")
  std::debug::assert(a[2_uz][0_uz]@ == 4, "shifted tail")
  drop(a)
}

!test(group="std/vector")
fun test_vector_swap_of_pointer_owning_elements() -> Void {
  # Swapping went through `take`, which left an `Rc()` with a null control
  # block in the slot and then dropped it.
  let mut v = Vec[std::rc::rc::Rc[Str]]::new()
  v.append(std::rc::rc::Rc[Str]::new(Str::from("a")))
  v.append(std::rc::rc::Rc[Str]::new(Str::from("bc")))
  v.swap(0_uz, 1_uz)
  v.swap(1_uz, 1_uz)
  std::debug::assert(v[0_uz].len() == 2_uz, "the second element moved to the front")
  std::debug::assert(v[1_uz].len() == 1_uz, "the first element moved to the back")
  std::debug::assert(v[0_uz].strong_count() == 1_uz, "no count was gained or lost")
  drop(v)
}

!test(group="std/vector")
fun test_vector_make_reverse_of_pointer_owning_elements() -> Void {
  let mut v = Vec[Single[Str]]::new()
  v.append(Single[Str]::new(Str::from("a")))
  v.append(Single[Str]::new(Str::from("bc")))
  v.append(Single[Str]::new(Str::from("def")))
  v.make_reverse()
  std::debug::assert(v[0_uz].len() == 3_uz, "last is first")
  std::debug::assert(v[1_uz].len() == 2_uz, "middle stays")
  std::debug::assert(v[2_uz].len() == 1_uz, "first is last")
  drop(v)
}

!test(group="std/vector")
fun test_vector_make_reverse_of_empty_and_single() -> Void {
  # An empty vector computed `len() - 1` and underflowed.
  let mut e = Vec[Str]::new()
  e.make_reverse()
  std::debug::assert(e.len() == 0_uz, "empty stays empty")
  let mut s = Vec[S32]::from(&[7])
  s.make_reverse()
  std::debug::assert(s[0_uz]@ == 7, "one element stays")
  drop(e)
  drop(s)
}

!test(group="std/vector")
fun test_vector_shrink_never_drops_below_length() -> Void {
  # A target below the length shrank the buffer under live elements.
  let mut v = Vec[Str]::new_with_capacity(8_uz)
  v.append(Str::from("a"))
  v.append(Str::from("bc"))
  v.append(Str::from("def"))
  v.capacity_shrink_to(1_uz)
  std::debug::assert(v.cap() >= 3_uz, "capacity kept every element")
  std::debug::assert(v[2_uz].len() == 3_uz, "the last element survived")
  let r = v.try_capacity_shrink_to(0_uz)
  std::debug::assert(r.is_pass(), "the clamped shrink succeeds")
  std::debug::assert(v.len() == 3_uz, "the length is untouched")
  drop(r)
  drop(v)
}

!test(group="std/vector")
fun test_vector_iteration_visits_every_element_in_order() -> Void {
  let v = Vec[S32]::from(&[1, 2, 3, 4])
  let mut sum = 0
  let mut count = 0_uz
  loop e in v.iter_ref() {
    sum += e@
    count += 1_uz
  }
  std::debug::assert(count == 4_uz, "visited every element")
  std::debug::assert(sum == 10, "in-order sum")
  drop(v)
}

!test(group="std/vector")
fun test_a_new_vector_is_empty() -> Void {
  let v = Vec[S32]::new()
  std::debug::assert(v.len() == 0_uz, "no elements")
  std::debug::assert(v.is_empty(), "and it says so")
  drop(v)
}

!test(group="std/vector")
fun test_append_then_take_last_round_trips() -> Void {
  let mut v = Vec[S32]::new()
  v.append(1)
  v.append(2)
  std::debug::assert(v.len() == 2_uz, "two appended")
  std::debug::assert(v.take_last().unwrap() == 2, "the last one comes back")
  std::debug::assert(v.len() == 1_uz, "and the vector shrank")
  drop(v)
}

!test(group="std/vector")
fun test_take_last_on_an_empty_vector_yields_none() -> Void {
  let mut v = Vec[S32]::new()
  std::debug::assert(v.take_last().is_none(), "nothing to take")
  drop(v)
}

!test(group="std/vector")
fun test_contains_and_find_locate_an_element() -> Void {
  let v = Vec[S32]::from(&[10, 20, 30])
  std::debug::assert(v.contains(&20), "an element that is there")
  std::debug::assert(v.contains(&99).not, "one that is not")
  std::debug::assert(v.find(&30).unwrap() == 2_uz, "find gives the index")
  std::debug::assert(v.find(&99).is_none(), "and none when absent")
  drop(v)
}

!test(group="std/vector")
fun test_capacity_is_at_least_the_length() -> Void {
  let mut v = Vec[S32]::new_with_capacity(4_uz)
  v.append(1)
  std::debug::assert(v.cap() >= v.len(), "capacity covers the length")
  std::debug::assert(v.cap() >= 4_uz, "and keeps what was reserved")
  drop(v)
}

!test(group="std/vector")
fun test_reserving_past_the_capacity_at_least_doubles_it() -> Void {
  # Growth is amortised: one more element than fits doubles the capacity, so appending one at a time (as `Str.append`
  # does) reallocates a logarithmic number of times, not once per append.
  let mut v = Vec[S32]::new_with_capacity(8_uz)
  loop i in std::range::Range[S32]::between(0, 8) { v.append(i) }
  v.capacity_reserve(1_uz)
  std::debug::assert(v.cap() >= 16_uz, "one more than fits doubles the capacity")
  v.capacity_reserve(100_uz)
  std::debug::assert(v.cap() >= 108_uz, "more than double grows to what is needed")
  drop(v)
}

!test(group="std/vector")
fun test_reserving_what_fits_keeps_the_capacity() -> Void {
  let mut v = Vec[S32]::new_with_capacity(8_uz)
  v.append(1)
  v.capacity_reserve(7_uz)
  std::debug::assert(v.cap() == 8_uz, "seven more fit in eight with one used")
  drop(v)
}

!test(group="std/vector")
fun test_clear_empties_without_dropping_the_buffer() -> Void {
  let mut v = Vec[S32]::from(&[1, 2, 3])
  v.clear()
  std::debug::assert(v.len() == 0_uz, "no elements left")
  std::debug::assert(v.is_empty(), "and it is empty")
  drop(v)
}

