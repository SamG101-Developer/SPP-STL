!test(group="std/array")
fun test_find_and_contains_on_an_empty_region() -> Void {
  # Every element differs from the needle, so neither reports a hit.
  let a = [1, 2, 3]
  std::debug::assert(a.find(&0).is_none(), "a needle below the range")
  std::debug::assert(a.find(&4).is_none(), "a needle above it")
  std::debug::assert(a.contains(&0).not, "contains agrees")
}

!test(group="std/array")
fun test_find_reports_the_first_of_a_repeat() -> Void {
  let a = [7, 7, 7]
  std::debug::assert(a.find(&7).unwrap() == 0_uz, "the first index, not a later one")
}

!test(group="std/array")
fun test_swap_with_itself_changes_nothing() -> Void {
  let mut a = [1, 2, 3]
  a.swap(1_uz, 1_uz)
  std::debug::assert(a[0_uz]@ == 1, "first")
  std::debug::assert(a[1_uz]@ == 2, "the swapped slot")
  std::debug::assert(a[2_uz]@ == 3, "last")
}

!test(group="std/array")
fun test_a_single_element_array() -> Void {
  let a = [42]
  std::debug::assert(a.len() == 1_uz, "length")
  std::debug::assert(a[0_uz]@ == 42, "its only element")
  std::debug::assert(a.is_empty().not, "not empty")
  std::debug::assert(a.contains(&42), "contains it")
}

!test(group="std/array")
fun test_iteration_over_a_single_element() -> Void {
  let a = [5]
  let mut count = 0_uz
  let mut sum = 0
  loop e in a.iter_ref() {
    sum += e@
    count += 1_uz
  }
  std::debug::assert(count == 1_uz, "one step")
  std::debug::assert(sum == 5, "and it saw the element")
}

!test(group="std/array")
fun test_equality_compares_each_element() -> Void {
  let a = [1, 2, 3]
  let b = [1, 2, 3]
  let c = [1, 2, 4]
  std::debug::assert(a == b, "equal elements make equal arrays")
  std::debug::assert(a != c, "one differing element makes them unequal")
  std::debug::assert((a == c).not, "and eq agrees with ne")
}

!test(group="std/array")
fun test_equality_over_elements_that_own_storage() -> Void {
  let mut x = Vec[S32]::new()
  x.append(5)
  let mut y = Vec[S32]::new()
  y.append(5)
  let mut z = Vec[S32]::new()
  z.append(6)
  let a = [x]
  let b = [y]
  let c = [z]
  std::debug::assert(a == b, "equal vectors in different storage compare equal")
  std::debug::assert(a != c, "unequal vectors compare unequal")
  drop(a)
  drop(b)
  drop(c)
}

!test(group="std/array")
fun test_swap_of_pointer_owning_elements() -> Void {
  # Swapping went through `take`, which left an `Rc()` with a null control
  # block in the slot and then dropped it.
  let mut a = [std::rc::rc::Rc::new(Str::from("a")), std::rc::rc::Rc::new(Str::from("bc"))]
  a.swap(0_uz, 1_uz)
  std::debug::assert(a[0_uz].len() == 2_uz, "the second element moved to the front")
  std::debug::assert(a[1_uz].strong_count() == 1_uz, "no count was gained or lost")
  drop(a)
}

!test(group="std/array")
fun test_new_filled_sets_every_slot() -> Void {
  # `new` leaves the elements uninitialised, so it is private;
  # `new_filled` writes every slot before anything reads one.
  let a = Arr[S32, 3_uz]::new_filled(4)
  std::debug::assert(a[0_uz]@ == 4, "first")
  std::debug::assert(a[2_uz]@ == 4, "last")
}

!test(group="std/array")
fun test_move_iteration_of_owning_elements() -> Void {
  # Moving elements out read through the array's first element as if it
  # were a pointer to the array, and reversed iteration started one past
  # the end.
  let a = [Str::from("a"), Str::from("bc"), Str::from("def")]
  let mut total = 0_uz
  let mut first = 0_uz
  loop s in a.iter_mov() {
    case total == 0_uz { first = s.len() }
    total += s.len()
    drop(s)
  }
  std::debug::assert(first == 1_uz, "forwards starts at the front")
  std::debug::assert(total == 6_uz, "every element is visited")

  let b = [Str::from("a"), Str::from("bc"), Str::from("def")]
  total = 0_uz
  first = 0_uz
  loop s in b.reverse_iter_mov() {
    case total == 0_uz { first = s.len() }
    total += s.len()
    drop(s)
  }
  std::debug::assert(first == 3_uz, "reversed starts at the back")
  std::debug::assert(total == 6_uz, "every element is visited reversed")
}

!test(group="std/array")
fun test_move_iteration_left_part_way() -> Void {
  # Leaving the loop drops the elements not yet moved out.
  let a = [Str::from("a"), Str::from("bc"), Str::from("def")]
  loop s in a.iter_mov() {
    std::debug::assert(s.len() == 1_uz, "the first element")
    drop(s)
    exit
  }
  let b = [Str::from("a"), Str::from("bc"), Str::from("def")]
  loop s in b.reverse_iter_mov() {
    std::debug::assert(s.len() == 3_uz, "the last element")
    drop(s)
    exit
  }
}
