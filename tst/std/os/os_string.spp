!test(group="std/os/os_string")
fun test_text_round_trips() -> Void {
  # UTF-8 is a valid `OsStr` on every platform, and comes back the same.
  let os = std::os::os_string::OsStr::from("héllo")
  std::debug::assert(os.len() == 6_uz, "the text's bytes")
  let text = os.to_str().expect("text reads back as text")
  std::debug::assert(text == "héllo", "the same text")
  let lossy = os.to_str_lossy()
  std::debug::assert(lossy == "héllo", "nothing to replace")
  drop(lossy)
  drop(text)
  drop(os)
}

!test(group="std/os/os_string")
fun test_appending_text_characters_and_others() -> Void {
  let mut os = std::os::os_string::OsStr::new()
  std::debug::assert(os.is_empty(), "a new one is empty")
  os.append_str("ab")
  os.append('/')
  let tail = std::os::os_string::OsStr::from("cd")
  os.append_os_str(&tail)
  let whole = std::os::os_string::OsStr::from("ab/cd")
  std::debug::assert(os == whole, "all three appended in order")
  std::debug::assert(os != tail, "and differs from a part")
  drop(whole)
  drop(tail)
  drop(os)
}

!test(group="std/os/os_string")
fun test_bytes_that_are_not_utf8_are_not_text() -> Void {
  # Built from bytes directly, as only std can: what Unix may hand back.
  let os = std::os::os_string::OsStr(bytes=Vec[U8]::from(&[0x61_u8, 0xff_u8, 0x62_u8]))
  let text = os.to_str()
  std::debug::assert(text.is_none(), "a stray 0xff is not text")
  drop(text)
  let lossy = os.to_str_lossy()
  std::debug::assert(lossy == "a�b", "the stray byte becomes U+FFFD")
  drop(lossy)
  drop(os)
}

!test(group="std/os/os_string")
fun test_a_lone_surrogate_is_not_text() -> Void {
  # The WTF-8 of a lone surrogate (U+D800), which Windows hands back for such a
  # name: valid in an `OsStr` there, but not UTF-8, and so not text.
  let os = std::os::os_string::OsStr(bytes=Vec[U8]::from(&[0x78_u8, 0xed_u8, 0xa0_u8, 0x80_u8]))
  let text = os.to_str()
  std::debug::assert(text.is_none(), "a lone surrogate is not text")
  drop(text)
  let lossy = os.to_str_lossy()
  std::debug::assert(lossy.len() == 10_uz, "x and three U+FFFD (one per byte, as Rust)")
  drop(lossy)
  drop(os)
}
