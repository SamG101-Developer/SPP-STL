!test(group="std/os/env")
fun test_args_name_the_program_first() -> Void {
  # The test runner passes nothing of its own here, but the program's name
  # always comes first.
  let args = std::os::env::args()
  std::debug::assert(args.len() >= 1_uz, "no arguments at all")
  std::debug::assert(args[0_uz].len() > 0_uz, "an empty program name")
  drop(args)
}

!test(group="std/os/env")
fun test_get_env_reads_a_long_value_whole() -> Void {
  # Longer than the 1024 bytes "get_env" once read into, which came back as not
  # set.
  let value = Str::new_filled(3000_uz, 'v')
  std::debug::assert(std::os::env::set_env("SPP_STD_TEST_LONG", &value), "set")
  let got = std::os::env::get_env("SPP_STD_TEST_LONG").expect("a long value read as not set")
  std::debug::assert(got.len() == 3000_uz, "a long value cut short")
  drop(got)
  std::debug::assert(std::os::env::unset_env("SPP_STD_TEST_LONG"), "unset")
  drop(value)
}

!test(group="std/os/env")
fun test_get_env_of_an_unset_variable() -> Void {
  std::debug::assert(std::os::env::unset_env("SPP_STD_TEST_UNSET"), "unset")
  let got = std::os::env::get_env("SPP_STD_TEST_UNSET")
  std::debug::assert(got.is_none(), "an unset variable read as set")
  drop(got)
}

!test(group="std/os/env")
fun test_a_text_value_reads_back_as_text() -> Void {
  std::debug::assert(std::os::env::set_env("SPP_STD_TEST_TEXT", "héllo"), "set")
  let got = std::os::env::get_env("SPP_STD_TEST_TEXT").expect("not set")
  let text = got.to_str().expect("valid UTF-8 reads back as text")
  std::debug::assert(text == "héllo", "the same text")
  drop(text)
  drop(got)
  std::debug::assert(std::os::env::unset_env("SPP_STD_TEST_TEXT"), "unset")
}

!test(group="std/os/env")
!cfg(family="!windows")
fun test_a_value_that_is_not_utf8_reads_back_exactly() -> Void {
  # Unix values are any bytes: one with a stray 0xff comes back byte for byte,
  # not as text, where it used to become a `Str` that was not valid UTF-8.
  let value = std::os::os_string::OsStr(bytes=Vec[U8]::from(&[0x61_u8, 0xff_u8, 0x62_u8]))
  std::debug::assert(std::os::env::set_env("SPP_STD_TEST_BYTES", &value), "set")
  let got = std::os::env::get_env("SPP_STD_TEST_BYTES").expect("not set")
  std::debug::assert(got == value, "the same bytes")
  let text = got.to_str()
  std::debug::assert(text.is_none(), "which are not text")
  drop(text)
  drop(got)
  drop(value)
  std::debug::assert(std::os::env::unset_env("SPP_STD_TEST_BYTES"), "unset")
}

!test(group="std/os/env")
fun test_the_working_directory_is_an_absolute_directory() -> Void {
  let cwd = std::os::env::get_cwd().unwrap()
  std::debug::assert(cwd.is_absolute(), "the working directory is absolute")
  std::debug::assert(cwd.is_dir(), "and is a directory")
  drop(cwd)
}
