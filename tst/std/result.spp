!test(group="std/result")
fun test_predicates_report_the_state() -> Void {
  let p: Res[S32, Bool] = Pass(val=7)
  let f: Res[S32, Bool] = Fail(err=false)
  std::debug::assert(p.is_pass(), "Pass is a pass")
  std::debug::assert(p.is_fail().not, "Pass is not a fail")
  std::debug::assert(f.is_fail(), "Fail is a fail")
  std::debug::assert(f.is_pass().not, "Fail is not a pass")
}

!test(group="std/result")
fun test_unwrap_returns_the_passed_value() -> Void {
  let a: Res[S32, Bool] = Pass(val=7)
  let b: Res[S32, Bool] = Pass(val=7)
  std::debug::assert(a.unwrap() == 7, "unwrap")
  std::debug::assert(b.expect("present") == 7, "expect")
}

!test(group="std/result")
fun test_unwrap_err_returns_the_failure() -> Void {
  let a: Res[S32, Bool] = Fail(err=true)
  let b: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(a.unwrap_err(), "unwrap_err")
  std::debug::assert(b.expect_err("failed"), "expect_err")
}

!test(group="std/result")
fun test_unwrap_or_falls_back_only_for_fail() -> Void {
  let p: Res[S32, Bool] = Pass(val=7)
  let f: Res[S32, Bool] = Fail(err=false)
  std::debug::assert(p.unwrap_or(3) == 7, "Pass ignores the fallback")
  std::debug::assert(f.unwrap_or(3) == 3, "Fail takes the fallback")
}

!test(group="std/result")
fun test_conversion_to_option_keeps_only_the_matching_side() -> Void {
  let p: Res[S32, Bool] = Pass(val=7)
  std::debug::assert(p.pass_opt().unwrap() == 7, "a pass has a pass value")
  let p2: Res[S32, Bool] = Pass(val=7)
  std::debug::assert(p2.fail_opt().is_none(), "a pass has no failure")

  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.fail_opt().unwrap(), "a fail has a failure")
  let f2: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f2.pass_opt().is_none(), "a fail has no pass value")
}

!test(group="std/result")
fun test_and_keeps_the_second_only_when_the_first_passed() -> Void {
  let p: Res[S32, Bool] = Pass(val=1)
  let other: Res[S32, Bool] = Pass(val=2)
  std::debug::assert(p.and_(other).unwrap() == 2, "Pass and Pass gives the second")

  let f: Res[S32, Bool] = Fail(err=true)
  let other2: Res[S32, Bool] = Pass(val=2)
  std::debug::assert(f.and_(other2).is_fail(), "Fail and anything is the failure")
}

!test(group="std/result")
fun test_equality_compares_both_the_side_and_the_value() -> Void {
  let a: Res[S32, Bool] = Pass(val=1)
  let b: Res[S32, Bool] = Pass(val=1)
  let c: Res[S32, Bool] = Pass(val=2)
  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(a == b, "the same passed value")
  std::debug::assert(a != c, "different passed values")
  std::debug::assert(a != f, "a pass is not a fail")
}

!test(group="std/result")
fun test_map_transforms_only_the_passed_value() -> Void {
  let p: Res[S32, Bool] = Pass(val=3)
  std::debug::assert(p.map((x: S32) x * 2).unwrap() == 6, "the value is transformed")

  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.map((x: S32) x * 2).is_fail(), "a failure passes through untouched")
}

!test(group="std/result")
fun test_map_err_transforms_only_the_failure() -> Void {
  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.map_err((e: Bool) e.not).unwrap_err().not, "the failure is transformed")

  let p: Res[S32, Bool] = Pass(val=3)
  std::debug::assert(p.map_err((e: Bool) e.not).unwrap() == 3, "a pass passes through untouched")
}

!test(group="std/result")
fun test_map_or_falls_back_for_a_failure() -> Void {
  let p: Res[S32, Bool] = Pass(val=3)
  std::debug::assert(p.map_or(99, (x: S32) x * 2) == 6, "a pass uses the mapper")

  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.map_or(99, (x: S32) x * 2) == 99, "a fail uses the default")
}

!test(group="std/result")
fun test_and_then_chains_a_fallible_step() -> Void {
  let p: Res[S32, Bool] = Pass(val=4)
  std::debug::assert(p.and_then((x: S32) Pass(val=x + 1)).unwrap() == 5, "the step runs on a pass")

  # Todo: "a step that itself fails" cannot be written here. "and_then[U, F: FunMov[(T,), Res[U, E]]]" has nothing to
  #  infer "U" from when the closure only ever produces the "Fail" side, and a closure expression has no return-type
  #  annotation to supply it. Reachable once either inference reads "U" from the call's own context or closures can be
  #  annotated.
  #
  # let q: Res[S32, Bool] = Pass(val=4)
  # std::debug::assert(q.and_then((x: S32) Fail(err=true)).is_fail(), "a step may itself fail")

  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.and_then((x: S32) Pass(val=x + 1)).is_fail(), "a failure short-circuits")
}

!test(group="std/result")
fun test_ior_keeps_the_first_when_it_passed() -> Void {
  let p: Res[S32, Bool] = Pass(val=1)
  let other: Res[S32, Bool] = Pass(val=2)
  std::debug::assert(p.ior_(other).unwrap() == 1, "a pass keeps its own value")

  let f: Res[S32, Bool] = Fail(err=true)
  let other2: Res[S32, Bool] = Pass(val=2)
  std::debug::assert(f.ior_(other2).unwrap() == 2, "a fail takes the alternative")
}

!test(group="std/result")
fun test_is_pass_and_tests_the_passed_value() -> Void {
  let p: Res[S32, Bool] = Pass(val=4)
  std::debug::assert(p.is_pass_and((x: S32) x > 3), "a pass whose value matches")

  let q: Res[S32, Bool] = Pass(val=1)
  std::debug::assert(q.is_pass_and((x: S32) x > 3).not, "a pass whose value does not")

  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.is_pass_and((x: S32) true).not, "a fail is never pass-and")
}

!test(group="std/result")
fun test_is_fail_and_tests_the_failure() -> Void {
  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.is_fail_and((e: Bool) e), "a fail whose error matches")

  let g: Res[S32, Bool] = Fail(err=false)
  std::debug::assert(g.is_fail_and((e: Bool) e).not, "a fail whose error does not")

  let p: Res[S32, Bool] = Pass(val=1)
  std::debug::assert(p.is_fail_and((e: Bool) true).not, "a pass is never fail-and")
}

!test(group="std/result")
fun test_unwrap_or_else_computes_the_fallback_from_the_error() -> Void {
  let p: Res[S32, Bool] = Pass(val=7)
  std::debug::assert(p.unwrap_or_else((e: Bool) 99) == 7, "a pass ignores the fallback")

  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.unwrap_or_else((e: Bool) 99) == 99, "a fail computes it")
}

!test(group="std/result")
fun test_expect_and_expect_err_pick_the_matching_side() -> Void {
  let p: Res[S32, Bool] = Pass(val=7)
  std::debug::assert(p.expect("present") == 7, "expect on a pass")

  let f: Res[S32, Bool] = Fail(err=true)
  std::debug::assert(f.expect_err("failed"), "expect_err on a fail")
}
